+#!/usr/bin/env python3
+"""Real-process, real-source mutants; no chain or external model calls."""
+import copy
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SCRIPT = Path(__file__).resolve().parents[1] / "oracle_gate.py"
+HOOK = SCRIPT.parents[1] / "hooks/completion-guard.py"
+spec = importlib.util.spec_from_file_location("oracle_gate", SCRIPT)
+gate = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(gate)
+
+BUGGY = "def balance(entries):\n    return entries[-1] if entries else 0\n"
+FIXED = "def balance(entries):\n    return sum(entries)\n"
+PRIMARY = '''import json, os, sys
+sys.path.insert(0, os.getcwd())
+from ledger import balance
+case = os.environ['ORACLE_CASE_ID']
+values, expected = {'symptom': ([12, 30], 42), 'empty': ([], 0), 'single': ([8], 8)}[case]
+good = balance(values) == expected
+print(json.dumps({'schema_version': 1, 'symptom_id': os.environ['ORACLE_SYMPTOM_ID'],
+ 'assertion_id': 'ticket_balance', 'case_id': case,
+ 'subject_commit': os.environ['ORACLE_SUBJECT_COMMIT'], 'outcome': 'pass' if good else 'symptom_fail'}))
+sys.exit(0 if good else 1)
+'''
+INDEPENDENT = '''import json, os, sys
+sys.path.insert(0, os.getcwd())
+from ledger import balance
+case = os.environ['ORACLE_CASE_ID']
+# Re-derived conservation check covers a second ledger, not the primary constant.
+ledgers = {'symptom': [[12, 30], [7, 10]], 'empty': [[]], 'single': [[8]]}[case]
+good = True
+for entries in ledgers:
+    remainder = balance(entries)
+    for credit in entries:
+        remainder -= credit
+    good = good and remainder == 0
+print(json.dumps({'schema_version': 1, 'symptom_id': os.environ['ORACLE_SYMPTOM_ID'],
+ 'assertion_id': 'conservation', 'case_id': case,
+ 'subject_commit': os.environ['ORACLE_SUBJECT_COMMIT'], 'outcome': 'pass' if good else 'symptom_fail'}))
+sys.exit(0 if good else 1)
+'''
+
+
+class Fixture:
+    def __init__(self, root, primary=PRIMARY, independent=INDEPENDENT, head=FIXED):
+        self.repo = root / "subject"
+        self.repo.mkdir()
+        self.workspace = self.repo / ".coding-agent/tickets/fixture"
+        self.workspace.mkdir(parents=True)
+        self.git("init", "-q")
+        self.git("config", "user.email", "fixture@example.test")
+        self.git("config", "user.name", "Oracle Fixture")
+        self.git("config", "commit.gpgsign", "false")
+        (self.repo / ".gitignore").write_text(".coding-agent/\n")
+        (self.repo / "ledger.py").write_text(BUGGY)
+        (self.repo / "oracles").mkdir()
+        (self.repo / "oracles/primary.py").write_text(primary)
+        (self.repo / "oracles/independent.py").write_text(independent)
+        requirement = {"symptom_id": "ledger-total", "symptom_case": "symptom", "controls": ["empty", "single"]}
+        (self.repo / "acceptance.json").write_text(json.dumps(requirement))
+        (self.repo / "derivation.md").write_text("Credits must be conserved. Subtract every credit from the reported balance; include a second account. No primary oracle helper or expected constant is shared.\n")
+        (self.workspace / "ticket.json").write_text(json.dumps({"id": "fixture", "symptom": "reported balance loses earlier credits"}))
+        self.git("add", ".")
+        self.git("commit", "-qm", "test: capture ledger conservation before the fix")
+        self.base = self.git("rev-parse", "HEAD").strip()
+        files = ["acceptance.json", "derivation.md", "oracles/primary.py", "oracles/independent.py"]
+        self.plan = {"schema_version": 1, "tier": "simulation", "base_ref": self.base, **requirement,
+            "ticket_file": "ticket.json", "ticket_sha256": gate.sha((self.workspace / "ticket.json").read_bytes()),
+            "requirement_file": "acceptance.json", "independent_derivation_file": "derivation.md",
+            "frozen_files": {p: gate.sha((self.repo / p).read_bytes()) for p in files},
+            "oracles": [{"id": "primary", "role": "primary", "command": [sys.executable, "oracles/primary.py"], "assertion_id": "ticket_balance", "files": ["oracles/primary.py"]},
+                        {"id": "independent", "role": "independent", "command": [sys.executable, "oracles/independent.py"], "assertion_id": "conservation", "files": ["oracles/independent.py"]}],
+            "mutants": [{"id": "lost-credit", "kind": "reintroduce_symptom", "patches": [{"path": "ledger.py", "before": "sum(entries)", "after": "entries[-1] if entries else 0"}]},
+                        {"id": "literal-overfit", "kind": "overfit", "patches": [{"path": "ledger.py", "before": "sum(entries)", "after": "42"}]}], "timeout_seconds": 5}
+        # Freeze the plan before changing production code.
+        self.save_plan()
+        (self.repo / "ledger.py").write_text(head)
+        self.git("add", "ledger.py")
+        self.git("commit", "-qm", "fix: preserve all ledger credits", "--allow-empty")
+        self.head = self.git("rev-parse", "HEAD").strip()
+        self.state = {"ticket_id": "fixture", "ticket_type": "bugfix", "current_state": "EVALUATION", "states": {"ANALYSIS": {"oracle_validity_plan_sha256": gate.sha(self.plan_path.read_bytes())}, "IMPLEMENTATION": {"reproduction_commit": self.base}, "EVALUATION": {"results": {"oracle_validity": "PASS", "reproduction_verdict": "PASS", "fix_validity_verdict": "PASS", **{k: "PASS" for k in ["unit_test", "lint", "security", "chainbench", "full_regression"]}}}}}
+        self.save_state()
+
+    @property
+    def plan_path(self):
+        return self.workspace / "oracle-validity-plan.json"
+
+    def git(self, *args):
+        return subprocess.run(["git", *args], cwd=self.repo, check=True, capture_output=True, text=True).stdout
+
+    def save_plan(self):
+        self.plan_path.write_text(json.dumps(self.plan, indent=2) + "\n")
+
+    def save_state(self):
+        (self.workspace / "state.json").write_text(json.dumps(self.state))
+
+    def run(self):
+        return gate.run_plan(self.plan, self.workspace, self.repo, gate.sha(self.plan_path.read_bytes()))
+
+    def cli(self, *extra):
+        return subprocess.run([sys.executable, str(SCRIPT), "--workspace", str(self.workspace), "--repo", str(self.repo), *extra], capture_output=True, text=True, timeout=30)
+
+    def bind(self, report):
+        path = self.workspace / "oracle-validity-report.json"
+        path.write_text(json.dumps(report, indent=2) + "\n")
+        self.state["states"]["EVALUATION"]["oracle_validity_report_sha256"] = gate.sha(path.read_bytes())
+        self.save_state()
+
+    def hook(self, tool="Write", content=None, path=None, **extra):
+        target = path or self.workspace / "state.json"
+        inputs = {"file_path": str(target), **extra}
+        if tool == "Write":
+            inputs["content"] = content if content is not None else json.dumps({**self.state, "current_state": "COMPLETION"})
+        return subprocess.run([sys.executable, str(HOOK)], input=json.dumps({"tool_name": tool, "tool_input": inputs}), capture_output=True, text=True, timeout=10)
+
+
+class OracleGateTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
