@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Best-effort publication tool guard for isolated evaluation-only repositories.
+
+Known Bash spellings and write tools only; not a shell interpreter, network
+sandbox, identity authority, or substitute for restricted host MCP/config.
+The repository remains restricted while any evaluation-only ticket lock exists.
+"""
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts'))
+from publication_policy import MODE, POLICY, RECEIPT, load, policy
+
+
+def deny(reason):
+    print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse',
+          'permissionDecision': 'deny', 'permissionDecisionReason': reason}}))
+
+
+def main():
+    try:
+        data = json.load(sys.stdin)
+        if not isinstance(data, dict):
+            return 0
+        cwd = Path(data.get('cwd') or os.getcwd())
+        root = subprocess.run(['git', '-C', str(cwd), 'rev-parse', '--show-toplevel'],
+                              capture_output=True, text=True, timeout=5).stdout.strip()
+        if not root:
+            return 0
+        repo = Path(root)
+        restricted = False
+        for workspace in (repo / '.coding-agent/tickets').glob('*'):
+            try:
+                state = load(workspace / 'state.json')
+                if (workspace / POLICY).exists() or state.get('config', {}).get('publication_policy', 'publish') != 'publish':
+                    restricted = True
+                    policy(workspace, state, repo)
+            except Exception:
+                # A broken owned ticket cannot erase a policy restriction.
+                if (workspace / POLICY).exists() or (workspace / 'state.json').exists():
+                    restricted = True
+        if not restricted:
+            return 0
+        tool = data.get('tool_name', '')
+        inputs = data.get('tool_input') or {}
+        if tool in ('Write', 'Edit'):
+            path = Path(inputs.get('file_path') or '.')
+            if not path.is_absolute():
+                path = cwd / path
+            if path.name in (POLICY, RECEIPT):
+                deny('Evaluation boundary files are managed by publication_policy.py; direct edits are blocked.')
+        elif tool == 'Bash':
+            command = inputs.get('command') or ''
+            # Broad lexical matching also catches common wrappers, newlines and absolute binaries.
+            # Arbitrary scripts/aliases/encoded commands remain outside this finite guard.
+            publication = (re.search(r'\bgit\b[^;&|\n]*\b(push|send-email)\b', command)
+                           or re.search(r'\bgh\b[^;&|\n]*\b(pr\s+(create|merge|edit|comment|review)|release\s+(create|upload)|api)\b', command)
+                           or re.search(r'\b(curl|wget|scp|rsync|ssh|nc|netcat|wrangler|vercel|deploy)\b', command))
+            if publication:
+                deny('Evaluation-only repository: publication/remote-write commands are blocked; stop locally after validated evaluation.')
+        elif tool.startswith('mcp__'):
+            # This policy's supported runtime uses only CKS/ChainBench plus read-only Jira.
+            # All other MCP tools require a different host configuration/scope.
+            name = tool.rsplit('__', 1)[-1]
+            provider = tool.split('__')[1] if '__' in tool else ''
+            allowed = (provider in ('cks', 'chainbench') or provider.endswith(('_cks', '_chainbench'))
+                       or name in ('jira_read_ticket', 'jira_read_comments'))
+            if not allowed:
+                deny('Evaluation-only repository: this MCP tool is outside the local evaluation allowlist.')
+    except Exception as exc:
+        # A malformed payload cannot authorize a positively identified restricted action.
+        deny('Cannot verify evaluation publication boundary: ' + str(exc))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
