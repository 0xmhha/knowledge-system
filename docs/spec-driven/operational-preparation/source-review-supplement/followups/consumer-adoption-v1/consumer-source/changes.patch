+{
+  "providers": {
+    "cks": {
+      "server": "cks",
+      "namespace": "cks.",
+      "tools": {
+        "cks_context_change_history": {
+          "owner": "cks",
+          "wire_name": "cks.context.change_history",
+          "description": "Modification history for a symbol or intent: PR refs (provenance) and BM25-ranked diff hunks. Use AFTER traversal or reproduction has implicated a site -- anchoring history on an unverified hypothesis amplifies confirmation bias (history 'evidence' for the wrong suspect reads convincing).",
+          "input": {
+            "properties": {
+              "intent": {
+                "description": "Natural-language query the hunks should match against (optional if symbol is set).",
+                "type": "string"
+              },
+              "k": {
+                "description": "Maximum hunks to return when intent is set (0 = backend default).",
+                "type": "number"
+              },
+              "max_count": {
+                "description": "Maximum PR refs to return when symbol is set (0 = no cap).",
+                "type": "number"
+              },
+              "symbol": {
+                "description": "Fully-qualified symbol name to look up PR refs for (optional if intent is set).",
+                "type": "string"
+              }
+            },
+            "required": [],
+            "type": "object"
+          }
+        },
+        "cks_context_concurrency_impact": {
+          "owner": "cks",
+          "wire_name": "cks.context.concurrency_impact",
+          "description": "Concurrency blast radius of a symbol: goroutines it spawns, channels it sends to/receives from, locks it acquires, plus modules reached over concurrency edges. Use when a change touches shared state or ordering -- before assuming a data race is or is not possible.",
+          "input": {
+            "properties": {
+              "depth": {
+                "description": "Maximum traversal depth over concurrency edges (default: 3).",
+                "type": "number"
+              },
+              "max_total": {
+                "description": "Cap on total modules returned (0 = no cap).",
+                "type": "number"
+              },
+              "symbol": {
+                "description": "Symbol to seed the analysis: a ckg qualified_name, a bare name (only when it resolves unambiguously), or a ckg canonical_id. An ambiguous or unknown name is an error, not an empty result -- use find_symbol to get the canonical_id.",
+                "type": "string"
+              }
+            },
+            "required": [
+              "symbol"
+            ],
+            "type": "object"
+          }
+        },
+        "cks_context_expand_flow": {
+          "owner": "cks",
+          "wire_name": "cks.context.expand_flow",
+          "description": "Steps adjacent to a flow step: direction 'up' traverses producers, 'down' traverses consumers. Use to trace a value's produce->store->consume lifecycle one hop at a time when the whole flow is too large.",
+          "input": {
+            "properties": {
+              "direction": {
+                "description": "\"up\" (producers) or \"down\" (consumers). Default \"down\".",
+                "type": "string"
+              },
+              "hops": {
+                "description": "Traversal hops (default 1).",
+                "type": "number"
+              },
+              "limit": {
+                "description": "Cap on returned neighbors (0 = backend default).",
+                "type": "number"
+              },
+              "step_id": {
+                "description": "Origin step id.",
+                "type": "string"
+              }
+            },
+            "required": [
+              "step_id"
+            ],
+            "type": "object"
+          }
+        },
+        "cks_context_find_branches": {
+          "owner": "cks",
+          "wire_name": "cks.context.find_branches",
+          "description": "Map a free-text symptom to ranked when->then@at failure-condition candidates from the flow corpus. This is the natural-language ENTRY POINT into flows -- use it before get_flow when all you have is a symptom.",
+          "input": {
+            "properties": {
+              "k": {
+                "description": "Max matches to return (default 10).",
+                "type": "number"
+              },
+              "symptom_text": {
+                "description": "Free-text symptom description.",
+                "type": "string"
+              }
+            },
+            "required": [
+              "symptom_text"
+            ],
+            "type": "object"
+          }
+        },
+        "cks_context_find_callees": {
+          "owner": "cks",
+          "wire_name": "cks.context.find_callees",
+          "description": "Forward call-graph traversal: what the given symbol calls. Use to unpack what a suspicious function actually reaches downstream (which store/update/IO). Pair with find_callers to cover the produce->store->consume lifecycle in both directions.",
+          "input": {
+            "properties": {
+              "depth": {
+                "description": "Maximum traversal depth (default 2: one hop past the direct neighbours, so callers behind a helper chain are not silently missed).",
+                "type": "number"
+              },
+              "exclude_tests": {
+                "description": "Drop test files and test-only helpers (testutil*.go, test/ dirs, *_test.go, *.t.sol, …) from the result. Use for design/implementation queries where tests are noise. Default false.",
+                "type": "boolean"
+              },
+              "max_total": {
+                "description": "Cap on total neighbours (0 = no cap).",
+                "type": "number"
+              },
+              "symbol": {
+                "description": "Symbol to resolve: a ckg qualified_name (e.g. \"wbft.Finalize\"), a bare name (\"Finalize\", used only when unambiguous), or a ckg canonical_id (e.g. \"github.com/org/repo/consensus/wbft.(*Backend).Finalize\").",
+                "type": "string"
+              }
+            },
+            "required": [
+              "symbol"
+            ],
+            "type": "object"
