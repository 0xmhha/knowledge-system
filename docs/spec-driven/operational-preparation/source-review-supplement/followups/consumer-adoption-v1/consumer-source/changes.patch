+func Balance(entries []int) int {
+ copied := append([]int(nil), entries...)
+ total := 0
+ for _, credit := range copied { total += credit }
+ return total
+}
+'''
+METRIC_TEST='''package ledger
+import ("fmt"; "testing")
+var balanceSink int
+func TestAllocationMetric(t *testing.T) {
+ entries := make([]int,1024)
+ for i := range entries { entries[i]=i }
+ n := testing.AllocsPerRun(50,func(){balanceSink=Balance(entries)})
+ fmt.Printf("SELECTION_METRIC_ALLOCATIONS=%f\\n",n)
+}
+'''
+DRIVER='''import json,os,subprocess,sys
+p=json.load(sys.stdin)
+mode=sys.argv[1]
+name='TestAllocationMetric' if mode=='metrics' else 'TestPrimary|TestIndependent'
+r=subprocess.run(['go','test','-json','-count=1','-run','^('+name+')$','.'],capture_output=True,text=True)
+v={'schema_version':1,'candidate_id':p['candidate_id'],'subject_commit':p['subject_commit']}
+if mode=='regression':
+ v['status']='PASS' if r.returncode==0 else 'FAIL' if any('"Action":"fail"' in x and '"Test":' in x for x in r.stdout.splitlines()) else 'ERROR'
+else:
+ values=[float(e['Output'].split('=')[1]) for e in [json.loads(x) for x in r.stdout.splitlines()] if e.get('Test')=='TestAllocationMetric' and e.get('Output','').startswith('SELECTION_METRIC_ALLOCATIONS=')]
+ v['metrics']={'allocations':{'value':values[0] if r.returncode==0 and len(values)==1 else None,'unit':'allocations/call'}}
+sys.stderr.write(r.stdout[-32768:]);sys.stderr.write(r.stderr[-8192:])
+print(json.dumps(v))
+'''
+FIXTURE_PANEL='''import json,sys
+p=json.load(sys.stdin);eligible=[x for x in p['candidates'] if x['hard_eligible']]
+best=min(eligible,key=lambda x:(x['metrics']['changed_lines']['value'],x['metrics']['allocations']['value']))['id'] if eligible else None
+print(json.dumps({'schema_version':1,'judge_id':p['judge_id'],'role':p['role'],'preferred_candidate':best,
+'votes':[{'candidate_id':x['id'],'verdict':'accept' if x['hard_eligible'] else 'reject','reason':'fixture opinion; not actual model or human review','evidence_sha256':x['evidence_sha256']} for x in p['candidates']]}))
+'''
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out',type=Path,required=True)
+    parser.add_argument('--panel',choices=['fixture','model'],required=True)
+    args=parser.parse_args();out=args.out.resolve();out.mkdir(parents=True,exist_ok=True)
+    summary={'scope':'actual Go proposal materialization, oracle/metric/regression execution, selection/check/guards',
+             'panel_origin':args.panel,'independent_human_acceptance':'not_recorded'}
+    with tempfile.TemporaryDirectory(prefix='go-selection-smoke-') as temp:
+        repo=Path(temp)/'subject';repo.mkdir();workspace=repo/'.coding-agent/tickets/fixture';workspace.mkdir(parents=True)
+        def run(cmd,stdin=None,check=True):
+            p=subprocess.run(cmd,cwd=repo,input=stdin,capture_output=True,text=True,timeout=900)
+            if check and p.returncode:raise RuntimeError(str(cmd)+'\n'+p.stdout+'\n'+p.stderr)
+            return p
+        def git(*args):return run(['git',*args]).stdout.strip()
+        def formatted(code):
+            return subprocess.run(['gofmt'],input=code,capture_output=True,text=True,check=True).stdout
+        git('init','-q');git('config','user.name','Selection Fixture');git('config','user.email','fixture@example.test');git('config','commit.gpgsign','false')
+        (repo/'.gitignore').write_text('.coding-agent/\n')
+        (repo/'go.mod').write_text('module example.test/oracle\n\ngo 1.26.0\n')
+        bug=formatted(fixture.BUG);fixed=formatted(fixture.FIX);copied=formatted(COPY)
+        (repo/'ledger.go').write_text(bug)
+        git('add','.');git('commit','-qm','test: capture the original ledger source')
+        base=git('rev-parse','HEAD')
+        # Oracle kit remains in the workspace, not the original source/index.
