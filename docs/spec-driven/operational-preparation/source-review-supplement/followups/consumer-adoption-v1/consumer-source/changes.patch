+        (kit/'primary_test.go').write_text(formatted(fixture.PRIMARY))
+        (kit/'independent_test.go').write_text(formatted(fixture.INDEPENDENT))
+        (kit/'metric_test.go').write_text(formatted(METRIC_TEST))
+        shutil.copyfile(ROOT/'plugin/scripts/go_oracle_driver.py',kit/'oracles/go_oracle_driver.py')
+        (kit/'oracles/selection_driver.py').write_text(DRIVER)
+        requirement={'symptom_id':'ledger-total','symptom_case':'symptom','controls':['empty','single']}
+        (kit/'acceptance.json').write_text(json.dumps(requirement))
+        (kit/'derivation.md').write_text('Independent conservation: subtract each original credit from the observed total. Check a second ledger; no primary constant/helper is shared. Controlled source example, not independent human acceptance.\n')
+        (workspace/'ticket.json').write_text(json.dumps({'id':'fixture','symptom':'earlier credits vanish from total','scope':'pure integer ledger function; immutable inputs, no hidden mutable state'}))
+        sources={p.as_posix():('kit/'+p.as_posix()) for p in [Path('primary_test.go'),Path('independent_test.go'),Path('metric_test.go'),Path('oracles/go_oracle_driver.py'),Path('oracles/selection_driver.py'),Path('acceptance.json'),Path('derivation.md')]}
+        hashes={p:oracle.sha((workspace/q).read_bytes()) for p,q in sources.items()}
+        hashes['go.mod']=oracle.sha((repo/'go.mod').read_bytes())
+        def mutants(kind):
+            if kind=='overfit':a,b='return 42','return entries[len(entries)-1]';x,y='return 42','return 41'
+            else:a,b='total += credit','total = credit';x,y='return total','return 42'
+            return [{'id':'lost-credit','kind':'reintroduce_symptom','patches':[{'path':'ledger.go','before':a,'after':b}]},
+                    {'id':'literal-overfit','kind':'overfit','patches':[{'path':'ledger.go','before':x,'after':y}]}]
+        plan={'schema_version':1,'tier':'simulation','base_ref':base,**requirement,
+              'ticket_file':'ticket.json','ticket_sha256':oracle.sha((workspace/'ticket.json').read_bytes()),
+              'requirement_file':'acceptance.json','independent_derivation_file':'derivation.md','frozen_files':hashes,
+              'oracles':[{'id':'primary','role':'primary','assertion_id':'ticket_balance','files':['primary_test.go'],
+                         'command':[sys.executable,'oracles/go_oracle_driver.py','--package','.','--test','TestPrimary','--assertion-id','ticket_balance']},
+                        {'id':'independent','role':'independent','assertion_id':'conservation','files':['independent_test.go'],
+                         'command':[sys.executable,'oracles/go_oracle_driver.py','--package','.','--test','TestIndependent','--assertion-id','conservation']}],
+              'mutants':mutants('loop'),'timeout_seconds':120,'max_total_seconds':600}
+        (workspace/'oracle-template.json').write_text(json.dumps(plan,indent=2)+'\n')
+        fixture_judge=workspace/'fixture_judge.py';fixture_judge.write_text(FIXTURE_PANEL)
+        judge_command=[sys.executable,str(fixture_judge if args.panel=='fixture' else ROOT/'plugin/scripts/claude_fix_judge.py')]
+        judge_source=Path(judge_command[1])
+        candidates=[{'id':'loop','rationale':'recompute every credit at its producer with a constant-space loop','commit_subject':'fix: include every ledger credit','changes':[{'path':'ledger.go','before':bug,'after':fixed}],'mutants':mutants('loop')},
+                    {'id':'copy','rationale':'snapshot credits before recomputing the same total, paying an extra allocation','commit_subject':'fix: total all copied ledger credits','changes':[{'path':'ledger.go','before':bug,'after':copied}],'mutants':mutants('copy')},
+                    {'id':'literal','rationale':'tempting symptom masking: return only the primary example total','commit_subject':'fix: return the example ledger total','changes':[{'path':'ledger.go','before':bug,'after':formatted('package ledger\nfunc Balance(entries []int) int { return 42 }\n')}],'mutants':mutants('overfit')}]
+        spec={'schema_version':1,'source_base_ref':base,'oracle_plan':'oracle-template.json','oracle_sources':sources,
+              'criteria':{'selection_rule':'unanimous-panel-and-pareto','axes':[{'id':'changed_lines','unit':'lines','direction':'min','required':True},
+                  {'id':'allocations','unit':'allocations/call','direction':'min','required':True}],
+                  'role_scope':'Each accept/reject concerns the minimum safety of that role; merely preferring a cheaper valid candidate is not a rejection. This is an isolated pure function with immutable inputs. No claim about production callsites or universal optimality.'},
+              'regression_driver':{'command':[sys.executable,'oracles/selection_driver.py','regression'],'source_file':'oracles/selection_driver.py'},
+              'metric_drivers':[{'command':[sys.executable,'oracles/selection_driver.py','metrics'],'source_file':'oracles/selection_driver.py'}],
+              'judges':[{'id':role,'role':role,'kind':args.panel,'command':judge_command,'adapter_source':str(judge_source),'adapter_sha256':oracle.sha(judge_source.read_bytes())} for role in sorted(selection.ROLES)],
