+import copy
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SCRIPTS=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(SCRIPTS))
+import fix_selection as select
+import oracle_gate as oracle
+fixture_spec=importlib.util.spec_from_file_location("oracle_fixtures",Path(__file__).with_name("test_oracle_gate.py"))
+fixtures=importlib.util.module_from_spec(fixture_spec);fixture_spec.loader.exec_module(fixtures)
+
+REGRESSION='''import json,sys
+from pathlib import Path
+sys.path.insert(0,str(Path.cwd()))
+from ledger import balance
+p=json.load(sys.stdin)
+good=all(balance(x)==y for x,y in [([],0),([8],8),([12,30],42),([7,10],17)])
+print(json.dumps({'schema_version':1,'candidate_id':p['candidate_id'],'subject_commit':p['subject_commit'],'status':'PASS' if good else 'FAIL'}))
+'''
+PANEL='''import json,sys
+p=json.load(sys.stdin)
+eligible=[c for c in p['candidates'] if c['hard_eligible']]
+best=min(eligible,key=lambda c:c['metrics']['changed_lines']['value'])['id'] if eligible else None
+print(json.dumps({'schema_version':1,'judge_id':p['judge_id'],'role':p['role'],
+'preferred_candidate':best,'votes':[{'candidate_id':c['id'],'verdict':'accept' if c['hard_eligible'] else 'reject',
+'reason':'controlled fixture: use observed hard eligibility and edit size, not independent judgment',
+'evidence_sha256':c['evidence_sha256']} for c in p['candidates']]}))
+'''
+LOOP='def balance(entries):\n    total = 0\n    for value in entries:\n        total += value\n    return total\n'
+
+
+def build_fixture(root):
+    f=fixtures.Fixture(root)
+    f.git('checkout','--detach',f.base)
+    (f.repo/'oracles/regression.py').write_text(REGRESSION)
+    f.git('add','oracles/regression.py');f.git('commit','-qm','test: freeze ledger regression conditions')
+    f.base=f.git('rev-parse','HEAD').strip()
+    f.plan['base_ref']=f.base
+    f.plan['frozen_files']['oracles/regression.py']=oracle.sha((f.repo/'oracles/regression.py').read_bytes())
+    f.save_plan()
+    panel=f.workspace/'fixture-panel.py';panel.write_text(PANEL)
+    mutations=lambda first,second:[{'id':'lost','kind':'reintroduce_symptom','patches':[{'path':'ledger.py','before':first[0],'after':first[1]}]},
+                                  {'id':'overfit','kind':'overfit','patches':[{'path':'ledger.py','before':second[0],'after':second[1]}]}]
+    f.selection={'schema_version':1,'source_base_ref':f.base,'oracle_plan':'oracle-validity-plan.json',
+        'criteria':{'selection_rule':'unanimous-panel-and-pareto','axes':[{'id':'changed_lines','unit':'lines','direction':'min','required':True}]},
+        'regression_driver':{'command':[sys.executable,'oracles/regression.py'],'source_file':'oracles/regression.py'},'metric_drivers':[],
+        'judges':[{'id':role,'role':role,'kind':'fixture','command':[sys.executable,str(panel)],'adapter_source':str(panel),'adapter_sha256':oracle.sha(panel.read_bytes())} for role in sorted(select.ROLES)],
+        'candidates':[{'id':'sum','rationale':'recompute the aggregate from every credit','commit_subject':'fix: sum every ledger credit',
+            'changes':[{'path':'ledger.py','before':fixtures.BUGGY,'after':fixtures.FIXED}],
+            'mutants':mutations(('sum(entries)','entries[-1] if entries else 0'),('sum(entries)','42'))},
+            {'id':'loop','rationale':'accumulate every credit explicitly','commit_subject':'fix: accumulate all ledger credits',
+            'changes':[{'path':'ledger.py','before':fixtures.BUGGY,'after':LOOP}],
+            'mutants':mutations(('total += value','total = value'),('return total','return 42'))}],
+        'timeout_seconds':5,'max_total_seconds':120}
+    f.selection_path=f.workspace/'fix-selection-spec.json'
+    f.selection_path.write_text(json.dumps(f.selection,indent=2)+'\n')
+    return f
+
+
+def bind(f,report):
+    path=f.workspace/'fix-selection-report.json';path.write_text(json.dumps(report,indent=2)+'\n')
+    f.state['states']['DESIGN']={'fix_selection_spec_sha256':oracle.sha(f.selection_path.read_bytes()),
+        'fix_selection_report_sha256':oracle.sha(path.read_bytes()),'selected_candidate_commit':report['decision'].get('selected_commit')}
+    f.save_state()
+
+
+def rows():
+    return [{'id':name,'commit':name*40,'tree':name,'hard_eligible':True,'metrics':{'cost':{'value':value,'unit':'units'}}} for name,value in [('a',1),('b',3)]]
+
+
+def panel(candidates,preferred='a'):
+    return [{'role':role,'opinion':{'preferred_candidate':preferred,'votes':[{'candidate_id':c['id'],'verdict':'accept'} for c in candidates]}} for role in sorted(select.ROLES)]
+
+
+class DecisionTests(unittest.TestCase):
+    axes={'axes':[{'id':'cost','unit':'units','direction':'min','required':True}],'selection_rule':'unanimous-panel-and-pareto'}
+    def test_sole_measured_dominance_and_panel_agreement_select(self):
+        c=rows();self.assertEqual(select.decide(self.axes,c,panel(c))['selected_candidate'],'a')
+    def test_tie_does_not_choose_first_candidate(self):
+        c=rows();c[1]['metrics']['cost']['value']=1
+        self.assertEqual(select.decide(self.axes,c,panel(c))['status'],'TIED')
+    def test_unknown_required_measurement_defers_not_eliminates_competitor(self):
+        c=rows();c[1]['metrics']['cost']['value']=None
+        self.assertEqual(select.decide(self.axes,c,panel(c))['status'],'DEFERRED')
+    def test_conflicting_panel_preference_defers(self):
+        c=rows();p=panel(c);p[0]['opinion']['preferred_candidate']='b'
+        self.assertEqual(select.decide(self.axes,c,p)['status'],'DEFERRED')
+    def test_abstention_or_candidate_judgment_disagreement_defers(self):
+        c=rows();p=panel(c);p[0]['opinion']['votes'][1]['verdict']='reject'
+        self.assertEqual(select.decide(self.axes,c,p)['status'],'DEFERRED')
+    def test_all_hard_ineligible_are_rejected(self):
+        c=rows()
+        for x in c:x['hard_eligible']=False
+        self.assertEqual(select.decide(self.axes,c,panel(c))['status'],'REJECTED')
+    def test_infrastructure_failure_does_not_make_an_observed_competitor_best(self):
+        c=rows();c[1]['hard_eligible']=False;c[1]['observation_complete']=False
+        self.assertEqual(select.decide(self.axes,c,panel(c))['status'],'DEFERRED')
+    def test_tradeoff_frontier_is_tied_not_weighted_sum(self):
+        c=rows();c[0]['metrics']['noise']={'value':9,'unit':'hits'};c[1]['metrics']['noise']={'value':1,'unit':'hits'}
+        criteria=copy.deepcopy(self.axes);criteria['axes'].append({'id':'noise','unit':'hits','direction':'min','required':True})
+        self.assertEqual(select.decide(criteria,c,panel(c))['status'],'TIED')
+    def test_axis_direction_and_tolerance_apply(self):
+        c=rows();criteria=copy.deepcopy(self.axes);criteria['axes'][0]['direction']='max'
+        self.assertEqual(select.decide(criteria,c,panel(c,'b'))['selected_candidate'],'b')
+        criteria['axes'][0]['tolerance']=3
+        self.assertEqual(select.decide(criteria,c,panel(c,'b'))['status'],'TIED')
+
+
+class ExecutionTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)
+        self.f=build_fixture(Path(self.tmp.name))
+    def test_actual_candidates_run_frozen_oracles_and_regression_without_checkout_changes(self):
+        f=self.f;head=f.git('rev-parse','HEAD');report=select.run_selection(f.workspace,f.repo)
+        self.assertEqual(report['decision']['selected_candidate'],'sum')
+        self.assertEqual(len(report['candidates']),2)
+        self.assertEqual(sum(len(c['oracle_report']['runs']) for c in report['candidates']),32)
+        self.assertEqual(f.git('rev-parse','HEAD'),head)
+        self.assertEqual((f.repo/'ledger.py').read_text(),fixtures.BUGGY)
+        self.assertEqual(f.git('status','--porcelain'),'')
+        bind(f,report);select.verify_selection(f.workspace,f.repo,f.state)
+        f.state['current_state']='DESIGN';f.save_state()
+        hook=SCRIPTS.parents[0]/'hooks/fix-selection-guard.py'
+        def guarded(target):
+            payload={'tool_name':'Write','tool_input':{'file_path':str(f.workspace/'state.json'),'content':json.dumps({**f.state,'current_state':target})}}
+            return subprocess.run([sys.executable,str(hook)],input=json.dumps(payload),capture_output=True,text=True,timeout=15).stdout
+        self.assertEqual(guarded('IMPLEMENTATION'),'')
+        self.assertIn('"deny"',guarded('EVALUATION'))
+        with self.assertRaisesRegex(oracle.GateError,'implemented source differs'):
+            select.verify_selection(f.workspace,f.repo,f.state,True)
+        f.git('merge','--ff-only',report['decision']['selected_commit'])
+        select.verify_selection(f.workspace,f.repo,f.state,True)
+        self.assertEqual(guarded('EVALUATION'),'')
+        f.state['states']['DESIGN']['fix_selection_report_sha256']='0'*64
+        self.assertIn('"deny"',guarded('IMPLEMENTATION'))
+    def test_claimed_metric_and_forged_raw_receipt_are_rejected(self):
+        f=self.f;report=select.run_selection(f.workspace,f.repo)
+        for mutation in ['metric','raw']:
+            bad=copy.deepcopy(report)
+            if mutation=='metric':bad['candidates'][0]['metrics']['changed_lines']['value']=0
+            else:bad['candidates'][0]['drivers'][0]['stdout']='{}'
+            bind(f,bad)
+            with self.assertRaises(oracle.GateError):select.verify_selection(f.workspace,f.repo,f.state)
+    def test_frozen_criteria_change_invalidates_selection(self):
+        f=self.f;report=select.run_selection(f.workspace,f.repo);bind(f,report)
+        f.selection['criteria']['axes'][0]['direction']='max'
+        f.selection_path.write_text(json.dumps(f.selection))
+        with self.assertRaisesRegex(oracle.GateError,'stale'):select.verify_selection(f.workspace,f.repo,f.state)
+    def test_candidate_cannot_mutate_frozen_oracle(self):
+        f=self.f;f.selection['candidates'][0]['changes'][0]['path']='oracles/primary.py'
+        f.selection_path.write_text(json.dumps(f.selection))
+        with self.assertRaisesRegex(oracle.GateError,'frozen'):select.run_selection(f.workspace,f.repo)
+    def test_duplicate_source_trees_do_not_count_as_alternatives(self):
+        f=self.f;other=copy.deepcopy(f.selection['candidates'][0]);other['id']='another'
+        f.selection['candidates'][1]=other;f.selection_path.write_text(json.dumps(f.selection))
+        with self.assertRaisesRegex(oracle.GateError,'duplicate source trees'):select.run_selection(f.workspace,f.repo)
+    def test_nonfinite_metric_input_or_wrong_panel_citation_is_rejected(self):
+        f=self.f;spec=copy.deepcopy(f.selection);spec['criteria']['axes'][0]['tolerance']=float('nan')
+        with self.assertRaises(oracle.GateError):select.validate(spec)
+        candidate={'id':'sum','evidence_sha256':['diff','oracle','regression']}
+        raw={'schema_version':1,'judge_id':'correctness','role':'correctness','preferred_candidate':'sum','votes':[{'candidate_id':'sum','verdict':'accept','reason':'reason','evidence_sha256':['diff']}]}
+        row={'exit_code':0,'timed_out':False,'launch_error':None,'stdout':json.dumps(raw),'stderr':''}
+        with self.assertRaisesRegex(oracle.GateError,'role-specific'):select.parse_panel(row,{'id':'correctness','role':'correctness'},[candidate])
+    def test_failed_panel_is_deferred_and_never_reuses_a_previous_selection(self):
