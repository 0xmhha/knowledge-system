+#!/usr/bin/env python3
+"""Execute a Go bugfix through the production oracle CLI and completion hook.
+
+Creates only an owned disposable repository; exports its Git bundle and reports
+for replay. No model/chain service is started and no human acceptance is invented.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+PLUGIN = Path(__file__).resolve().parents[2] / "plugin"
+BUG = '''package ledger
+func Balance(entries []int) int {
+ if len(entries) == 0 { return 0 }
+ return entries[len(entries)-1]
+}
+'''
+FIX = '''package ledger
+func Balance(entries []int) int {
+ total := 0
+ for _, credit := range entries { total += credit }
+ return total
+}
+'''
+PRIMARY = '''package ledger
+import ("os"; "testing")
