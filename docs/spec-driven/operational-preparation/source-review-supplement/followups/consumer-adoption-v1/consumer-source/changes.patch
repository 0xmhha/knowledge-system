+#!/usr/bin/env python3
+"""Bind bugfix analysis handoff to validated factual labels or a failed tool receipt."""
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'scripts'))
+from suspect_labels import verify_state
+spec=importlib.util.spec_from_file_location('completion_guard',ROOT/'hooks/completion-guard.py');helper=importlib.util.module_from_spec(spec);spec.loader.exec_module(helper)
+
+def main():
+ try:data=json.load(sys.stdin)
+ except (ValueError,TypeError):return 0
+ if not isinstance(data,dict) or data.get('tool_name') not in ('Write','Edit'):return 0
+ inputs=data.get('tool_input')
+ if not isinstance(inputs,dict) or not isinstance(inputs.get('file_path'),str):return 0
+ path=Path(inputs['file_path']);path=path if path.is_absolute() else Path(data.get('cwd') or os.getcwd())/path
+ if path.name!='state.json':return 0
+ recognizable='.coding-agent' in path.parts and 'tickets' in path.parts
+ try:
+  old=path.read_text() if path.exists() else '{}'
+  state=json.loads(old)
+  if not recognizable and not (isinstance(state,dict) and state.get('ticket_id')):return 0
+  proposed=json.loads(helper.proposed_content(data,old))
+  if not isinstance(state,dict) or not isinstance(proposed,dict):raise ValueError('pipeline state must be object')
+  if state.get('ticket_type')!='bugfix' and proposed.get('ticket_type')!='bugfix':return 0
+  if state.get('ticket_type')=='bugfix' and proposed.get('ticket_type')!='bugfix':raise ValueError('cannot bypass bugfix label evidence by changing ticket type')
+  completed=proposed.get('states',{}).get('ANALYSIS',{}).get('status')=='completed'
+  target=proposed.get('current_state')
+  if completed or target in ('PLANNING','DESIGN','IMPLEMENTATION','EVALUATION','COMPLETION','COMPLETED'):
+   raw=(path.parent/'suspect-labels.json').read_bytes();verify_state(json.loads(raw))
+   if proposed.get('states',{}).get('ANALYSIS',{}).get('suspect_labels_sha256')!=hashlib.sha256(raw).hexdigest():raise ValueError('analysis must bind exact validated label artifact SHA256')
+ except Exception as exc:helper.deny('Bugfix factual labels blocked: '+str(exc))
+ return 0
+
+if __name__=='__main__':raise SystemExit(main())
