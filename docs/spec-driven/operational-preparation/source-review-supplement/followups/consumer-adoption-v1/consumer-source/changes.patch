+#!/usr/bin/env python3
+"""Record controlled local-boundary CLI/hook events; no host or model calls."""
+import argparse
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'plugin/scripts/tests'))
+from test_publication_policy import PolicyTests
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path, required=True)
+    out = parser.parse_args().out.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    case = PolicyTests()
+    case.setUp()
+    events = []
+    try:
+        def cli(action):
+            result = case.cli(action)
+            events.append({'kind': 'cli', 'action': action, 'exit_code': result.returncode,
+                           'stdout': result.stdout, 'stderr': result.stderr})
+            return result
+        def hook(name, payload):
+            result = case.hook(name, payload)
+            events.append({'kind': 'hook_subprocess_not_host', 'hook': name,
+                           'payload': payload, 'response': result})
+            return result
+        assert cli('--init').returncode == 0
+        assert hook('on-stop.py', {'stop_hook_active': False})['decision'] == 'block'
+        assert hook('on-stop.py', {'stop_hook_active': True}) == {}
+        case.ready()
+        shutil.copyfile(case.f.workspace / 'state.json', out / 'state-before-exit.json')
+        assert cli('--finalize').returncode == 0
+        assert cli('--check-exit').returncode == 0
+        assert hook('on-stop.py', {'stop_hook_active': False}) == {}
+        assert hook('on-stop.py', {'stop_hook_active': False}) == {}
+        for payload in (
+            {'tool_name': 'Bash', 'tool_input': {'command': 'git push origin evaluation-fixture'}},
+            {'tool_name': 'Bash', 'tool_input': {'command': 'gh pr create --title evaluation-fixture'}},
+            {'tool_name': 'mcp__plugin_coding-agent_jira-gateway__jira_add_comment', 'tool_input': {}},
+        ):
+            result = hook('publication-guard.py', payload)
+            assert result['hookSpecificOutput']['permissionDecision'] == 'deny'
+        shutil.copytree(case.f.workspace, out / 'workspace')
+        subprocess.run(['git', '-C', str(case.f.repo), 'bundle', 'create', str(out / 'subject.bundle'), '--all'], check=True)
+        report = case.f.workspace / 'test-report.md'
+        report.write_text('tampered')
+        assert cli('--check-exit').returncode != 0
+        assert hook('on-stop.py', {'stop_hook_active': False})['decision'] == 'block'
+        summary = {'kind': 'controlled_fixture_cli_and_hook_subprocesses', 'status': 'PASS',
+                   'oracle_executions': 'actual Python ledger controls and source mutants',
+                   'selection': 'two actual source proposals, fixture panel opinions',
+                   'model_calls': 0, 'host_sessions': 0, 'external_publication_calls': 0,
+                   'independent_human_acceptance': 'not_recorded', 'events': events}
+        (out / 'events.json').write_text(json.dumps(summary, indent=2) + '\n')
+        print(json.dumps({k: v for k, v in summary.items() if k != 'events'}))
+        return 0
+    finally:
+        case.doCleanups()
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
