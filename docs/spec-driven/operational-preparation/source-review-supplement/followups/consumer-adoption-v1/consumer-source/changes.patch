+  self.state={'ticket_id':'fixture','ticket_type':'bugfix','current_state':'EVALUATION','states':{'ANALYSIS':{'investigation_kind':'timing'},'EVALUATION':{'cycle':1}}}
+  (self.workspace/'state.json').write_bytes(timing.encode(self.state))
+ def fixture(self,phase='evaluation',verdict='OBSERVED_RATE_BOUND_MET'):
+  files=timing.paths(self.workspace,phase);files['plan'].parent.mkdir(parents=True,exist_ok=True)
+  value=report('comparison'if phase=='evaluation'else'reproduction',verdict)
+  identity={'binary':'/trusted/chainbench','binary_sha256':'a'*64,'source_commit':'b'*40}
+  input_value={'plan':value['plan']}
