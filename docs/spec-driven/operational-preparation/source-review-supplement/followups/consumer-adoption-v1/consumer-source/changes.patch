+ return {'schema_version':1,'plan':{'mode':mode,'before':{'commit':'1'*40},'after':{'commit':'2'*40}if mode=='comparison'else None,'injection':None,'resume':None},'before':counts,'after':after if mode=='comparison'else None,'verdict':verdict,'resume_requested':mode=='observation'and verdict=='RECURRED','acceptance':'not_recorded'}
