+        report = self.fixture(primary=primary).run()
+        self.assertEqual(report["mechanical_verdict"], "FAIL")
+        self.assertFalse(next(x for x in report["checks"] if x["variant"] == "base" and x["oracle_id"] == "primary")["passed"])
+
+    def test_compile_failure_is_error_not_symptom_red(self):
+        report = self.fixture(head="def balance(entries):\n    return sum(entries) +\n").run()
+        self.assertEqual(report["mechanical_verdict"], "ERROR")
+        self.assertTrue(any(r["outcome"] == "ERROR" and r["exit_code"] == 1 for r in report["runs"]))
+
+    def test_wrong_assertion_identity_cannot_reproduce_ticket(self):
