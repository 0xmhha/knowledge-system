+#!/usr/bin/env python3
+"""Freeze timing artifacts and block unverified timing pipeline transitions."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'scripts'))
+from timing_investigation import generation, state_check
+spec=importlib.util.spec_from_file_location('completion_guard',ROOT/'hooks/completion-guard.py');helper=importlib.util.module_from_spec(spec);spec.loader.exec_module(helper)
+
+def main():
+ try:data=json.load(sys.stdin)
+ except (ValueError,TypeError):return 0
+ if not isinstance(data,dict)or data.get('tool_name')not in ('Write','Edit'):return 0
+ inputs=data.get('tool_input')
+ if not isinstance(inputs,dict)or not isinstance(inputs.get('file_path'),str):return 0
+ path=Path(inputs['file_path']);path=path if path.is_absolute()else Path(data.get('cwd')or os.getcwd())/path
+ is_state=path.name=='state.json'
+ is_log=('/timing/'in str(path)and '/logs/'in str(path))or path.name=='timing-instrumentation-plan.json'
+ if is_log and path.exists():helper.deny('Retained observation source/inputs/evidence are immutable; use the next bounded window/generation');return 0
+ is_plan=path.name in ('timing-analysis-plan.json','timing-analysis-input.json','timing-evaluation-plan.json','timing-evaluation-input.json') and path.parent.parent.name=='timing'
+ if not is_state and not is_plan:return 0
+ workspace=path.parent if is_state else path.parent.parent.parent
+ recognizable='.coding-agent'in workspace.parts and 'tickets'in workspace.parts
+ try:
+  state=json.loads((workspace/'state.json').read_text())
+  if not recognizable and not (isinstance(state,dict)and state.get('ticket_id')):return 0
+  analysis=state.get('states',{}).get('ANALYSIS',{})
+  existing=analysis.get('investigation_kind')in ('timing','observation')
+  if is_plan:
+   if path.exists():raise ValueError('timing phase inputs are immutable; retain old generation and return to analysis for a bounded new cycle')
+   return 0
+  old=path.read_text();proposed=json.loads(helper.proposed_content(data,old))
+  if not isinstance(proposed,dict):raise ValueError('pipeline state must remain object')
+  next_analysis=proposed.get('states',{}).get('ANALYSIS',{})
+  active=next_analysis.get('investigation_kind')in ('timing','observation')
+  if existing and (not active or proposed.get('ticket_type')!='bugfix'):raise ValueError('cannot erase timing investigation requirements')
+  if not active or proposed.get('ticket_type')!='bugfix':return 0
+  cycle=generation(proposed);old_cycle=generation(state)
+  if analysis.get('log_observation_result_sha256'):
+   from timing_log_observation import state_check as log_state_check
+   previous=log_state_check(workspace,state)
+   if cycle!=old_cycle and previous['verdict']!='RECURRED':raise ValueError('log-driven analysis resume requires a verified recurrence')
+   if cycle==old_cycle:
+    for key in ('log_observation_window','log_observation_plan_sha256','log_observation_result_sha256'):
+     if analysis.get(key)!=next_analysis.get(key):
+      new_window=next_analysis.get('log_observation_window')
+      if previous['verdict']!='AWAITING_OBSERVATION' or new_window!=analysis.get('log_observation_window')+1 or proposed.get('current_state')!='ANALYSIS':raise ValueError('cannot erase/replace retained log binding; only next bounded awaiting window')
+  if cycle!=old_cycle:
+   if cycle!=old_cycle+1 or proposed.get('current_state')!='ANALYSIS':raise ValueError('new timing generation requires the next bounded cycle in analysis')
+  elif proposed.get('current_state')!='ANALYSIS':
+   for phase in ('ANALYSIS','EVALUATION'):
+    before=state.get('states',{}).get(phase,{})
+    after=proposed.get('states',{}).get(phase,{})
+    for key in ('timing_plan_sha256','timing_result_sha256','log_observation_plan_sha256','log_observation_result_sha256'):
+     if before.get(key)and before.get(key)!=after.get(key):raise ValueError('cannot rewrite frozen timing bindings outside analysis')
+  target=proposed.get('current_state')
+  if next_analysis.get('log_observation_result_sha256') and cycle==old_cycle:
+   from timing_log_observation import state_check as log_state_check
+   log_state_check(workspace,proposed)
+  if next_analysis.get('status')=='completed' or target in ('PLANNING','DESIGN','IMPLEMENTATION','EVALUATION','COMPLETION','COMPLETED'):
+   state_check(workspace,proposed,'analysis')
+  if target in ('COMPLETION','COMPLETED'):
+   state_check(workspace,proposed,'evaluation',True)
+ except Exception as exc:
+  if recognizable or 'state'in locals()and isinstance(state,dict)and state.get('ticket_id'):helper.deny('Timing investigation blocked: '+str(exc))
