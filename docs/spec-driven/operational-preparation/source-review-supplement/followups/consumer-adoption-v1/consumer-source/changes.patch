+
+    def test_real_bug_fix_controls_and_both_source_mutants(self):
+        f = self.fixture()
+        report = f.run()
+        self.assertEqual(report["mechanical_verdict"], "PASS")
+        self.assertEqual(len(report["runs"]), 16)
+        overfit = [r for r in report["runs"] if r["variant"] == "mutant:literal-overfit"]
+        self.assertEqual([r["outcome"] for r in overfit], ["GREEN", "RED"])
+        self.assertTrue(all(r["source_unchanged"] for r in report["runs"]))
+        self.assertEqual(report["independent_human_acceptance"], "not_recorded")
+        self.assertEqual(f.git("status", "--porcelain"), "")
+        self.assertEqual((f.repo / "ledger.py").read_text(), FIXED)
+
+    def test_base_green_is_not_a_warning_pass(self):
