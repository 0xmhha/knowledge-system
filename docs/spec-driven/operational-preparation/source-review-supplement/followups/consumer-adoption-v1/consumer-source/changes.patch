+        self.assertEqual(report["mechanical_verdict"], "FAIL")
+        self.assertTrue(any(x["variant"] == "head" and x["case_id"] == "empty" and not x["passed"] for x in report["checks"]))
+
+    def test_frozen_oracle_edit_is_rejected(self):
