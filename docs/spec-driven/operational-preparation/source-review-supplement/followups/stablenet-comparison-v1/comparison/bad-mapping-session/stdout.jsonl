":"47e4db882a5c1174a3004abe6254250e28ccc74007a3dbe7d19fad1b00b40844","snapshot_id":"dca6c171559e3b9229ea75d9519da635767122a66a5eeab61e207a0c2467a6c2","source_mode":"working-tree","base_commit":"1350376a680489298b3203a44d9ebddb7747f9cc","origin_id":"repo","file_sha256":"b8e0de7435ba60a6a879469d8daa3257bdfc19c6172c9141f282a565bc935f1f","content_sha256":"07ac18a0199442048ee61869115359ea58ad405d7f77c46f7711194656a8eb52"}},"body":"func (c *Clique) verifySeal(snap *Snapshot, header *types.Header, parents []*types.Header) error {\n\t// Verifying the genesis block is not supported\n\tnumber := header.Number.Uint64()\n\tif number == 0 {\n\t\treturn errUnknownBlock\n\t}\n\t// Resolve the authorization key and check against signers\n\tsigner, err := ecrecover(header, c.signatures)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif _, ok := snap.Signers[signer]; !ok {\n\t\treturn errUnauthorizedSigner\n\t}\n\tfor seen, recent := range snap.Recents {\n\t\tif recent == signer {\n\t\t\t// Signer is among recents, only fail if the current block doesn't shift it out\n\t\t\tif limit := uint64(len(snap.Signers)/2 + 1); seen \u003e number-limit {\n\t\t\t\treturn errRecentlySigned\n\t\t\t}\n\t\t}\n\t}\n\t// Ensure that the difficulty corresponds to the turn-ness of the signer\n\tif !c.fakeDiff {\n\t\tinturn := snap.inturn(header.Number.Uint64(), signer)\n\t\tif inturn \u0026\u0026 header.Difficulty.Cmp(diffInTurn) != 0 {\n\t\t\treturn errWrongDifficulty\n\t\t}\n\t\tif !inturn \u0026\u0026 header.Difficulty.Cmp(diffNoTurn) != 0 {\n\t\t\treturn errWrongDifficulty\n\t\t}\n\t}\n\treturn nil\n}\n"}],"warnings":["mapping_semantics_not_reviewed","evidence_kind_is_declared_not_inferred","test_source_is_not_test_execution","reviewer_identity_not_authenticated","mapping_review_does_not_approve_policy_contents"]},"review":{"state":"proposed","validity":"unknown","required_approvals":1,"approvals":0,"rejections":0,"used_review_digests":[],"stale_review_count":0,"future_review_count":0,"reviewer_identity