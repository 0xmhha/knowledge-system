// Package debugtrace records what each retrieval algorithm received and
// produced during one compose call, so an evaluation run can show the exact
// step where a known answer was lost or a wrong citation was promoted.
//
// The footprint logger keeps production telemetry small: counts, the top
// citation, error totals. That is not enough to debug ranking. A debug trace
// keeps the full lists instead — every hit, keyword, contribution and
// selection decision — on both sides of each algorithm:
//
//	stage/step  phase=before  the input the algorithm saw
//	stage/step  phase=after   the output it produced
//
// Tracing is off unless the caller attaches a Recorder to the context.
// Every method is nil-safe, and From returns nil when tracing is off, so a
// call site guards its payload construction with
//
//	if rec := debugtrace.From(ctx); rec != nil {
//		rec.After("stage2", "find_symbol", kw, payload(...))
//	}
//
// and pays nothing in normal operation.
package debugtrace

import (
	"context"
	"encoding/json"
	"fmt"
	"os"
	"sync"

	"github.com/0xmhha/knowledge-system/pkg/system/contract"
)

// SchemaVersion identifies the record layout written by FileSink. Bump it
// when a field changes meaning so analysis scripts can refuse old files.
const SchemaVersion = 1

// EnvPath names the environment variable cks reads to enable tracing: the
// value is the JSONL file each compose call appends one record to.
const EnvPath = "CKS_DEBUG_TRACE"

// Phase values. Before is the algorithm's input, After its output. Note is a
// single observation that has no before/after pair (a decision, a skip).
const (
	PhaseBefore = "before"
	PhaseAfter  = "after"
	PhaseNote   = "note"
)

// Event is one snapshot. Key distinguishes repeated runs of the same step:
// the keyword for per-keyword searches, the round number for recall rounds.
type Event struct {
	Stage string `json:"stage"`
	Step  string `json:"step"`
	Phase string `json:"phase"`
	Key   string `json:"key,omitempty"`
	Data  any    `json:"data,omitempty"`
}

// Recorder collects the events of one compose call. Safe for concurrent use.
type Recorder struct {
	mu     sync.Mutex
	events []Event
}

// NewRecorder returns an empty Recorder.
func NewRecorder() *Recorder { return &Recorder{} }

// Before records an algorithm's input.
func (r *Recorder) Before(stage, step, key string, data any) {
	r.add(Event{Stage: stage, Step: step, Phase: PhaseBefore, Key: key, Data: data})
}

// After records an algorithm's output.
func (r *Recorder) After(stage, step, key string, data any) {
	r.add(Event{Stage: stage, Step: step, Phase: PhaseAfter, Key: key, Data: data})
}

// Note records a single observation with no before/after pair.
func (r *Recorder) Note(stage, step, key string, data any) {
	r.add(Event{Stage: stage, Step: step, Phase: PhaseNote, Key: key, Data: data})
}

func (r *Recorder) add(e Event) {
	if r == nil {
		return
	}
	r.mu.Lock()
	r.events = append(r.events, e)
	r.mu.Unlock()
}

// Events returns a copy of the recorded events in recording order.
func (r *Recorder) Events() []Event {
	if r == nil {
		return nil
	}
	r.mu.Lock()
	defer r.mu.Unlock()
	return append([]Event(nil), r.events...)
}

type ctxKey struct{}

// WithRecorder attaches r to ctx. A nil r returns ctx unchanged.
func WithRecorder(ctx context.Context, r *Recorder) context.Context {
	if r == nil {
		return ctx
	}
	return context.WithValue(ctx, ctxKey{}, r)
}

// From returns the Recorder attached to ctx, or nil when tracing is off.
func From(ctx context.Context) *Recorder {
	if ctx == nil {
		return nil
	}
	r, _ := ctx.Value(ctxKey{}).(*Recorder)
	return r
}

// Record is one JSONL line: everything one compose call recorded.
type Record struct {
	Schema       int     `json:"schema"`
	Seq          int     `json:"seq"`
	Prompt       string  `json:"prompt"`
	CallerIntent string  `json:"caller_intent,omitempty"`
	Error        string  `json:"error,omitempty"`
	Events       []Event `json:"events"`
}

// FileSink appends one Record per compose call to a JSONL file. Safe for
// concurrent use; Seq numbers records in write order so repeated compose
// calls for the same prompt stay distinguishable.
type FileSink struct {
	mu   sync.Mutex
	path string
	seq  int
}

// NewFileSink returns a sink that appends to path. The file is created on
// the first write.
func NewFileSink(path string) *FileSink { return &FileSink{path: path} }

var (
	sharedMu    sync.Mutex
	sharedSinks = map[string]*FileSink{}
)

// SharedFileSink returns one process-wide sink per path. A process that
// builds several composers (one per collection member) must share the sink,
// or concurrent writers would interleave lines and repeat Seq numbers.
func SharedFileSink(path string) *FileSink {
	sharedMu.Lock()
	defer sharedMu.Unlock()
	if s, ok := sharedSinks[path]; ok {
		return s
	}
	s := NewFileSink(path)
	sharedSinks[path] = s
	return s
}

// Write appends the recorder's events as one line. Errors are returned for
// tests and callers that care; compose ignores them so a full disk never
// fails a retrieval.
func (s *FileSink) Write(prompt string, callerIntent contract.Intent, r *Recorder, composeErr error) error {
	if s == nil {
		return nil
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	s.seq++
	rec := Record{Schema: SchemaVersion, Seq: s.seq, Prompt: prompt, CallerIntent: string(callerIntent), Events: r.Events()}
	if composeErr != nil {
		rec.Error = composeErr.Error()
	}
	b, err := json.Marshal(rec)
	if err != nil {
		return fmt.Errorf("debugtrace: marshal: %w", err)
	}
	f, err := os.OpenFile(s.path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
	if err != nil {
		return fmt.Errorf("debugtrace: open %s: %w", s.path, err)
	}
	if _, err := f.Write(append(b, '\n')); err != nil {
		_ = f.Close()
		return fmt.Errorf("debugtrace: write %s: %w", s.path, err)
	}
	return f.Close()
}

// Cite is the compact form of a citation in a trace payload.
type Cite struct {
	File    string   `json:"file"`
	Start   int      `json:"start"`
	End     int      `json:"end"`
	Symbol  string   `json:"symbol,omitempty"`
	Kind    string   `json:"kind,omitempty"`
	Score   float64  `json:"score,omitempty"`
	Sources []string `json:"sources,omitempty"`
}

// Hits converts ckv/ckg hits in list order.
func Hits(hs []contract.Hit) []Cite {
	out := make([]Cite, 0, len(hs))
	for _, h := range hs {
		out = append(out, Cite{File: h.Citation.File, Start: h.Citation.StartLine, End: h.Citation.EndLine,
			Symbol: h.Symbol, Kind: h.ChunkKind, Score: h.Score})
	}
	return out
}

// Citations converts bare citations in list order.
func Citations(cs []contract.Citation) []Cite {
	out := make([]Cite, 0, len(cs))
	for _, c := range cs {
		out = append(out, Cite{File: c.File, Start: c.StartLine, End: c.EndLine})
	}
	return out
}
package debugtrace

import (
	"bufio"
	"context"
	"encoding/json"
	"errors"
	"os"
	"path/filepath"
	"testing"

	"github.com/0xmhha/knowledge-system/pkg/system/contract"
)

func TestFromWithoutRecorderIsNil(t *testing.T) {
	t.Parallel()
	if r := From(context.Background()); r != nil {
		t.Fatalf("From(background) = %v, want nil", r)
	}
	if ctx := WithRecorder(context.Background(), nil); From(ctx) != nil {
		t.Fatal("WithRecorder(nil) attached a recorder")
	}
}

func TestNilRecorderIsNoop(t *testing.T) {
	t.Parallel()
	var r *Recorder
	r.Before("s", "step", "", 1)
	r.After("s", "step", "", 1)
	r.Note("s", "step", "", 1)
	if got := r.Events(); got != nil {
		t.Fatalf("nil recorder events = %v, want nil", got)
	}
}

func TestRecorderKeepsOrderAndPhase(t *testing.T) {
	t.Parallel()
	r := NewRecorder()
	ctx := WithRecorder(context.Background(), r)
	From(ctx).Before("stage1", "rerank", "1", []string{"a"})
	From(ctx).After("stage1", "rerank", "1", []string{"a"})
	From(ctx).Note("stage4", "decision", "", "skip")
	ev := r.Events()
	if len(ev) != 3 {
		t.Fatalf("events = %d, want 3", len(ev))
	}
	want := []string{PhaseBefore, PhaseAfter, PhaseNote}
	for i, e := range ev {
		if e.Phase != want[i] {
			t.Errorf("event %d phase = %q, want %q", i, e.Phase, want[i])
		}
	}
}

func TestFileSinkAppendsOneLinePerCall(t *testing.T) {
	t.Parallel()
	path := filepath.Join(t.TempDir(), "trace.jsonl")
	s := NewFileSink(path)
	r := NewRecorder()
	r.After("stage1", "ckv_search", "1", Hits([]contract.Hit{{Citation: contract.Citation{File: "a.go", StartLine: 1, EndLine: 2}, Symbol: "A"}}))
	if err := s.Write("p1", contract.IntentBugFix, r, nil); err != nil {
		t.Fatal(err)
	}
	if err := s.Write("p2", "", NewRecorder(), errors.New("boom")); err != nil {
		t.Fatal(err)
	}
	f, err := os.Open(path)
	if err != nil {
		t.Fatal(err)
	}
	defer f.Close()
	var recs []Record
	sc := bufio.NewScanner(f)
	for sc.Scan() {
		var rec Record
		if err := json.Unmarshal(sc.Bytes(), &rec); err != nil {
			t.Fatalf("line %q: %v", sc.Text(), err)
		}
		recs = append(recs, rec)
	}
	if err := sc.Err(); err != nil {
		t.Fatal(err)
	}
	if len(recs) != 2 {
		t.Fatalf("records = %d, want 2", len(recs))
	}
	if recs[0].Seq != 1 || recs[1].Seq != 2 || recs[0].Schema != SchemaVersion {
		t.Errorf("seq/schema = %d,%d,%d", recs[0].Seq, recs[1].Seq, recs[0].Schema)
	}
	if recs[0].CallerIntent != string(contract.IntentBugFix) || len(recs[0].Events) != 1 {
		t.Errorf("record 0 = %+v", recs[0])
	}
	if recs[1].Error != "boom" {
		t.Errorf("record 1 error = %q, want boom", recs[1].Error)
	}
}
"""Find where each scenario's answer was lost, and flag known failure shapes, from a CKS debug trace.

cks writes one JSON line per compose call to $CKS_DEBUG_TRACE (internal/system/debugtrace).
Each line holds every retrieval algorithm's input and output. This script joins those
lines to the scenarios by prompt and reports, per scenario:

  ranks     the first answer rank at each checkpoint, by the cks eval overlap rule
            without the commit filter (first_hit_any_commit):
              ckv_round<N>    Stage 1 ckv search of that round
              stage1          Stage 1 final hit list (rounds merged, knowledge pass)
              fused           Stage 2 RRF scores before demotion and cap
              stage2          Stage 2 citations after demotion and cap
              stage3          Stage 2 citations followed by Stage 3 neighbors
              stage4          Stage 4 selected bodies, in selection order
  lost_rank1_at   the first checkpoint where a rank-1 answer stopped being rank 1
  lost_found_at   the first checkpoint where a found answer disappeared
  flags     failure shapes seen in this call (see FLAGS)

The summary counts each flag and each loss point, so a change to an algorithm can be
checked by rerunning the evaluation and diffing two reports.

usage: retrieval_debug_trace_report.py --trace <jsonl> [--trace <jsonl> ...]
       --scenarios <dir> [--scenarios <dir> ...] [--out <json>] [--all-calls]
"""
from __future__ import annotations

import argparse
import json
import re
from collections import Counter
from pathlib import Path

import yaml

from retrieval_eval_summary import first_hit_any_commit

CHECKPOINTS = ('stage1', 'fused', 'stage2', 'stage3', 'stage4')

FLAGS = {
    'intent_wrong': 'classified intent differs from expected_intent',
    'intent_threshold': 'nearest intent was the expected one, but it fell below the threshold',
    'list_duplicate_credit': 'one ranked list credited the same citation more than once',
    'duplicate_credit_top1': 'the Stage 2 top citation got its score from repeated credits of one list',
    'symbol_fanout': 'a dotted symbol lost its leading segments and resolved to several nodes',
    'keyword_only_top1': 'the Stage 2 top citation has no ckv evidence',
    'hit_keyword_promoted_top1': 'a wrong Stage 2 top citation won on keywords mined from ckv hits',
    'score_outlier_top1': 'the Stage 2 top score is more than twice the second',
    'answer_demoted': 'demotion moved the answer down between the fused and final Stage 2 lists',
    'answer_cut_stage4': 'the answer reached Stage 4 but was not selected',
}

SOURCE_RE = re.compile(r'^(?P<list>[a-z_]+:.*?)@rank=(?P<rank>\d+)\(\+(?P<c>[0-9.]+)\)$')
HIT_ORIGINS = {'hit_symbol', 'hit_file'}


def cites(rows: list[dict] | None) -> list[dict]:
    return [{'file': r['file'], 'start_line': r['start'], 'end_line': r['end']} for r in rows or []]


def rank(expected: list[dict], rows: list[dict] | None) -> int:
    return first_hit_any_commit(expected, cites(rows))


def load_scenarios(dirs: list[Path]) -> dict[str, dict]:
    by_prompt: dict[str, dict] = {}
    for d in dirs:
        for p in sorted(d.rglob('*.yaml')):
            sc = yaml.safe_load(p.read_text())
            if not isinstance(sc, dict) or 'prompt' not in sc or 'expected_citations' not in sc:
                continue
            sc = {**sc, '_path': str(p)}
            by_prompt.setdefault(sc['prompt'], sc)
    return by_prompt


def events(record: dict, stage: str, step: str, phase: str) -> list[dict]:
    return [e for e in record['events'] if e['stage'] == stage and e['step'] == step and e['phase'] == phase]


def last(record: dict, stage: str, step: str, phase: str) -> dict:
    ev = events(record, stage, step, phase)
    return ev[-1]['data'] if ev else {}


def list_credits(sources: list[str]) -> Counter:
    """How many times each ranked list credited one citation."""
    n = Counter()
    for s in sources or []:
        m = SOURCE_RE.match(s)
        if m:
            n[m.group('list')] += 1
    return n


def keyword_of(list_label: str) -> str:
    kind, _, kw = list_label.partition(':')
    return kw.split('@', 1)[0] if kind != 'ckv' else ''


def analyze(record: dict, sc: dict) -> dict:
    exp = sc['expected_citations']
    row: dict = {'name': Path(sc['_path']).stem, 'scenario': sc['_path'], 'seq': record['seq'],
                 'expected_intent': sc.get('expected_intent'), 'flags': [], 'ranks': {}}
    flags = row['flags']

    # Intent.
    cls = last(record, 'intent', 'classify', 'after')
    override = last(record, 'intent', 'caller_override', 'note')
    row['intent'] = override.get('intent') if override else cls.get('intent', '')
    if cls:
        row['intent_confidence'] = cls.get('confidence')
        row['nearest_intent'] = cls.get('nearest_intent')
        order = [s['intent'] for s in cls.get('scores') or []]
        exp_intent = sc.get('expected_intent')
        row['expected_intent_rank'] = order.index(exp_intent) + 1 if exp_intent in order else 0
    if sc.get('expected_intent') and row['intent'] != sc['expected_intent']:
        flags.append('intent_wrong')
        if cls.get('below_threshold') and cls.get('nearest_intent') == sc['expected_intent']:
            flags.append('intent_threshold')

    # Ranks at each checkpoint.
    for e in events(record, 'stage1', 'ckv_search', 'after'):
        row['ranks'][f"ckv_round{e['key']}"] = rank(exp, e['data'].get('hits'))
    row['ranks']['stage1'] = rank(exp, last(record, 'stage1', 'keyword_cap', 'after').get('hits'))
    fused = last(record, 'stage2', 'rank_citations', 'before').get('citations') or []
    final = last(record, 'stage2', 'rank_citations', 'after').get('citations') or []
    neighbors = last(record, 'stage3', 'expand', 'after').get('neighbors') or []
    decisions = last(record, 'stage4', 'allocate', 'after').get('decisions') or []
    selected = [d for d in decisions if d['decision'].startswith('selected')]
    row['ranks']['fused'] = rank(exp, fused)
    row['ranks']['stage2'] = rank(exp, final)
    row['ranks']['stage3'] = rank(exp, final + neighbors)
    row['ranks']['stage4'] = rank(exp, selected)

    order = [k for k in row['ranks'] if k.startswith('ckv_round')][:1] + list(CHECKPOINTS)
    row['lost_rank1_at'] = row['lost_found_at'] = None
    for prev, cur in zip(order, order[1:]):
        if row['lost_rank1_at'] is None and row['ranks'][prev] == 1 and row['ranks'][cur] != 1:
            row['lost_rank1_at'] = f'{prev}->{cur}'
        if row['lost_found_at'] is None and row['ranks'][prev] > 0 and row['ranks'][cur] == 0:
            row['lost_found_at'] = f'{prev}->{cur}'

    # Stage 2 fusion shapes.
    origins = {}
    for e in events(record, 'stage1', 'extract_keywords', 'after'):
        for c in e['data'].get('candidates') or []:
            origins.setdefault(c['keyword'], c['origin'])
    max_dup = 0
    for c in fused:
        dup = max(list_credits(c.get('sources')).values(), default=0)
        max_dup = max(max_dup, dup)
    if max_dup > 1:
        flags.append('list_duplicate_credit')
    row['max_list_credits'] = max_dup
    if final:
        top = final[0]
        credits = list_credits(top.get('sources'))
        top_is_answer = rank(exp, [top]) == 1
        row['top1'] = {'file': top['file'], 'start': top['start'], 'score': top['score'], 'answer': top_is_answer}
        if max(credits.values(), default=0) > 1:
            flags.append('duplicate_credit_top1')
        if not any(lbl.startswith('ckv:') for lbl in credits):
            flags.append('keyword_only_top1')
        kws = {keyword_of(lbl) for lbl in credits} - {''}
        if not top_is_answer and kws and all(origins.get(k) in HIT_ORIGINS for k in kws):
            flags.append('hit_keyword_promoted_top1')
        if len(final) > 1 and final[1]['score'] > 0 and top['score'] > 2 * final[1]['score']:
            flags.append('score_outlier_top1')
    if 0 < row['ranks']['fused'] < row['ranks']['stage2'] or (row['ranks']['fused'] and not row['ranks']['stage2']):
        flags.append('answer_demoted')

    # Symbol resolution.
    fanout = []
    for e in events(record, 'ckgclient', 'resolve_symbol', 'after'):
        att = e['data'].get('attempts') or []
        if '.' in e['key'] and att and att[-1]['via'] == 'symbol_drop_leading' and att[-1]['nodes'] > 1:
            fanout.append({'name': e['key'], 'resolved_as': att[-1]['name'], 'nodes': att[-1]['nodes']})
    if fanout:
        flags.append('symbol_fanout')
    row['symbol_fanout'] = fanout

    # Stage 4 outcome of the answer.
    for d in decisions:
        if rank(exp, [d]) == 1:
            row['answer_stage4_decision'] = d['decision']
            if not d['decision'].startswith('selected'):
                flags.append('answer_cut_stage4')
            break
    return row


def metrics(rows: list[dict], key: str) -> dict:
    rk = [r['ranks'].get(key, 0) for r in rows]
    n = len(rk) or 1
    return {'hit@1': round(sum(x == 1 for x in rk) / n, 3), 'hit@3': round(sum(1 <= x <= 3 for x in rk) / n, 3),
            'found': round(sum(x > 0 for x in rk) / n, 3), 'mrr': round(sum(1 / x for x in rk if x) / n, 3)}


def summarize(rows: list[dict]) -> dict:
    keys = sorted({k for r in rows for k in r['ranks'] if k.startswith('ckv_round')}) + list(CHECKPOINTS)
    return {
        'scenarios': len(rows),
        'checkpoints': {k: metrics(rows, k) for k in keys},
        'lost_rank1_at': dict(Counter(r['lost_rank1_at'] for r in rows if r['lost_rank1_at']).most_common()),
        'lost_found_at': dict(Counter(r['lost_found_at'] for r in rows if r['lost_found_at']).most_common()),
        'flags': {f: sum(f in r['flags'] for r in rows) for f in FLAGS},
        'answer_stage4_decision': dict(Counter(r.get('answer_stage4_decision', 'not_reached') for r in rows)),
        'intent': {'correct': sum('intent_wrong' not in r['flags'] for r in rows),
                   'classified_as': dict(Counter(r['intent'] or 'unknown' for r in rows))},
    }


def build_report(trace_paths: list[Path], scenario_dirs: list[Path], all_calls: bool = False) -> dict:
    scenarios = load_scenarios(scenario_dirs)
    rows, unmatched, seen = [], 0, set()
    for path in trace_paths:
        for line in path.read_text().splitlines():
            record = json.loads(line)
            sc = scenarios.get(record['prompt'])
            if sc is None:
                unmatched += 1
                continue
            if not all_calls and sc['_path'] in seen:
                continue  # first compose call per scenario, like cks eval's recorded response
            seen.add(sc['_path'])
            rows.append({**analyze(record, sc), 'trace': str(path)})
    return {'flag_definitions': FLAGS, 'summary': summarize(rows), 'unmatched_records': unmatched, 'scenarios': rows}


def main() -> None:
    a = argparse.ArgumentParser(description=__doc__.split('\n', 1)[0])
    a.add_argument('--trace', action='append', required=True, type=Path)
    a.add_argument('--scenarios', action='append', required=True, type=Path)
    a.add_argument('--out', type=Path)
    a.add_argument('--all-calls', action='store_true', help='analyze every compose call, not only the first per scenario')
    args = a.parse_args()
    report = build_report(args.trace, args.scenarios, args.all_calls)
    if args.out:
        args.out.write_text(json.dumps(report, ensure_ascii=False, indent=1))
    print(json.dumps(report['summary'], ensure_ascii=False, indent=1))


if __name__ == '__main__':
    main()
"""Locate answer losses and failure shapes from a synthetic CKS debug trace."""
import json
import tempfile
import unittest
from pathlib import Path

import retrieval_debug_trace_report as x


def ev(stage, step, phase, data, key=''):
    return {'stage': stage, 'step': step, 'phase': phase, 'key': key, 'data': data}


def c(file, start=1, end=10, score=0.0, sources=None):
    return {'file': file, 'start': start, 'end': end, 'score': score, 'sources': sources or []}


ANSWER = c('answer.go', 1, 10)
WRONG = c('iface.go', 100, 110)

# The answer is ckv rank 1; a hit-derived keyword's FindSymbol list credits a
# wrong span three times and it takes the Stage 2 top; Stage 4 drops the answer.
RECORD = {'seq': 1, 'prompt': 'p1', 'events': [
    ev('intent', 'classify', 'after', {'intent': '', 'confidence': 0.4, 'nearest_intent': 'bug_fix',
                                       'below_threshold': True, 'scores': [{'intent': 'bug_fix'}, {'intent': 'refactor'}]}),
    ev('stage1', 'ckv_search', 'after', {'hits': [ANSWER, WRONG]}, '1'),
    ev('stage1', 'extract_keywords', 'after', {'candidates': [{'keyword': 'T.Remove', 'origin': 'hit_symbol'}]}, '1'),
    ev('stage1', 'keyword_cap', 'after', {'hits': [ANSWER, WRONG]}),
    ev('stage2', 'rank_citations', 'before', {'citations': [
        c('iface.go', 100, 110, 0.07, ['symbol:T.Remove@rank=1(+0.02459)', 'symbol:T.Remove@rank=2(+0.02419)',
                                       'symbol:T.Remove@rank=3(+0.02381)']),
        c('answer.go', 1, 10, 0.08, ['ckv:semantic@rank=1(+0.08197)'])]}),
    ev('stage2', 'rank_citations', 'after', {'citations': [
        c('iface.go', 100, 110, 0.20, ['symbol:T.Remove@rank=1(+0.02459)', 'symbol:T.Remove@rank=2(+0.02419)',
                                       'symbol:T.Remove@rank=3(+0.02381)']),
        c('answer.go', 1, 10, 0.08, ['ckv:semantic@rank=1(+0.08197)'])]}),
    ev('ckgclient', 'resolve_symbol', 'after', {'attempts': [
        {'name': 'T.Remove', 'via': 'symbol', 'nodes': 0},
        {'name': 'Remove', 'via': 'symbol_drop_leading', 'nodes': 30}]}, 'T.Remove'),
    ev('stage3', 'expand', 'after', {'neighbors': []}),
    ev('stage4', 'allocate', 'after', {'decisions': [
        {'file': 'iface.go', 'start': 100, 'end': 110, 'origin': 'seed', 'score': 0.2, 'decision': 'selected'},
        {'file': 'answer.go', 'start': 1, 'end': 10, 'origin': 'seed', 'score': 0.08, 'decision': 'seed_quota'}]}),
]}

SCENARIO = {'prompt': 'p1', 'expected_intent': 'bug_fix',
            'expected_citations': [{'file': 'answer.go', 'start_line': 1, 'end_line': 10}], '_path': 's/pr-1.yaml'}


class Analyze(unittest.TestCase):
    def setUp(self):
        self.row = x.analyze(RECORD, SCENARIO)

    def test_ranks_and_loss_point(self):
        self.assertEqual(self.row['ranks'], {'ckv_round1': 1, 'stage1': 1, 'fused': 2, 'stage2': 2,
                                             'stage3': 2, 'stage4': 0})
        self.assertEqual(self.row['lost_rank1_at'], 'stage1->fused')
        self.assertEqual(self.row['lost_found_at'], 'stage3->stage4')

    def test_flags(self):
        for flag in ('intent_wrong', 'intent_threshold', 'list_duplicate_credit', 'duplicate_credit_top1',
                     'symbol_fanout', 'keyword_only_top1', 'hit_keyword_promoted_top1', 'score_outlier_top1',
                     'answer_cut_stage4'):
            with self.subTest(flag=flag):
                self.assertIn(flag, self.row['flags'])
        self.assertNotIn('answer_demoted', self.row['flags'])
        self.assertEqual(self.row['max_list_credits'], 3)
        self.assertEqual(self.row['answer_stage4_decision'], 'seed_quota')
        self.assertEqual(self.row['expected_intent_rank'], 1)

    def test_build_report_matches_prompt_and_keeps_first_call(self):
        with tempfile.TemporaryDirectory() as d:
            d = Path(d)
            (d / 'sc').mkdir()
            (d / 'sc' / 'pr-1.yaml').write_text(json.dumps({k: v for k, v in SCENARIO.items() if k != '_path'}))
            trace = d / 'trace.jsonl'
            other = {**RECORD, 'seq': 3, 'prompt': 'unknown prompt'}
            trace.write_text('\n'.join(json.dumps(r) for r in (RECORD, {**RECORD, 'seq': 2}, other)) + '\n')
            rep = x.build_report([trace], [d / 'sc'])
            self.assertEqual((rep['summary']['scenarios'], rep['unmatched_records']), (1, 1))
            self.assertEqual(rep['scenarios'][0]['seq'], 1)
            self.assertEqual(rep['summary']['lost_rank1_at'], {'stage1->fused': 1})
            self.assertEqual(len(x.build_report([trace], [d / 'sc'], all_calls=True)['scenarios']), 2)


if __name__ == '__main__':
    unittest.main()
