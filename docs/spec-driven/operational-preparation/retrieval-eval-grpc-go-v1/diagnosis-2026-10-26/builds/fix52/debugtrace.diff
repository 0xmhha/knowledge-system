func TestRerankScored_ReportsDropReasons(t *testing.T) {
	t.Parallel()
	ckg := &rerankFake{hitsByKW: map[string][]contract.Hit{
		"CksMCP": {hitScore(1.0)},
		"cksMCP": {hitScore(1.0)},
