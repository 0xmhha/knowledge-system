                  "text": "func waitForReady(cc *grpc.ClientConn) error {\n\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n\tdefer cancel()\n\tfor {\n\t\ts := cc.GetState()\n\t\tif s == connectivity.Ready {\n\t\t\treturn nil\n\t\t}\n\t\tif !cc.WaitForStateChange(ctx, s) {\n\t\t\t// ctx got timeout or canceled.\n\t\t\treturn ctx.Err()\n\t\t}\n\t}\n}",
                  "token_estimate": 78
                },
