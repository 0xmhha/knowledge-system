// Owned in-process RPC observations. Candidate and backend assumptions remain
// explicit; no network listener, Ethereum factory or operational node is used.
package downloader

import (
	"context"
	"encoding/json"
	"errors"
	"os"
	"runtime"
	"strings"
	"sync"
	"testing"
	"time"

	"github.com/ethereum/go-ethereum/event"
	"github.com/ethereum/go-ethereum/rpc"
)

type ticketRecorder struct {
	mu             sync.Mutex
	file           *os.File
	start          time.Time
	seq            int
	id, role, path string
}

func (r *ticketRecorder) emit(name string, d map[string]interface{}) {
	r.mu.Lock()
	defer r.mu.Unlock()
	if d == nil {
		d = map[string]interface{}{}
	}
	r.seq++
	d["event"] = name
	d["case_id"] = r.id
	d["candidate"] = r.role
	d["sequence"] = r.seq
	d["elapsed_ns"] = time.Since(r.start).Nanoseconds()
	if err := json.NewEncoder(r.file).Encode(d); err != nil {
		panic(err)
	}
}
func ticketStacks() string {
	b := make([]byte, 2<<20)
	n := runtime.Stack(b, true)
	return string(b[:n])
}
func ticketFrames(method string) int {
	n := 0
	for _, g := range strings.Split(ticketStacks(), "\n\n") {
		if strings.Contains(g, method) && strings.Contains(g, "/eth/downloader/api.go:") {
			n++
		}
	}
	return n
}
func ticketUntil(t *testing.T, predicate func() bool) {
	t.Helper()
	end := time.Now().Add(2 * time.Second)
	for time.Now().Before(end) {
		if predicate() {
			return
		}
		time.Sleep(time.Millisecond)
	}
	t.Fatal("actual callback/loop precondition unproved")
}
func (r *ticketRecorder) snapshot(t *testing.T, label string) {
	t.Helper()
	if err := os.WriteFile(r.path+"."+label+".stack", []byte(ticketStacks()), 0600); err != nil {
		t.Fatal(err)
	}
}

func TestTicketOwnedRPC(t *testing.T) {
	role, id, path := os.Getenv("TICKET_ROLE"), os.Getenv("TICKET_CASE"), os.Getenv("TICKET_TRACE_PATH")
	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
	if err != nil {
		t.Fatal(err)
	}
	r := &ticketRecorder{file: f, start: time.Now(), id: id, role: role, path: path}
	t.Cleanup(func() {
		r.emit("trace_end", map[string]interface{}{"test_failed": t.Failed()})
		if err := f.Close(); err != nil {
			t.Error(err)
		}
	})
	r.emit("trace_begin", map[string]interface{}{"base_commit": "0bf2f4d1bfeb6605006d556957ef8c045d8f8ed8", "transport": "rpc.DialInProc_net.Pipe", "step_watchdog_ms": 2000, "opened_listener": false, "Ethereum_factory_started": false})
	live := id == "RPC-live-normal"
	mux := new(event.TypeMux)
	var api *DownloaderAPI
	if live {
		api = NewDownloaderAPI(nil, nil, mux)
	} else {
		api = &DownloaderAPI{installSyncSubscription: make(chan chan interface{}), uninstallSyncSubscription: make(chan *uninstallSyncSubscriptionRequest)}
	}
	server := rpc.NewServer()
	if err := server.RegisterName("eth", api); err != nil {
		t.Fatal(err)
	}
	client, foreign := rpc.DialInProc(server), rpc.DialInProc(server)
	var statuses chan interface{}
	var request *uninstallSyncSubscriptionRequest
	senderDone := make(chan struct{})
	senderStarted := false
	acked := make(map[*uninstallSyncSubscriptionRequest]bool)
	ack := func(req *uninstallSyncSubscriptionRequest) {
		if !acked[req] {
			close(req.uninstalled)
			acked[req] = true
			r.emit("controlled_ack_closed", map[string]interface{}{"same_status_channel": req.c == statuses})
		}
	}
	t.Cleanup(func() {
		r.emit("cleanup_begin", nil)
		client.Close()
		foreign.Close()
		server.Stop()
		if request != nil {
			ack(request)
		}
		if !live {
			end := time.Now().Add(2 * time.Second)
			for {
				senderJoined := !senderStarted
				if senderStarted {
					select {
					case <-senderDone:
						senderJoined = true
					default:
					}
				}
				if ticketFrames("(*DownloaderAPI).Syncing.func1") == 0 && senderJoined {
					break
				}
				if time.Now().After(end) {
					t.Fatal("owned callback/sender cleanup not proved")
				}
				select {
				case c := <-api.installSyncSubscription:
					statuses = c
				case req := <-api.uninstallSyncSubscription:
					if statuses != nil && req.c != statuses {
						t.Fatal("foreign cleanup request channel")
					}
					ack(req)
				case <-statuses:
				default:
					time.Sleep(time.Millisecond)
				}
			}
		}
		ticketUntil(t, func() bool { return ticketFrames("(*DownloaderAPI).Syncing.func1") == 0 })
		mux.Stop()
		ticketUntil(t, func() bool { return ticketFrames("(*DownloaderAPI).eventLoop") == 0 })
		// ServeCodec runs in an owned goroutine created by DialInProc. Both
		// clients are closed and the server stopped before checking its exit.
		ticketUntil(t, func() bool { return !strings.Contains(ticketStacks(), "(*Server).ServeCodec") })
		r.emit("cleanup_end", map[string]interface{}{"joined": true, "remaining_callbacks": ticketFrames("(*DownloaderAPI).Syncing.func1"), "remaining_event_loops": ticketFrames("(*DownloaderAPI).eventLoop")})
	})
	if _, err := api.Syncing(context.Background()); !errors.Is(err, rpc.ErrNotificationsUnsupported) {
		t.Fatal("direct missing-notifier control differs")
	}
	r.emit("unsupported_notifier_control", map[string]interface{}{"typed_error": true, "RPC_request": false})
	call := func(c *rpc.Client, result interface{}, method string, args ...interface{}) error {
		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
		defer cancel()
		return c.CallContext(ctx, result, method, args...)
	}
	var unknown rpc.ID
	if err := call(client, &unknown, "eth_subscribe", "ticket_no_such_subscription"); err == nil || unknown != "" {
		t.Fatal("unknown subscription control accepted")
	}
	r.emit("unknown_subscription_control", map[string]interface{}{"error": true})
	var sid rpc.ID
	if err := call(client, &sid, "eth_subscribe", "syncing"); err != nil || sid == "" {
		t.Fatalf("actual subscribe failed: %v", err)
	}
	backendKind := "actual_eventLoop"
	if !live {
		backendKind = "controlled_backend"
	}
	r.emit("actual_RPC_subscribed", map[string]interface{}{"subscription_id": sid, "namespace": "eth", "subscription": "syncing", "backend": backendKind})
	if !live {
		select {
		case statuses = <-api.installSyncSubscription:
		case <-time.After(2 * time.Second):
			t.Fatal("actual callback install missing")
		}
		r.emit("controlled_backend_install", map[string]interface{}{"status_capacity": cap(statuses)})
	}
	ticketUntil(t, func() bool {
		return ticketFrames("(*DownloaderAPI).Syncing.func1") == 1 && !strings.Contains(ticketStacks(), "(*DownloaderAPI).SubscribeSyncStatus")
	})
	r.snapshot(t, "callback-installed")
	r.emit("actual_callback_installed", map[string]interface{}{"callback_count": 1, "live_eventLoop": live, "progress_notification_exercised": false})
	var wrong bool
	if err := call(foreign, &wrong, "eth_unsubscribe", sid); err == nil || err.Error() != rpc.ErrSubscriptionNotFound.Error() || wrong {
		t.Fatal("foreign RPC session accepted known id")
	}
	r.emit("foreign_session_control", map[string]interface{}{"same_id": sid, "subscription_not_found": true})
	var ok bool
	if err := call(client, &ok, "eth_unsubscribe", sid); err != nil || !ok {
		t.Fatalf("actual unsubscribe response: %v", err)
	}
	r.emit("actual_RPC_unsubscribe_true", map[string]interface{}{"subscription_id": sid, "same_session": true})
	var again bool
	if err := call(client, &again, "eth_unsubscribe", sid); err == nil || err.Error() != rpc.ErrSubscriptionNotFound.Error() || again {
		t.Fatal("repeated unsubscribe still present in server registry")
	}
	r.emit("repeat_unsubscribe_control", map[string]interface{}{"same_id": sid, "subscription_not_found": true})
	if live {
		ticketUntil(t, func() bool { return ticketFrames("(*DownloaderAPI).Syncing.func1") == 0 })
		r.emit("observation_frozen", map[string]interface{}{"route": "actual_eventLoop", "callback_returned": true, "backend_membership_proved": false, "native_progress_timer_fired": false})
		return
	}
	if id == "RPC-ack-held" {
		if role == "MUT-EARLY" {
			r.emit("no_request_window_begin", nil)
			select {
			case request = <-api.uninstallSyncSubscription:
				t.Fatal("early mutant unexpectedly requested uninstall")
			case <-time.After(2 * time.Second):
			}
			ticketUntil(t, func() bool { return ticketFrames("(*DownloaderAPI).Syncing.func1") == 0 })
			r.snapshot(t, "observation")
			r.emit("observation_frozen", map[string]interface{}{"route": "controlled_backend", "request_received": false, "callback_returned": true, "observation_ms": 2000, "backend_membership_proved": false})
		} else {
			select {
			case request = <-api.uninstallSyncSubscription:
			case <-time.After(2 * time.Second):
				t.Fatal("actual deferred method request missing")
			}
			if request.c != statuses {
				t.Fatal("actual uninstall uses foreign status channel")
			}
			r.emit("actual_backend_request_received", map[string]interface{}{"same_status_channel": true, "ack_closed": false})
			ticketUntil(t, func() bool { return ticketFrames("(*SyncStatusSubscription).Unsubscribe") == 1 })
			r.snapshot(t, "before-observation")
			r.emit("ack_withheld_window_begin", nil)
			time.Sleep(2 * time.Second)
			if ticketFrames("(*SyncStatusSubscription).Unsubscribe") != 1 {
				t.Fatal("actual deferred method returned before held ack")
			}
			r.snapshot(t, "observation")
			r.emit("observation_frozen", map[string]interface{}{"route": "controlled_backend", "request_received": true, "callback_returned": false, "observation_ms": 2000, "backend_membership_proved": false})
		}
	} else if id == "RPC-status-before-request" {
		if role == "MUT-EARLY" {
			ticketUntil(t, func() bool { return ticketFrames("(*DownloaderAPI).Syncing.func1") == 0 })
		} else {
			ticketUntil(t, func() bool { return ticketFrames("(*SyncStatusSubscription).Unsubscribe") == 1 })
		}
		senderStarted = true
		go func() { statuses <- false; r.emit("owned_status_sender_returned", nil); close(senderDone) }()
		r.emit("status_without_backend_receiver_window_begin", nil)
		time.Sleep(2 * time.Second)
		drained := false
		select {
		case <-senderDone:
			drained = true
		default:
		}
		if drained != (role == "CAND-A" || role == "CAND-B") {
			t.Fatal("unmodelled status-before-request source result")
		}
		r.snapshot(t, "observation")
		r.emit("observation_frozen", map[string]interface{}{"route": "controlled_backend", "status_drained_before_request_receive": drained, "callback_returned": ticketFrames("(*DownloaderAPI).Syncing.func1") == 0, "observation_ms": 2000, "backend_membership_proved": false})
	} else {
		t.Fatal("case outside predeclared plan")
	}
}
