# Build artifacts
bin/

# OS noise
.DS_Store

# Editor/session local state
*.log

# Accidentally-built binaries at the repo root (cmd names). NOTE: /graph and
# /vector are NOT listed — those patterns would also ignore the engine
# directories; build with -o bin/ instead.
/knowledge-setup
/system-mcp
/graph-mcp
/vector-mcp

# Derived pack outputs (domain-export corpus, generated filelists)
projects/*/generated/

# Machine-local runtime configs (system-mcp gen-config output — absolute
# paths and listen addresses; never commit)
run/

# Instantiated pack server configs carry deployment endpoints (ip:port) —
# only the .example templates are tracked.
projects/*/mcp.yaml
