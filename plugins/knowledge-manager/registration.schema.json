{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge manager owned registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registration", "checksum"],
  "properties": {
    "checksum": {"$ref": "#/$defs/hash"},
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "profile_id", "source_root", "dataset_root", "state_root", "token", "files", "binaries"],
      "properties": {
        "schema_version": {"const": 1, "type": "integer"},
        "project_id": {"$ref": "#/$defs/id"},
        "profile_id": {"$ref": "#/$defs/id"},
        "source_root": {"$ref": "#/$defs/path"},
        "dataset_root": {"$ref": "#/$defs/path"},
        "state_root": {"$ref": "#/$defs/path"},
        "token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "files": {
          "type": "object", "additionalProperties": false,
          "required": ["setup.json", "cks.json", "sanitization_rules.yaml"],
          "properties": {
            "setup.json": {"$ref": "#/$defs/hash"},
            "cks.json": {"$ref": "#/$defs/hash"},
            "sanitization_rules.yaml": {"$ref": "#/$defs/hash"}
          }
        },
        "binaries": {
          "type": "object", "additionalProperties": false, "required": ["cks", "graph", "vector"],
          "properties": {
            "cks": {"$ref": "#/$defs/executable"},
            "graph": {"$ref": "#/$defs/executable"},
            "vector": {"$ref": "#/$defs/executable"}
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"},
    "path": {"type": "string", "pattern": "^/", "minLength": 1},
    "executable": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}
    }
  }
}
