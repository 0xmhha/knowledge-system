+  value=report('comparison'if phase=='evaluation'else'reproduction',verdict)
+  identity={'binary':'/trusted/chainbench','binary_sha256':'a'*64,'source_commit':'b'*40}
+  input_value={'plan':value['plan']}
+  input_raw=timing.encode(input_value);plan={'schema_version':1,'ticket_id':'fixture','phase':phase,'generation':1,'runner_sha256':timing.RUNNER_SHA256,'provider':identity,'working_directory':str(self.workspace),'input_sha256':timing.sha(input_raw),'input':input_value,'acceptance':'not_recorded'}
+  files['input'].write_bytes(input_raw);files['plan'].write_bytes(timing.encode(plan));stdout=timing.encode(value);files['report'].write_bytes(stdout);files['stdout'].write_bytes(stdout);files['stderr'].write_bytes(b'')
+  receipt={'schema_version':1,'ticket_id':'fixture','phase':phase,'provider':identity,'plan_sha256':timing.sha(files['plan'].read_bytes()),'input_sha256':plan['input_sha256'],'command':[identity['binary'],'experiment','--input',str(files['input'].resolve())],'cwd':str(self.workspace),'exit_code':1 if verdict=='ERROR'else 0,'stdout_sha256':timing.sha(stdout),'stderr_sha256':timing.sha(b'')};files['receipt'].write_bytes(timing.encode(receipt))
+  native=b'PASS: receipts and accounting; independent acceptance not recorded\n'
+  result={'schema_version':1,'ticket_id':'fixture','phase':phase,'provider':identity,'plan_sha256':timing.sha(files['plan'].read_bytes()),'report_sha256':timing.sha(stdout),'receipt_sha256':timing.sha(files['receipt'].read_bytes()),'branches':timing.branches(value),'verdict':verdict,'resume_requested':value['resume_requested'],'native_verifier_stdout_sha256':timing.sha(native),'acceptance':'not_recorded'};files['result'].write_bytes(timing.encode(result))
+  self.state['states'][phase.upper()].update({'timing_plan_sha256':timing.sha(files['plan'].read_bytes()),'timing_result_sha256':timing.sha(files['result'].read_bytes())});(self.workspace/'state.json').write_bytes(timing.encode(self.state))
+  return files,value
