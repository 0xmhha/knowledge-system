+#!/usr/bin/env python3
+"""Opt-in real public composition + timing consumer, never production acceptance."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+SCRIPTS=Path(__file__).resolve().parents[2]/'plugin/scripts';sys.path.insert(0,str(SCRIPTS))
+import timing_investigation as timing
+
+def run(args,cwd):
+ return subprocess.run(args,cwd=cwd,capture_output=True,check=True).stdout.decode().strip()
+def main():
+ parser=argparse.ArgumentParser();parser.add_argument('--chainbench',type=Path,required=True);parser.add_argument('--output',type=Path,required=True);args=parser.parse_args()
+ require=lambda value,message:timing.require(value,message)
+ require(not args.output.exists(),'new output directory required');root=args.output.resolve();root.mkdir(parents=True)
+ source=root/'source';source.mkdir();(source/'go.mod').write_text('module example.invalid/owned-timing-fixture\n\ngo 1.26.9\n')
+ original=Path(__file__).with_name('node.go.txt').read_text();(source/'main.go').write_text(original)
+ run(['git','init','-q'],source);run(['git','config','commit.gpgsign','false'],source)
+ def commit(subject):
+  run(['git','add','go.mod','main.go'],source);run(['git','-c','user.name=Owned timing fixture','-c','user.email=fixture@example.invalid','commit','-qm',subject],source);return run(['git','rev-parse','HEAD'],source)
+ before=commit('test: expose reads before the concurrent commit');before_bin=root/'before';run(['go','build','-buildvcs=true','-o',str(before_bin),'.'],source)
+ (source/'main.go').write_text(original.replace('const fixed = false','const fixed = true'));after=commit('fix: wait for the committed value');after_bin=root/'after';run(['go','build','-buildvcs=true','-o',str(after_bin),'.'],source)
+ run(['git','bundle','create',str(root/'fixture.bundle'),'HEAD'],source)
+ for name,ref in [('before',before),('after',after)]:
+  (root/(name+'.commit.txt')).write_text(run(['git','cat-file','commit',ref],source));(root/(name+'.buildinfo.txt')).write_text(run(['go','version','-m',str(root/name)],source))
+ case={'schemaVersion':'1','id':'owned-timing','chain':{'name':'stablenet','binary':'pinned'},'topology':{'bp':1},'steps':[{'read':{'source':'balanceAt','on':'node1','address':'0x0000000000000000000000000000000000000001'}},{'read':{'source':'chainId','on':'node1'}}],'assertions':[{'assert':'balanceAt','on':'node1','address':'0x0000000000000000000000000000000000000002','compare':'Equal','expected':'1'},{'assert':'chainId','on':'node1','compare':'Equal','expected':'8283'}]}
+ workspace=root/'.coding-agent/tickets/timing';workspace.mkdir(parents=True)
+ state={'ticket_id':'timing','ticket_type':'bugfix','current_state':'ANALYSIS','states':{'ANALYSIS':{'investigation_kind':'timing','status':'in_progress'},'EVALUATION':{'cycle':1}}};state_path=workspace/'state.json';state_path.write_bytes(timing.encode(state))
+ base={'schema_version':1,'id':'owned-timing','mode':'reproduction','symptom':'controlled concurrent read before commit; no consensus claim','assertion_id':'owned-timing/assert/0','seed':'owned-paired-v1','before':{'commit':before},'after':None,'repetitions':60,'min_completed':60,'min_symptom_failures':3,'max_failure_rate':.05,'trial_timeout_seconds':30,'total_timeout_seconds':600,'owned_node_ids':['node1'],'normal_assertion_ids':['owned-timing/assert/1'],'injection':{'kind':'delay','target':'node1','step':'owned-timing/step/1','min_delay_ms':0,'max_delay_ms':3},'resume':None}
+ summaries=[]
+ for phase in ['analysis','evaluation']:
+  print('starting '+phase+' owned native trials',flush=True)
+  plan=json.loads(json.dumps(base))
+  if phase=='evaluation':plan['mode']='comparison';plan['after']={'commit':after};state['current_state']='EVALUATION'
+  state_path.write_bytes(timing.encode(state))
+  # The existing composition layout contains node IPC paths; keep its root short.
+  directory=Path(tempfile.mkdtemp(prefix='w4t-',dir='/tmp'));directory.rmdir()
+  proposal={'plan':plan,'case':case,'binary_by_commit':{before:str(before_bin),after:str(after_bin)},'artifact_root':str(directory)}
+  input_path=root/(phase+'-proposal.json');input_path.write_bytes(timing.encode(proposal))
+  plan_sha=timing.freeze(workspace,phase,'timing',input_path,args.chainbench)
+  state['states'].setdefault(phase.upper(),{}).update({'timing_plan_sha256':plan_sha});state_path.write_bytes(timing.encode(state))
+  result=timing.execute(workspace,phase);files=timing.paths(workspace,phase)
+  state['states'][phase.upper()]['timing_result_sha256']=timing.sha(files['result'].read_bytes());state_path.write_bytes(timing.encode(state))
+  _,report,_=timing.verify_artifact(workspace,phase)
+  require(all(t['cleanup_ok']for t in report['trials']),'owned cleanup unresolved')
+  expected='REPRODUCED'if phase=='analysis'else'OBSERVED_RATE_BOUND_MET';require(result['verdict']==expected,'native timing result did not meet frozen conditions: '+result['verdict'])
+  timing.state_check(workspace,state,phase)
+  summaries.append({'phase':phase,'verdict':result['verdict'],'before':report['before'],'after':report.get('after'),'cleanup_ok':True,'acceptance':result['acceptance']})
+  print('verified '+phase+': '+result['verdict'],flush=True)
+ # These are actual before/after source coordinates, not a fabricated V1 PASS.
+ # The full oracle gate is intentionally not bypassed or claimed complete.
+ (workspace/'oracle-validity-report.json').write_bytes(timing.encode({'base_commit':before,'head_commit':after,'mechanical_verdict':'NOT_EXECUTED'}))
+ timing.state_check(workspace,state,'evaluation',True)
+ (root/'summary.json').write_bytes(timing.encode({'schema_version':1,'scope':'actual owned Go RPC fixture with public composition and consumer; not blockchain consensus or full oracle acceptance','before_commit':before,'after_commit':after,'phases':summaries,'full_oracle_acceptance':'not_recorded','fixture_bundle_sha256':timing.sha((root/'fixture.bundle').read_bytes())}))
+ print(json.dumps({'output':str(root),'timing_phases_verified':len(summaries),'whole_completion':'not_recorded'}),flush=True)
+if __name__=='__main__':main()
