+   return timing.verify_artifact(self.workspace,phase)
+ def test_verified_provider_decisions_do_not_grant_acceptance(self):
+  self.fixture();result,_,_=self.checked();self.assertEqual(result['acceptance'],'not_recorded');self.assertEqual(result['branches']['normal']['status'],'PASS')
+ def test_infrastructure_and_small_samples_remain_unconfirmed(self):
+  for v in ['ERROR','INCONCLUSIVE','AWAITING_OBSERVATION','RATE_BOUND_NOT_MET']:
+   with self.subTest(v=v):
