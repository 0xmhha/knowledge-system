+
+const timingNodeSource = `package main
+import("encoding/json";"fmt";"net";"net/http";"os";"os/signal";"sync";"sync/atomic";"syscall";"time")
+const waitForCommit = false
+func main(){
+ var once sync.Once;var ready atomic.Bool;done:=make(chan struct{})
+ l,e:=net.Listen("tcp","127.0.0.1:0");if e!=nil{panic(e)}
+ h:=http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){
+  var q struct{ID any;Method string};if e:=json.NewDecoder(r.Body).Decode(&q);e!=nil{http.Error(w,"bad request",400);return}
+  value:="0x1"
+  switch q.Method{case "eth_blockNumber":once.Do(func(){go func(){time.Sleep(25*time.Millisecond);ready.Store(true);close(done)}()});value="0x0"
+  case "eth_getBalance":if waitForCommit{select{case <-done:case <-r.Context().Done():return}};if !ready.Load(){value="0x0"}}
+  json.NewEncoder(w).Encode(map[string]any{"jsonrpc":"2.0","id":q.ID,"result":value})
+ })
+ srv:=&http.Server{Handler:h};go srv.Serve(l);fmt.Println("http://"+l.Addr().String())
+ stop:=make(chan os.Signal,1);signal.Notify(stop,syscall.SIGTERM,syscall.SIGINT);<-stop;srv.Close()
+}
+`
+const timingDSL = `{"schemaVersion":"1","id":"timing","chain":{"name":"owned-fixture","binary":"pinned"},"steps":[{"read":{"source":"blockNumber","on":"node1"}},{"read":{"source":"chainId","on":"node1"}}],"assertions":[{"assert":"balanceAt","address":"0x0000000000000000000000000000000000000001","on":"node1","expected":"1"},{"assert":"chainId","on":"node1","expected":"1"}]}`
+
+func hashBytes(raw []byte) string { sum := sha256.Sum256(raw); return hex.EncodeToString(sum[:]) }
+func TestObservationDSLCannotWriteOrControlNodes(t *testing.T) {
+	valid := dsl.Spec{ID: "probe", Assertions: []map[string]any{{"assert": "chainId", "expected": "1"}}}
+	if e := readOnlyCase(valid); e != nil {
+		t.Fatal(e)
+	}
+	for _, name := range []string{"sendTx", "stopNode", "restartNode", "partition", "load", "signAuthorization"} {
+		s := valid
+		s.Steps = []map[string]any{{name: map[string]any{}}}
+		if e := readOnlyCase(s); e == nil {
+			t.Fatal("write-capable observation", name)
+		}
+	}
+	s := valid
+	s.Assertions = []map[string]any{{"assert": "methodPresent", "method": "admin_addPeer"}}
+	if e := readOnlyCase(s); e == nil {
+		t.Fatal("arbitrary RPC observation allowed")
+	}
+	s = valid
+	s.PostActions = []map[string]any{{"stopNode": map[string]any{}}}
+	if e := readOnlyCase(s); e == nil {
+		t.Fatal("post-hook in read-only observation")
+	}
+}
+func TestDSLRefusesChangedDriverBeforeComposition(t *testing.T) {
+	opened := false
+	f := &DSLFactory{Case: []byte(timingDSL), OpenLease: func(context.Context, TrialRequest, string) (DSLLease, error) { opened = true; return nil, nil }}
+	p := frozenPlan()
+	if _, e := f.Open(context.Background(), TrialRequest{Source: p.Before}); e == nil || opened {
+		t.Fatal("unfrozen driver reached composition")
+	}
+}
+
+// This is an actual owned Go node process, real RPC, the existing registered
+// vocabulary and interpreter, and a source-dependent concurrent commit race.
+// It is deliberately separate from generic engine unit observations.
+func TestLiveDSLTimingComparison(t *testing.T) {
+	if os.Getenv("CHAINBENCH_EXPERIMENT_LIVE") != "1" {
+		t.Skip("explicit owned node integration")
+	}
+	root := t.TempDir()
+	source := filepath.Join(root, "source")
+	if e := os.Mkdir(source, 0700); e != nil {
+		t.Fatal(e)
+	}
+	command := func(dir string, argv ...string) string {
+		t.Helper()
+		c := exec.Command(argv[0], argv[1:]...)
+		c.Dir = dir
+		raw, e := c.CombinedOutput()
+		if e != nil {
+			t.Fatalf("%v: %v %s", argv, e, raw)
+		}
+		return strings.TrimSpace(string(raw))
+	}
+	write := func(path, body string) {
+		t.Helper()
+		if e := os.WriteFile(path, []byte(body), 0600); e != nil {
+			t.Fatal(e)
+		}
+	}
+	write(filepath.Join(source, "go.mod"), "module example.org/timing-fixture\n\ngo 1.26.9\n")
+	write(filepath.Join(source, "main.go"), timingNodeSource)
+	command(source, "git", "init", "-q")
+	command(source, "git", "config", "commit.gpgsign", "false")
+	command(source, "git", "add", "go.mod", "main.go")
+	commit := func(subject string) string {
+		command(source, "git", "-c", "user.name=Owned fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", subject)
+		return command(source, "git", "rev-parse", "HEAD")
+	}
+	beforeCommit := commit("test: expose commit timing race")
+	beforeBin := filepath.Join(root, "before")
+	command(source, "go", "build", "-buildvcs=true", "-o", beforeBin, ".")
+	write(filepath.Join(source, "main.go"), strings.Replace(timingNodeSource, "waitForCommit = false", "waitForCommit = true", 1))
+	command(source, "git", "add", "main.go")
+	afterCommit := commit("fix: wait for the committed value")
+	afterBin := filepath.Join(root, "after")
+	command(source, "go", "build", "-buildvcs=true", "-o", afterBin, ".")
+	p := frozenPlan()
+	p.AssertionID = "timing/assert/0"
+	p.NormalAssertionIDs = []string{"timing/assert/1"}
+	p.OwnedNodeIDs = []string{"node1"}
+	p.Injection = &Injection{Kind: "delay", Target: "node1", Step: "timing/step/1", MinDelayMS: 0, MaxDelayMS: 3}
+	driverHash := hashBytes([]byte(timingDSL))
+	envHash := hashBytes([]byte("owned-loopback-one-node-v1"))
+	beforeBytes, e := os.ReadFile(beforeBin)
+	if e != nil {
+		t.Fatal(e)
+	}
+	afterBytes, e := os.ReadFile(afterBin)
+	if e != nil {
+		t.Fatal(e)
+	}
+	p.Before = Source{Commit: beforeCommit, BinarySHA256: hashBytes(beforeBytes), DriverSHA256: driverHash, EnvironmentSHA256: envHash}
+	after := Source{Commit: afterCommit, BinarySHA256: hashBytes(afterBytes), DriverSHA256: driverHash, EnvironmentSHA256: envHash}
+	p.After = &after
+	p.TotalTimeoutSeconds = 120
+	leases := []*liveLease{}
+	factory := &DSLFactory{Case: []byte(timingDSL), BinaryByCommit: map[string]string{beforeCommit: beforeBin, afterCommit: afterBin}}
+	factory.OpenLease = func(ctx context.Context, r TrialRequest, binary string) (DSLLease, error) {
+		c := exec.Command(binary)
+		stdout, e := c.StdoutPipe()
+		if e != nil {
+			return nil, e
+		}
+		if e = c.Start(); e != nil {
+			return nil, e
+		}
+		lease := &liveLease{command: c, done: make(chan struct{}), identity: SessionIdentity{Source: r.Source, LeaseID: fmt.Sprintf("owned-%d", c.Process.Pid), OwnedNodeIDs: []string{"node1"}}}
+		leases = append(leases, lease)
+		go func() { lease.waitErr = c.Wait(); close(lease.done) }()
+		urlCh := make(chan string, 1)
+		go func() { line, _ := bufio.NewReader(stdout).ReadString('\n'); urlCh <- strings.TrimSpace(line) }()
+		select {
+		case <-ctx.Done():
+			return lease, ctx.Err()
+		case url := <-urlCh:
+			if !strings.HasPrefix(url, "http://127.0.0.1:") {
+				return lease, fmt.Errorf("owned endpoint unavailable")
+			}
+			sess, e := session.New(filepath.Join(root, "artifacts"), "timing experiment", time.Now().UTC())
+			if e != nil {
+				return lease, e
+			}
+			env, e := sess.NewEnvironment(session.Fingerprint(hashBytes([]byte(lease.identity.LeaseID))))
+			if e != nil {
+				return lease, e
+			}
+			env.PopulateNodeTable(node.NodeSet{Nodes: []node.Node{{Index: 1, Role: node.RoleBP, RPCURL: url, PID: c.Process.Pid}}})
+			lease.env = env
+			lease.deps = interp.Deps{RPC: func(u string) *rpc.Client { return rpc.Dial(u) }, Actions: testhelper.Registry()}
+			return lease, nil
+		}
+	}
+	r, e := Run(context.Background(), p, factory)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, lease := range leases {
+		select {
+		case <-lease.done:
+		default:
+			t.Error("owned node leaked")
+		}
+	}
+	if output := os.Getenv("CHAINBENCH_EXPERIMENT_OUTPUT"); output != "" {
+		raw, _ := json.MarshalIndent(r, "", "  ")
+		write(output, string(raw)+"\n")
+	}
+	if r.Verdict != "OBSERVED_RATE_BOUND_MET" || r.Before.SymptomFailures < 3 || r.After.SymptomFailures != 0 || r.Before.Completed != 60 || r.After.Completed != 60 {
+		t.Fatal("actual timing evidence", r.Verdict, r.Before, r.After)
+	}
+}
+
+type liveLease struct {
+	command  *exec.Cmd
+	done     chan struct{}
+	waitErr  error
+	identity SessionIdentity
+	env      session.Environment
+	deps     interp.Deps
+}
+
+func (l *liveLease) Identity(context.Context) (SessionIdentity, error) {
+	select {
+	case <-l.done:
+		return l.identity, fmt.Errorf("owned process exited")
+	default:
+		return l.identity, nil
+	}
+}
+func (l *liveLease) Environment() interp.NodeTable { return l.env }
+func (l *liveLease) Dependencies() interp.Deps     { return l.deps }
+func (l *liveLease) Close(ctx context.Context) error {
+	select {
+	case <-l.done:
+		return nil
+	default:
+	}
+	if e := l.command.Process.Signal(syscall.SIGTERM); e != nil {
+		return e
+	}
+	select {
+	case <-ctx.Done():
+		return fmt.Errorf("owned cleanup unresolved: %w", ctx.Err())
+	case <-l.done:
+		return l.waitErr
+	}
+}
diff --git a/internal/experiment/run.go b/internal/experiment/run.go
new file mode 100644
index 00000000..a8b80728
--- /dev/null
+++ b/internal/experiment/run.go
@@ -0,0 +1,419 @@
+package experiment
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"math"
+	"time"
+)
+
+const MinimumInferenceSamples = 30
+
+// Factory is implemented by an execution adapter, never by caller-supplied
+// JSON. Open must return the cleanup handle even when initialization fails.
+type Factory interface {
+	Open(context.Context, TrialRequest) (TrialSession, error)
+}
+type TrialRequest struct {
+	ExperimentID       string
+	Mode               string
+	Source             Source
+	Schedule           Schedule
+	OwnedNodeIDs       []string
+	Injection          *Injection
+	AssertionID        string
+	NormalAssertionIDs []string
+	Resume             *ResumeTrigger
+}
+
+// TrialSession owns only the resources its factory allocated. Close must not
+// stop an adopted or unrelated network. Observation sessions are read-only.
+type TrialSession interface {
+	Identity(context.Context) (SessionIdentity, error)
+	Run(context.Context) (Observation, error)
+	Close(context.Context) error
+}
+type SessionIdentity struct {
+	Source       Source   `json:"source"`
+	LeaseID      string   `json:"lease_id"`
+	OwnedNodeIDs []string `json:"owned_node_ids"`
+	ReadOnly     bool     `json:"read_only"`
+}
+type AssertionObservation struct {
+	ID            string `json:"id"`
+	Pass          bool   `json:"pass"`
+	Error         string `json:"error,omitempty"`
+	ReceiptSHA256 string `json:"receipt_sha256"`
+}
+type InjectionObservation struct {
+	Kind          string `json:"kind"`
+	Target        string `json:"target"`
+	Step          string `json:"step"`
+	DelayMS       int    `json:"delay_ms"`
+	Executed      bool   `json:"executed"`
+	ReceiptSHA256 string `json:"receipt_sha256"`
+}
+type Event struct {
+	Name          string    `json:"name"`
+	AssertionID   string    `json:"assertion_id"`
+	Source        Source    `json:"source"`
+	ObservedAt    time.Time `json:"observed_at"`
+	ReceiptSHA256 string    `json:"receipt_sha256"`
+}
+type Observation struct {
+	Symptom   AssertionObservation   `json:"symptom"`
+	Controls  []AssertionObservation `json:"controls"`
+	Injection *InjectionObservation  `json:"injection"`
+	Events    []Event                `json:"events"`
+}
+type Trial struct {
+	Cohort       string           `json:"cohort"`
+	Source       Source           `json:"source"`
+	Schedule     Schedule         `json:"schedule"`
+	Identity     *SessionIdentity `json:"identity"`
+	Observation  *Observation     `json:"observation"`
+	Outcome      string           `json:"outcome"` // PASS, SYMPTOM_FAIL, CONTROL_FAIL, ERROR
+	Error        string           `json:"error,omitempty"`
+	CleanupOK    bool             `json:"cleanup_ok"`
+	CleanupError string           `json:"cleanup_error,omitempty"`
+	StartedAt    time.Time        `json:"started_at"`
+	FinishedAt   time.Time        `json:"finished_at"`
+}
+type Counts struct {
+	Planned              int      `json:"planned"`
+	Attempted            int      `json:"attempted"`
+	Completed            int      `json:"completed"` // usable designated assertion + controls + cleanup
+	SymptomFailures      int      `json:"symptom_failures"`
+	ControlFailures      int      `json:"control_failures"`
+	InfrastructureErrors int      `json:"infrastructure_errors"`
+	Missing              int      `json:"missing"`
+	FailureRate          *float64 `json:"failure_rate"`
+	UpperFailureRate95   *float64 `json:"upper_failure_rate_95"`
+}
+type Report struct {
+	SchemaVersion   int     `json:"schema_version"`
+	Plan            Plan    `json:"plan"`
+	PlanSHA256      string  `json:"plan_sha256"`
+	Trials          []Trial `json:"trials"`
+	Before          Counts  `json:"before"`
+	After           *Counts `json:"after"`
+	Verdict         string  `json:"verdict"`
+	StopReason      string  `json:"stop_reason"`
+	ResumeRequested bool    `json:"resume_requested"`
+	Acceptance      string  `json:"acceptance"`
+}
+
+func Run(parent context.Context, p Plan, f Factory) (Report, error) {
+	if e := p.Validate(); e != nil {
+		return Report{}, e
+	}
+	if f == nil {
+		return Report{}, fmt.Errorf("missing execution factory")
+	}
+	// Own every pointer/slice: a caller may not change frozen conditions while
+	// callbacks run. Callbacks receive separate copies again for each trial.
+	raw, _ := json.Marshal(p)
+	var frozen Plan
+	if e := json.Unmarshal(raw, &frozen); e != nil {
+		return Report{}, e
+	}
+	p = frozen
+	digest, _ := p.Digest()
+	schedules, _ := p.Schedules()
+	out := Report{SchemaVersion: 1, Plan: p, PlanSHA256: digest, Trials: []Trial{}, Acceptance: "not_recorded"}
+	ctx, cancel := context.WithTimeout(parent, time.Duration(p.TotalTimeoutSeconds)*time.Second)
+	defer cancel()
+	sources := []Source{p.Before}
+	if p.After != nil {
+		sources = append(sources, *p.After)
+	}
+	stop := false
+	for _, schedule := range schedules {
+		for cohort, source := range sources {
+			if ctx.Err() != nil {
+				out.StopReason = "total_time_budget"
+				stop = true
+				break
+			}
+			label := "before"
+			if cohort == 1 {
+				label = "after"
+			}
+			trial := execute(ctx, p, source, schedule, label, f)
+			out.Trials = append(out.Trials, trial)
+			if !trial.CleanupOK {
+				out.StopReason = "cleanup_unresolved"
+				stop = true
+				break
+			}
+		}
+		if stop {
+			break
+		}
+	}
+	out.Before = count(out.Trials, "before", p.Repetitions)
+	if p.After != nil {
+		after := count(out.Trials, "after", p.Repetitions)
+		out.After = &after
+	}
+	out.Verdict = verdict(out)
+	if p.Mode == "observation" {
+		out.Verdict = "AWAITING_OBSERVATION"
+		if out.Before.InfrastructureErrors > 0 || out.Before.ControlFailures > 0 {
+			out.Verdict = "ERROR"
+		} else {
+			for _, trial := range out.Trials {
+				if trial.Outcome != "SYMPTOM_FAIL" || trial.Observation == nil {
+					continue
+				}
+				for _, e := range trial.Observation.Events {
+					if e.Name == p.Resume.Event && e.AssertionID == p.Resume.AssertionID {
+						out.ResumeRequested = true
+						out.Verdict = "RECURRED"
+					}
+				}
+			}
+		}
+	}
+	if out.StopReason == "" {
+		out.StopReason = "planned_trials_finished"
+	}
+	return out, nil
+}
+
+func execute(parent context.Context, p Plan, source Source, schedule Schedule, cohort string, f Factory) (trial Trial) {
+	trial = Trial{Cohort: cohort, Source: source, Schedule: schedule, Outcome: "ERROR", StartedAt: time.Now().UTC()}
+	ctx, cancel := context.WithTimeout(parent, time.Duration(p.TrialTimeoutSeconds)*time.Second)
+	defer cancel()
+	request := TrialRequest{ExperimentID: p.ID, Mode: p.Mode, Source: source, Schedule: schedule, OwnedNodeIDs: append([]string(nil), p.OwnedNodeIDs...), AssertionID: p.AssertionID, NormalAssertionIDs: append([]string(nil), p.NormalAssertionIDs...)}
+	if p.Injection != nil {
+		i := *p.Injection
+		request.Injection = &i
+	}
+	if p.Resume != nil {
+		r := *p.Resume
+		request.Resume = &r
+	}
+	var session TrialSession
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			trial.Outcome = "ERROR"
+			trial.Error = "execution_adapter_panic"
+		}
+		if session != nil {
+			// Cancellation of a trial never cancels the cleanup attempt.
+			clean, cancelClean := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancelClean()
+			err := safeClose(clean, session)
+			trial.CleanupOK = err == nil
+			if err != nil {
+				trial.CleanupError = err.Error()
+				trial.Outcome = "ERROR"
+			}
+		} else {
+			trial.CleanupOK = trial.Error != "execution_adapter_panic"
+		}
+		trial.FinishedAt = time.Now().UTC()
+	}()
+	var err error
+	session, err = f.Open(ctx, request)
+	if err != nil {
+		trial.Error = "initialization_failed: " + err.Error()
+		return
+	}
+	if session == nil {
+		trial.Error = "missing_trial_session"
+		return
+	}
+	identity, err := session.Identity(ctx)
+	if err != nil {
+		trial.Error = "identity_unavailable: " + err.Error()
+		return
+	}
+	identity.OwnedNodeIDs = append([]string(nil), identity.OwnedNodeIDs...)
+	trial.Identity = &identity
+	if identity.Source != source || identity.LeaseID == "" || !unique(identity.OwnedNodeIDs) {
+		trial.Error = "session_identity_mismatch"
+		return
+	}
+	if p.Mode == "observation" {
+		if !identity.ReadOnly {
+			trial.Error = "observation_must_be_read_only"
+			return
+		}
+	} else {
+		if identity.ReadOnly || !sameSet(identity.OwnedNodeIDs, p.OwnedNodeIDs) {
+			trial.Error = "node_ownership_mismatch"
+			return
+		}
+	}
+	observation, err := session.Run(ctx)
+	trial.Observation = &observation
+	if err != nil {
+		trial.Error = "execution_failed: " + err.Error()
+		return
+	}
+	if ctx.Err() != nil {
+		trial.Error = "trial_time_budget"
+		return
+	}
+	after, err := session.Identity(ctx)
+	if err != nil || after.Source != identity.Source || after.LeaseID != identity.LeaseID || after.ReadOnly != identity.ReadOnly || !sameSet(after.OwnedNodeIDs, identity.OwnedNodeIDs) {
+		trial.Error = "session_identity_changed"
+		return
+	}
+	if e := validateObservation(p, source, schedule, observation, trial.StartedAt, time.Now().UTC()); e != nil {
+		trial.Error = e.Error()
+		return
+	}
+	trial.Outcome = "PASS"
+	for _, control := range observation.Controls {
+		if !control.Pass {
+			trial.Outcome = "CONTROL_FAIL"
+			return
+		}
+	}
+	if !observation.Symptom.Pass {
+		trial.Outcome = "SYMPTOM_FAIL"
+	}
+	return
+}
+func safeClose(ctx context.Context, s TrialSession) (err error) {
+	defer func() {
+		if recover() != nil {
+			err = fmt.Errorf("cleanup_adapter_panic")
+		}
+	}()
+	return s.Close(ctx)
+}
+func sameSet(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for _, v := range a {
+		if !contains(b, v) {
+			return false
+		}
+	}
+	return true
+}
+func validAssertion(a AssertionObservation) bool {
+	return a.ID != "" && a.Error == "" && validHash(a.ReceiptSHA256, 64)
+}
+func validateObservation(p Plan, source Source, schedule Schedule, o Observation, start, end time.Time) error {
+	if o.Symptom.ID != p.AssertionID || !validAssertion(o.Symptom) {
+		return fmt.Errorf("designated_assertion_unavailable")
+	}
+	if len(o.Controls) != len(p.NormalAssertionIDs) {
+		return fmt.Errorf("normal_control_coverage_mismatch")
+	}
+	names := []string{}
+	for _, c := range o.Controls {
+		if !validAssertion(c) || !contains(p.NormalAssertionIDs, c.ID) || contains(names, c.ID) {
+			return fmt.Errorf("normal_control_identity_mismatch")
+		}
+		names = append(names, c.ID)
+	}
+	if p.Injection != nil {
+		i := o.Injection
+		want := p.Injection
+		if i == nil || !i.Executed || i.Kind != want.Kind || i.Target != want.Target || i.Step != want.Step || i.DelayMS != schedule.DelayMS || !validHash(i.ReceiptSHA256, 64) {
+			return fmt.Errorf("injection_not_verified")
+		}
+	} else if o.Injection != nil {
+		return fmt.Errorf("unexpected_injection")
+	}
+	if len(o.Events) > 128 {
+		return fmt.Errorf("event_budget_exceeded")
+	}
+	for _, e := range o.Events {
+		if e.Source != source || e.Name == "" || !validHash(e.ReceiptSHA256, 64) || e.ObservedAt.Before(start) || e.ObservedAt.After(end) {
+			return fmt.Errorf("event_identity_mismatch")
+		}
+	}
+	return nil
+}
+func count(trials []Trial, cohort string, planned int) Counts {
+	c := Counts{Planned: planned}
+	for _, trial := range trials {
+		if trial.Cohort != cohort {
+			continue
+		}
+		c.Attempted++
+		switch trial.Outcome {
+		case "PASS":
+			c.Completed++
+		case "SYMPTOM_FAIL":
+			c.Completed++
+			c.SymptomFailures++
+		case "CONTROL_FAIL":
+			c.ControlFailures++
+		default:
+			c.InfrastructureErrors++
+		}
+	}
+	c.Missing = planned - c.Attempted
+	if c.Completed > 0 {
+		rate := float64(c.SymptomFailures) / float64(c.Completed)
+		upper := UpperBinomial95(c.SymptomFailures, c.Completed)
+		c.FailureRate = &rate
+		c.UpperFailureRate95 = &upper
+	}
+	return c
+}
+func verdict(r Report) string {
+	p := r.Plan
+	before := r.Before
+	if before.InfrastructureErrors > 0 || before.ControlFailures > 0 || r.After != nil && (r.After.InfrastructureErrors > 0 || r.After.ControlFailures > 0) {
+		return "ERROR"
+	}
+	if before.Missing > 0 || before.Completed < p.MinCompleted || before.Completed < MinimumInferenceSamples {
+		return "INCONCLUSIVE"
+	}
+	if before.SymptomFailures < p.MinSymptomFailures {
+		return "AWAITING_OBSERVATION"
+	}
+	if r.After == nil {
+		return "REPRODUCED"
+	}
+	after := r.After
+	if after.Missing > 0 || after.Completed < p.MinCompleted || after.Completed < MinimumInferenceSamples {
+		return "INCONCLUSIVE"
+	}
+	if after.UpperFailureRate95 == nil || *after.UpperFailureRate95 > p.MaxFailureRate {
+		return "RATE_BOUND_NOT_MET"
+	}
+	return "OBSERVED_RATE_BOUND_MET"
+}
+
+// UpperBinomial95 is the one-sided 95% Clopper-Pearson upper bound. It is
+// an observed-window bound, never a claim that a failure is impossible.
+func UpperBinomial95(k, n int) float64 {
+	if n < 1 || k < 0 || k > n {
+		return math.NaN()
+	}
+	if k == n {
+		return 1
+	}
+	if k == 0 {
+		return -math.Expm1(math.Log(.05) / float64(n))
+	}
+	lo, hi := float64(k)/float64(n), 1.0
+	for iteration := 0; iteration < 60; iteration++ {
+		p := (lo + hi) / 2
+		cdf := 0.0
+		logN, _ := math.Lgamma(float64(n + 1))
+		for i := 0; i <= k; i++ {
+			logI, _ := math.Lgamma(float64(i + 1))
+			logRest, _ := math.Lgamma(float64(n - i + 1))
+			cdf += math.Exp(logN - logI - logRest + float64(i)*math.Log(p) + float64(n-i)*math.Log1p(-p))
+		}
+		if cdf > .05 {
+			lo = p
+		} else {
+			hi = p
+		}
+	}
+	return (lo + hi) / 2
+}
diff --git a/internal/experiment/run_test.go b/internal/experiment/run_test.go
new file mode 100644
index 00000000..2255dcde
--- /dev/null
+++ b/internal/experiment/run_test.go
@@ -0,0 +1,248 @@
+package experiment
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+type trialFactory struct {
+	requests  []TrialRequest
+	sessions  []*trialSession
+	edit      func(*trialSession)
+	openErr   error
+	openPanic bool
+}
+type trialSession struct {
+	request          TrialRequest
+	identity         SessionIdentity
+	observation      Observation
+	runErr, closeErr error
+	closed           bool
+	cancelledCleanup bool
+	drift            bool
+	panicRun         bool
+}
+
+func (f *trialFactory) Open(ctx context.Context, r TrialRequest) (TrialSession, error) {
+	if f.openPanic {
+		panic("adapter")
+	}
+	f.requests = append(f.requests, r)
+	s := &trialSession{request: r, identity: SessionIdentity{Source: r.Source, LeaseID: fmt.Sprintf("lease-%d", len(f.requests)), OwnedNodeIDs: r.OwnedNodeIDs, ReadOnly: r.Mode == "observation"}}
+	s.observation = Observation{Symptom: AssertionObservation{ID: r.AssertionID, Pass: r.Source.Commit != strings.Repeat("1", 40), ReceiptSHA256: strings.Repeat("a", 64)}, Controls: []AssertionObservation{{ID: r.NormalAssertionIDs[0], Pass: true, ReceiptSHA256: strings.Repeat("b", 64)}}}
+	if r.Injection != nil {
+		s.observation.Injection = &InjectionObservation{Kind: r.Injection.Kind, Target: r.Injection.Target, Step: r.Injection.Step, DelayMS: r.Schedule.DelayMS, Executed: true, ReceiptSHA256: strings.Repeat("c", 64)}
+	}
+	if f.edit != nil {
+		f.edit(s)
+	}
+	f.sessions = append(f.sessions, s)
+	return s, f.openErr
+}
+func (s *trialSession) Identity(context.Context) (SessionIdentity, error) { return s.identity, nil }
+func (s *trialSession) Run(ctx context.Context) (Observation, error) {
+	if s.panicRun {
+		panic("execution")
+	}
+	if s.drift {
+		s.identity.Source.BinarySHA256 = strings.Repeat("d", 64)
+	}
+	return s.observation, s.runErr
+}
+func (s *trialSession) Close(ctx context.Context) error {
+	s.closed = true
+	s.cancelledCleanup = ctx.Err() != nil
+	return s.closeErr
+}
+func runExperiment(t *testing.T, p Plan, f *trialFactory) Report {
+	t.Helper()
+	r, e := Run(context.Background(), p, f)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return r
+}
+func TestPairedTrialsUseSameScheduleAndNormalControls(t *testing.T) {
+	f := &trialFactory{}
+	p := frozenPlan()
+	r := runExperiment(t, p, f)
+	if r.Verdict != "OBSERVED_RATE_BOUND_MET" || r.Acceptance != "not_recorded" || r.Before.Completed != 60 || r.Before.SymptomFailures != 60 || r.After.Completed != 60 || r.After.SymptomFailures != 0 || r.After.UpperFailureRate95 == nil || *r.After.UpperFailureRate95 > .05 {
+		t.Fatal(r.Before, r.After, r.Verdict)
+	}
+	for i := 0; i < len(f.requests); i += 2 {
+		if f.requests[i].Schedule != f.requests[i+1].Schedule {
+			t.Fatal("different before/after timing")
+		}
+	}
+	for _, s := range f.sessions {
+		if !s.closed || s.cancelledCleanup {
+			t.Fatal("cleanup not independent")
+		}
+	}
+}
+func TestInfrastructureFailureCannotBecomeSymptomFailure(t *testing.T) {
+	for _, mode := range []string{"open", "run", "assert_error", "wrong_assertion", "missing_control", "injection", "ownership", "identity", "normal", "panic", "drift"} {
+		t.Run(mode, func(t *testing.T) {
+			f := &trialFactory{edit: func(s *trialSession) {
+				switch mode {
+				case "drift":
+					s.drift = true
+				case "run":
+					s.runErr = errors.New("RPC unavailable")
+				case "assert_error":
+					s.observation.Symptom.Error = "RPC error"
+				case "wrong_assertion":
+					s.observation.Symptom.ID = "unrelated"
+				case "missing_control":
+					s.observation.Controls = nil
+				case "injection":
+					s.observation.Injection.Executed = false
+				case "ownership":
+					s.identity.OwnedNodeIDs = []string{"external"}
+				case "identity":
+					s.identity.Source.Commit = strings.Repeat("8", 40)
+				case "normal":
+					s.observation.Controls[0].Pass = false
+				case "panic":
+					s.panicRun = true
+				}
+			}}
+			if mode == "open" {
+				f.openErr = errors.New("startup failed")
+			}
+			p := frozenPlan()
+			p.Repetitions = 2
+			p.MinCompleted = 2
+			p.MinSymptomFailures = 1
+			r := runExperiment(t, p, f)
+			if r.Verdict != "ERROR" || r.Before.Completed != 0 || r.Before.SymptomFailures != 0 {
+				t.Fatalf("invalid execution counted as reproduction: %+v", r)
+			}
+			for _, s := range f.sessions {
+				if !s.closed {
+					t.Fatal("failure bypassed cleanup")
+				}
+			}
+		})
+	}
+}
