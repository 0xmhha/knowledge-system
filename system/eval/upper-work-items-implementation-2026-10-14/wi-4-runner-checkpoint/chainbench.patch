+func TestBinomialUpperBoundAnalyticCases(t *testing.T) {
+	for _, tc := range []struct {
+		k, n int
+		want float64
+	}{{0, 1, .95}, {0, 60, 1 - math.Pow(.05, 1.0/60)}, {1, 2, math.Sqrt(.95)}, {2, 2, 1}} {
+		if got := UpperBinomial95(tc.k, tc.n); math.Abs(got-tc.want) > 1e-12 {
+			t.Fatalf("bound(%d,%d)=%g want %g", tc.k, tc.n, got, tc.want)
+		}
+	}
+	if !math.IsNaN(UpperBinomial95(0, 0)) {
+		t.Fatal("empty denominator had numeric rate")
+	}
+}
