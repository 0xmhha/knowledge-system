+package interp_test
+
+import (
+	"context"
+	"errors"
+	"github.com/0xmhha/chainbench/internal/core/session"
+	"github.com/0xmhha/chainbench/internal/dsl"
+	"github.com/0xmhha/chainbench/internal/dsl/interp"
+	"testing"
+)
+
+type transportAssertion struct{}
+
+func (transportAssertion) Check(context.Context, *interp.AssertCtx) (session.AssertResult, error) {
+	return session.AssertResult{Pass: false}, errors.New("RPC unavailable")
+}
+func TestRequestLocalInjectionHookRunsBeforeNamedStepAndDoesNotLeak(t *testing.T) {
+	reg := interp.NewRegistry()
+	ran := false
+	reg.RegisterAction("read", fakeAction{ran: &ran})
+	reg.RegisterAssertion("Len", fakeAssertion{pass: true})
+	it := interp.NewInterpreter(interp.Deps{Actions: reg})
+	spec := dsl.Spec{ID: "case", Steps: []map[string]any{{"read": map[string]any{}}}, Assertions: []map[string]any{{"assert": "Len"}}}
+	calls := 0
+	hook := func(ctx context.Context, id string, index int, d *interp.Deps, env interp.NodeTable, rec interp.Recorder) error {
+		calls++
+		if id != "case" || index != 0 || ran {
+			t.Fatal("injection did not precede exact step")
+		}
+		return nil
+	}
+	rec := &fakeRecord{}
+	status, e := it.Run(interp.WithStepHook(context.Background(), hook), spec, testEnv(t), rec)
+	if e != nil || status != session.StatusPass || calls != 1 || !ran {
+		t.Fatal(status, e, calls)
+	}
+	ran = false
+	_, e = it.Run(context.Background(), spec, testEnv(t), &fakeRecord{})
+	if e != nil || calls != 1 || !ran {
+		t.Fatal("hook leaked to unrelated request")
+	}
+}
+func TestInjectionFailureBlocksRatherThanManufacturesSymptomFailure(t *testing.T) {
+	reg := interp.NewRegistry()
+	ran := false
+	reg.RegisterAction("read", fakeAction{ran: &ran})
+	it := interp.NewInterpreter(interp.Deps{Actions: reg})
+	spec := dsl.Spec{ID: "case", Steps: []map[string]any{{"read": map[string]any{}}}}
+	rec := &fakeRecord{}
+	ctx := interp.WithStepHook(context.Background(), func(context.Context, string, int, *interp.Deps, interp.NodeTable, interp.Recorder) error {
+		return errors.New("owned node unavailable")
+	})
+	status, e := it.Run(ctx, spec, testEnv(t), rec)
+	if e == nil || status != session.StatusBlocked || ran || rec.stepResults[0].Error == "" {
+		t.Fatal(status, e, ran)
+	}
+}
+func TestAssertionTransportErrorSurvivesRecordedArtifacts(t *testing.T) {
+	reg := interp.NewRegistry()
+	reg.RegisterAssertion("read", transportAssertion{})
+	it := interp.NewInterpreter(interp.Deps{Actions: reg})
+	rec := &fakeRecord{}
+	status, e := it.Run(context.Background(), dsl.Spec{ID: "case", Assertions: []map[string]any{{"assert": "read"}}}, testEnv(t), rec)
+	if e != nil || status != session.StatusFail || len(rec.asserts) != 1 || rec.asserts[0].Error != "RPC unavailable" {
+		t.Fatal(status, e, rec.asserts)
+	}
+}
diff --git a/internal/experiment/dsl.go b/internal/experiment/dsl.go
new file mode 100644
index 00000000..d1b87e34
--- /dev/null
+++ b/internal/experiment/dsl.go
@@ -0,0 +1,295 @@
+package experiment
+
+import (
+	"context"
+	"crypto/sha256"
+	"debug/buildinfo"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"time"
+
+	"github.com/0xmhha/chainbench/internal/core/session"
+	"github.com/0xmhha/chainbench/internal/dsl"
+	"github.com/0xmhha/chainbench/internal/dsl/interp"
+)
+
+// DSLLease is supplied by the existing composition owner. The experiment
+// layer cannot adopt node control from a caller's JSON ownership assertion.
+// Identity re-observes the owner's runtime/environment at each check.
+type DSLLease interface {
+	Identity(context.Context) (SessionIdentity, error)
+	Environment() interp.NodeTable
+	Dependencies() interp.Deps
+	Close(context.Context) error
+}
+type DSLFactory struct {
+	Case           []byte
+	BinaryByCommit map[string]string
+	OpenLease      func(context.Context, TrialRequest, string) (DSLLease, error)
+}
+type dslTrial struct {
+	request   TrialRequest
+	factory   *DSLFactory
+	spec      dsl.Spec
+	lease     DSLLease
+	binary    string
+	injection *InjectionObservation
+	events    []Event
+}
+
+func (f *DSLFactory) Open(ctx context.Context, r TrialRequest) (TrialSession, error) {
+	if f.OpenLease == nil {
+		return nil, fmt.Errorf("composition owner unavailable")
+	}
+	sum := sha256.Sum256(f.Case)
+	if hex.EncodeToString(sum[:]) != r.Source.DriverSHA256 {
+		return nil, fmt.Errorf("frozen DSL driver differs")
+	}
+	spec, e := dsl.Parse(f.Case)
+	if e != nil {
+		return nil, e
+	}
+	if r.Mode == "observation" {
+		if e = readOnlyCase(spec); e != nil {
+			return nil, e
+		}
+	}
+	if r.Injection != nil {
+		found := false
+		index := 0
+		for _, st := range dsl.SequenceOf(spec) {
+			if st.Do != "" {
+				if fmt.Sprintf("%s/step/%d", spec.ID, index) == r.Injection.Step {
+					found = true
+				}
+				index++
+			}
+		}
+		if !found {
+			return nil, fmt.Errorf("frozen injection step not present in DSL")
+		}
+	}
+	binary := f.BinaryByCommit[r.Source.Commit]
+	if e = verifyGoBinary(binary, r.Source); e != nil {
+		return nil, e
+	}
+	s := &dslTrial{request: r, factory: f, spec: spec, binary: binary}
+	lease, e := f.OpenLease(ctx, r, binary)
+	s.lease = lease
+	// Keep the cleanup handle when composition only partially initialized.
+	return s, e
+}
+func (s *dslTrial) Identity(ctx context.Context) (SessionIdentity, error) {
+	if s.lease == nil {
+		return SessionIdentity{}, fmt.Errorf("composition lease unavailable")
+	}
+	if e := verifyGoBinary(s.binary, s.request.Source); e != nil {
+		return SessionIdentity{}, e
+	}
+	sum := sha256.Sum256(s.factory.Case)
+	if hex.EncodeToString(sum[:]) != s.request.Source.DriverSHA256 {
+		return SessionIdentity{}, fmt.Errorf("DSL changed during trial")
+	}
+	return s.lease.Identity(ctx)
+}
+func (s *dslTrial) Close(ctx context.Context) error {
+	if s.lease == nil {
+		return nil
+	}
+	return s.lease.Close(ctx)
+}
+func (s *dslTrial) Run(ctx context.Context) (Observation, error) {
+	rec := &dslEvidence{}
+	deps := s.lease.Dependencies()
+	env := s.lease.Environment()
+	if deps.Actions == nil || env == nil {
+		return Observation{}, fmt.Errorf("DSL runtime unavailable")
+	}
+	if s.request.Mode == "observation" && deps.Nodes != nil {
+		return Observation{}, fmt.Errorf("observation must have no node control")
+	}
+	if s.request.Injection != nil {
+		ctx = interp.WithStepHook(ctx, s.inject)
+	}
+	status, e := interp.NewInterpreter(deps).Run(ctx, s.spec, env, rec)
+	out := Observation{Injection: s.injection, Controls: []AssertionObservation{}, Events: []Event{}}
+	for _, a := range rec.asserts {
+		raw, _ := json.Marshal(a)
+		sum := sha256.Sum256(raw)
+		assertion := AssertionObservation{ID: a.ID, Pass: a.Pass, Error: a.Error, ReceiptSHA256: hex.EncodeToString(sum[:])}
+		if a.ID == s.request.AssertionID {
+			if out.Symptom.ID != "" {
+				return out, fmt.Errorf("duplicate designated assertion")
+			}
+			out.Symptom = assertion
+		} else if contains(s.request.NormalAssertionIDs, a.ID) {
+			out.Controls = append(out.Controls, assertion)
+		} else if !a.Pass || a.Error != "" {
+			return out, fmt.Errorf("unrelated assertion failed")
+		}
+	}
+	if e != nil {
+		return out, e
+	}
+	if status == session.StatusBlocked {
+		return out, fmt.Errorf("DSL precondition/injection blocked")
+	}
+	if rec.failedStep {
+		return out, fmt.Errorf("DSL step failed")
+	}
+	if rec.failedPost {
+		return out, fmt.Errorf("DSL post-action failed")
+	}
+	if s.request.Mode == "observation" && !out.Symptom.Pass && out.Symptom.ID == s.request.AssertionID && out.Symptom.Error == "" {
+		out.Events = append(out.Events, Event{Name: s.request.Resume.Event, AssertionID: out.Symptom.ID, Source: s.request.Source, ObservedAt: time.Now().UTC(), ReceiptSHA256: out.Symptom.ReceiptSHA256})
+	}
+	return out, nil
+}
+func (s *dslTrial) inject(ctx context.Context, id string, index int, d *interp.Deps, env interp.NodeTable, rec interp.Recorder) error {
+	want := s.request.Injection
+	if fmt.Sprintf("%s/step/%d", id, index) != want.Step {
+		return nil
+	}
+	if s.injection != nil {
+		return fmt.Errorf("duplicate injection step")
+	}
+	n, e := env.Resolve(want.Target)
+	if e != nil {
+		return e
+	}
+	identity, e := s.lease.Identity(ctx)
+	if e != nil {
+		return e
+	}
+	if identity.ReadOnly || !contains(identity.OwnedNodeIDs, fmt.Sprintf("node%d", n.Index)) || identity.Source != s.request.Source {
+		return fmt.Errorf("fault target is not trial-owned")
+	}
+	timer := time.NewTimer(time.Duration(s.request.Schedule.DelayMS) * time.Millisecond)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+	}
+	if want.Kind != "delay" {
+		if d.Nodes == nil {
+			return fmt.Errorf("composition owner did not grant node control")
+		}
+		name := "restartNode"
+		args := map[string]any{"on": want.Target}
+		if want.Kind == "partition" {
+			name = "partition"
+			rest := []any{}
+			for _, owned := range identity.OwnedNodeIDs {
+				if owned != want.Target {
+					rest = append(rest, owned)
+				}
+			}
+			if len(rest) == 0 {
+				return fmt.Errorf("partition requires other trial-owned nodes")
+			}
+			args = map[string]any{"groups": []any{[]any{want.Target}, rest}, "method": "peers"}
+		}
+		action, ok := d.Actions.Action(name)
+		if !ok {
+			return fmt.Errorf("fault action unavailable")
+		}
+		if e = action.Do(ctx, &interp.ActionCtx{Env: env, Deps: d, Rec: rec, Args: args}); e != nil {
+			return e
+		}
+	}
+	receipt := InjectionObservation{Kind: want.Kind, Target: want.Target, Step: want.Step, DelayMS: s.request.Schedule.DelayMS, Executed: true}
+	raw, _ := json.Marshal(struct {
+		Injection InjectionObservation
+		Schedule  Schedule
+		Lease     string
+	}{receipt, s.request.Schedule, identity.LeaseID})
+	sum := sha256.Sum256(raw)
+	receipt.ReceiptSHA256 = hex.EncodeToString(sum[:])
+	s.injection = &receipt
+	rec.PostAction(session.PostResult{Name: "experiment-injection", OK: true, Detail: receipt.ReceiptSHA256})
+	return nil
+}
+
+func verifyGoBinary(path string, want Source) error {
+	f, e := os.Open(path)
+	if e != nil {
+		return fmt.Errorf("binary unavailable: %w", e)
+	}
+	defer func() { _ = f.Close() }()
+	info, e := f.Stat()
+	if e != nil || !info.Mode().IsRegular() {
+		return fmt.Errorf("binary must be a regular file")
+	}
+	h := sha256.New()
+	if _, e = io.Copy(h, f); e != nil {
+		return e
+	}
+	if hex.EncodeToString(h.Sum(nil)) != want.BinarySHA256 {
+		return fmt.Errorf("binary bytes differ from frozen source")
+	}
+	build, e := buildinfo.ReadFile(path)
+	if e != nil {
+		return fmt.Errorf("Go binary source provenance unavailable")
+	}
+	revision, modified := "", ""
+	for _, setting := range build.Settings {
+		switch setting.Key {
+		case "vcs.revision":
+			revision = setting.Value
+		case "vcs.modified":
+			modified = setting.Value
+		}
+	}
+	if revision != want.Commit || modified != "false" {
+		return fmt.Errorf("Go binary must report the exact clean frozen commit")
+	}
+	return nil
+}
+
+// Observations may inspect existing nodes, but their DSL cannot carry a fault,
+// transaction, post-hook, arbitrary RPC write or opaque function assertion.
+func readOnlyCase(s dsl.Spec) error {
+	if len(s.PreActions)+len(s.PostActions)+len(s.OnFailActions) != 0 {
+		return fmt.Errorf("observation DSL cannot carry action hooks")
+	}
+	for _, st := range dsl.SequenceOf(s) {
+		if st.Do != "" {
+			if st.Do != "read" && st.Do != "waitFor" {
+				return fmt.Errorf("observation action must be read or waitFor")
+			}
+			source, _ := st.Args["source"].(string)
+			if !contains([]string{"blockNumber", "chainId", "peerCount", "balanceAt"}, source) {
+				return fmt.Errorf("observation read source is not approved")
+			}
+		}
+		if st.Expect != "" {
+			if !contains([]string{"blockNumber", "chainId", "peerCount", "balanceAt"}, st.Expect) {
+				return fmt.Errorf("observation assertion must use an approved read-only source")
+			}
+		}
+	}
+	return nil
+}
+
+type dslEvidence struct {
+	asserts                []session.AssertResult
+	failedStep, failedPost bool
+}
+
+func (r *dslEvidence) Step(_ int, s session.StepResult) {
+	if s.Error != "" {
+		r.failedStep = true
+	}
+}
+func (r *dslEvidence) Assert(a session.AssertResult) { r.asserts = append(r.asserts, a) }
+func (r *dslEvidence) PostAction(p session.PostResult) {
+	if !p.OK {
+		r.failedPost = true
+	}
+}
+func (r *dslEvidence) Status(session.TestStatus) {}
+func (r *dslEvidence) Reason(string)             {}
