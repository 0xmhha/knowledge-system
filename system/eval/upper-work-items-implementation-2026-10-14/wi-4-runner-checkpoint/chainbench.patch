--- /dev/null
+++ b/internal/dsl/interp/step_hook.go
@@ -0,0 +1,21 @@
+package interp
+
+import "context"
+
+// StepHook is a request-local interceptor for an execution adapter's frozen
+// timing/fault plan. It has no JSON/DSL registration and cannot affect other
+// requests. The environment and node-control remain the existing interpreter's.
+type StepHook func(context.Context, string, int, *Deps, NodeTable, Recorder) error
+
+type stepHookKey struct{}
+
+func WithStepHook(ctx context.Context, hook StepHook) context.Context {
+	return context.WithValue(ctx, stepHookKey{}, hook)
+}
+func beforeStep(ctx context.Context, id string, index int, d *Deps, env NodeTable, rec Recorder) error {
+	hook, _ := ctx.Value(stepHookKey{}).(StepHook)
+	if hook == nil {
+		return nil
+	}
+	return hook(ctx, id, index, d, env, rec)
+}
