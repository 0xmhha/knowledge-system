+			f := &trialFactory{edit: func(s *trialSession) {
+				event := Event{Name: "assertion_failed", AssertionID: p.AssertionID, Source: p.Before, ObservedAt: time.Now().UTC(), ReceiptSHA256: strings.Repeat("f", 64)}
