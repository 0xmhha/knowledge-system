+import importlib.util
+from pathlib import Path
+import unittest
+
+spec = importlib.util.spec_from_file_location("driver", Path(__file__).resolve().parents[1] / "go_oracle_driver.py")
+driver = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(driver)
+
+
+def event(action, name="TestBalance", output=""):
+    return {"Action": action, "Test": name, "Output": output}
+
+
+class GoDriverTests(unittest.TestCase):
+    def test_selected_assertion_red(self):
+        self.assertEqual(driver.outcome([event("run"), event("output", output="ORACLE_ASSERTION[balance]: mismatch"), event("fail")], 1, "TestBalance", "balance"), "symptom_fail")
+
+    def test_compile_failure_and_no_selected_test_are_errors(self):
+        for code in [0, 1, 2]:
+            self.assertEqual(driver.outcome([{"Action": "fail", "Package": "ledger"}], code, "TestBalance", "balance"), "error")
+
+    def test_unrelated_assertion_is_not_red(self):
+        self.assertEqual(driver.outcome([event("run"), event("output", output="ORACLE_ASSERTION[other]: mismatch"), event("fail")], 1, "TestBalance", "balance"), "error")
+
+    def test_other_failing_subtest_is_not_hidden_by_one_symptom_marker(self):
+        events = [event("run"), event("output", "TestBalance/a", "ORACLE_ASSERTION[balance]"), event("fail", "TestBalance/a"), event("fail", "TestBalance/b"), event("fail")]
+        self.assertEqual(driver.outcome(events, 1, "TestBalance", "balance"), "error")
+
+    def test_passing_selected_test(self):
+        self.assertEqual(driver.outcome([event("run"), event("pass")], 0, "TestBalance", "balance"), "pass")
+
+    def test_pass_event_with_nonzero_process_is_error(self):
+        self.assertEqual(driver.outcome([event("run"), event("pass")], 1, "TestBalance", "balance"), "error")
+
+    def test_runtime_panic_or_build_error_cannot_hide_behind_symptom_marker(self):
+        base = [event("run"), event("output", output="ORACLE_ASSERTION[balance]: mismatch"), event("fail")]
+        for extra in [event("output", output="panic: setup broke"), {"Action":"build-fail","Package":"other"}, event("fail","TestOther")]:
+            self.assertEqual(driver.outcome([*base, extra], 1, "TestBalance", "balance"), "error")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
