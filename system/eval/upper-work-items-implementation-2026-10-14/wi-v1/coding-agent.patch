@@ -0,0 +1,179 @@
+#!/usr/bin/env python3
+"""Execute a Go bugfix through the production oracle CLI and completion hook.
+
+Creates only an owned disposable repository; exports its Git bundle and reports
+for replay. No model/chain service is started and no human acceptance is invented.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+PLUGIN = Path(__file__).resolve().parents[2] / "plugin"
+BUG = '''package ledger
+func Balance(entries []int) int {
+ if len(entries) == 0 { return 0 }
+ return entries[len(entries)-1]
+}
+'''
+FIX = '''package ledger
+func Balance(entries []int) int {
+ total := 0
+ for _, credit := range entries { total += credit }
+ return total
+}
+'''
+PRIMARY = '''package ledger
+import ("os"; "testing")
+func TestPrimary(t *testing.T) {
+ var entries []int
+ expected := 0
+ switch os.Getenv("ORACLE_CASE_ID") {
+ case "symptom": entries = []int{12,30}; expected = 42
+ case "empty": entries = []int{}
+ case "single": entries = []int{8}; expected = 8
+ default: t.Fatal("invalid case")
+ }
+ if got := Balance(entries); got != expected {
+  t.Fatalf("ORACLE_ASSERTION[ticket_balance]: got %d expected %d", got, expected)
+ }
+}
+'''
+INDEPENDENT = '''package ledger
+import ("os"; "testing")
+func TestIndependent(t *testing.T) {
+ var ledgers [][]int
+ switch os.Getenv("ORACLE_CASE_ID") {
+ case "symptom": ledgers = [][]int{{12,30},{7,10}}
+ case "empty": ledgers = [][]int{{}}
+ case "single": ledgers = [][]int{{8}}
+ default: t.Fatal("invalid case")
+ }
+ for _, entries := range ledgers {
+  remainder := Balance(entries)
+  for _, credit := range entries { remainder -= credit }
+  if remainder != 0 { t.Fatalf("ORACLE_ASSERTION[conservation]: remainder %d", remainder) }
+ }
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    out = args.out.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    summary = {"scope": "actual Go source/CLI/hook execution; no live Claude host/chain/human acceptance"}
+    with tempfile.TemporaryDirectory(prefix="oracle-go-smoke-") as temp:
+        repo = Path(temp) / "subject"
+        repo.mkdir()
+        workspace = repo / ".coding-agent/tickets/fixture"
+        workspace.mkdir(parents=True)
+
+        def run(argv, expect=0, stdin=None):
+            proc = subprocess.run(argv, cwd=repo, input=stdin, capture_output=True,
+                                  text=True, timeout=300)
+            if proc.returncode != expect:
+                raise RuntimeError(f"unexpected exit {proc.returncode}: {argv}\n{proc.stderr}\n{proc.stdout}")
+            return proc
+
+        def git(*argv):
+            return run(["git", *argv]).stdout.strip()
+
+        git("init", "-q")
+        git("config", "user.email", "fixture@example.test")
+        git("config", "user.name", "Oracle Fixture")
+        git("config", "commit.gpgsign", "false")
+        (repo / ".gitignore").write_text(".coding-agent/\n")
+        (repo / "go.mod").write_text("module example.test/oracle\n\ngo 1.26.0\n")
+        (repo / "ledger.go").write_text(BUG)
+        (repo / "primary_test.go").write_text(PRIMARY)
+        (repo / "independent_test.go").write_text(INDEPENDENT)
+        run(["gofmt", "-w", "ledger.go", "primary_test.go", "independent_test.go"])
+        (repo / "oracles").mkdir()
+        shutil.copyfile(PLUGIN / "scripts/go_oracle_driver.py", repo / "oracles/go_oracle_driver.py")
+        requirement = {"symptom_id": "ledger-total", "symptom_case": "symptom", "controls": ["empty", "single"]}
+        (repo / "acceptance.json").write_text(json.dumps(requirement))
+        (repo / "derivation.md").write_text("Re-derive from conservation: subtract each credit from the reported balance. Check a second ledger with a different total. Do not share the primary expected constant or oracle helper. This is a constructed independent method, not independent human acceptance.\n")
+        (workspace / "ticket.json").write_text(json.dumps({"id": "fixture", "symptom": "earlier credits disappear from reported balance"}))
+        git("add", ".")
+        git("commit", "-qm", "test: capture ledger conservation before the fix")
+        base = git("rev-parse", "HEAD")
+        frozen = ["go.mod", "primary_test.go", "independent_test.go", "oracles/go_oracle_driver.py", "acceptance.json", "derivation.md"]
+        digest = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
+        plan = {"schema_version": 1, "tier": "simulation", "base_ref": base, **requirement,
+                "ticket_file": "ticket.json", "ticket_sha256": digest(workspace / "ticket.json"),
+                "requirement_file": "acceptance.json", "independent_derivation_file": "derivation.md",
+                "frozen_files": {p: digest(repo / p) for p in frozen}, "timeout_seconds": 120,
+                "oracles": [{"id": "primary", "role": "primary", "files": ["primary_test.go"], "assertion_id": "ticket_balance",
+                             "command": [sys.executable, "oracles/go_oracle_driver.py", "--package", ".", "--test", "TestPrimary", "--assertion-id", "ticket_balance"]},
+                            {"id": "independent", "role": "independent", "files": ["independent_test.go"], "assertion_id": "conservation",
+                             "command": [sys.executable, "oracles/go_oracle_driver.py", "--package", ".", "--test", "TestIndependent", "--assertion-id", "conservation"]}],
+                "mutants": [{"id": "lost-credit", "kind": "reintroduce_symptom", "patches": [{"path": "ledger.go", "before": "total += credit", "after": "total = credit"}]},
+                            {"id": "literal-overfit", "kind": "overfit", "patches": [{"path": "ledger.go", "before": "return total", "after": "return 42"}]}]}
+        plan_path = workspace / "oracle-validity-plan.json"
+        plan_path.write_text(json.dumps(plan, indent=2) + "\n")
+        (repo / "ledger.go").write_text(FIX)
+        run(["gofmt", "-w", "ledger.go"])
+        fixed_source = (repo / "ledger.go").read_text()
+        git("add", "ledger.go")
+        git("commit", "-qm", "fix: preserve all ledger credits")
+        head = git("rev-parse", "HEAD")
+        # These are actual fixture gates. Security WARN is explicit limited
+        # coverage, never an invented external scanner or production acceptance.
+        normal_env = dict(os.environ, ORACLE_CASE_ID="symptom")
+        stages = []
+        for command in [["go", "build", "./..."], ["go", "test", "-race", "-count=1", "./..."], ["go", "vet", "./..."], ["gofmt", "-l", "."]]:
+            p = subprocess.run(command, cwd=repo, env=normal_env, capture_output=True, text=True, timeout=180)
+            stages.append({"command":command,"exit_code":p.returncode,"stdout":p.stdout,"stderr":p.stderr})
+            if p.returncode != 0 or (command[0]=='gofmt' and p.stdout.strip()):
+                raise RuntimeError("fixture build/test/vet/fmt failed")
+        cli = [sys.executable, str(PLUGIN / "scripts/oracle_gate.py"), "--workspace", str(workspace), "--repo", str(repo)]
+        executed = run(cli)
+        report = json.loads((workspace / "oracle-validity-report.json").read_text())
+        assert report["mechanical_verdict"] == "PASS"
+        state = {"ticket_id": "fixture", "ticket_type": "bugfix", "current_state": "EVALUATION",
+                 "states": {"ANALYSIS": {"oracle_validity_plan_sha256": digest(plan_path)},
+                            "IMPLEMENTATION": {"reproduction_commit": base},
+                            "EVALUATION": {"oracle_validity_report_sha256": digest(workspace / "oracle-validity-report.json"),
+                                "results": {"oracle_validity":"PASS","reproduction_verdict":"PASS","fix_validity_verdict":"PASS",
+                                    "unit_test":{"status":"PASS","scope":"actual owned fixture tests including race"},
+                                    "lint":{"status":"PASS","scope":"actual owned fixture go vet and gofmt"},
+                                    "security":{"status":"WARN","scope":"controlled fixture only; no independent production security assessment"},
+                                    "chainbench":{"status":"SKIPPED","scope":"simulation fixture; no live chain acceptance"},
+                                    "full_regression":{"status":"PASS","scope":"actual owned fixture package suite"}}}}}
+        (workspace / "state.json").write_text(json.dumps(state))
+        completed = run([*cli, "--check-completion"])
+        proposed = {**state, "current_state": "COMPLETION"}
+        hook_args = [sys.executable, str(PLUGIN / "hooks/completion-guard.py")]
+
+        def hook(candidate):
+            return run(hook_args, stdin=json.dumps({"tool_name": "Write", "tool_input": {"file_path": str(workspace / "state.json"), "content": json.dumps(candidate)}})).stdout
+
+        assert hook(proposed) == ""
+        proposed["states"]["EVALUATION"]["oracle_validity_report_sha256"] = "0" * 64
+        denied = json.loads(hook(proposed))
+        assert denied["hookSpecificOutput"]["permissionDecision"] == "deny"
+        assert git("status", "--porcelain") == ""
+        assert (repo / "ledger.go").read_text() == fixed_source
+        git("bundle", "create", str(out / "subject.bundle"), "--all")
+        for filename in ["ticket.json", "oracle-validity-plan.json", "oracle-validity-report.json"]:
+            shutil.copyfile(workspace / filename, out / filename)
+        summary.update(base_commit=base, head_commit=head, real_oracle_executions=len(report["runs"]),
+                       cli=executed.stdout.strip(), completion_check=completed.stdout.strip(),
+                       valid_completion_hook="allowed", invalid_report_hook=denied,
+                       original_checkout_unchanged=True, independent_human_acceptance="not_recorded",
+                       runtime=run(["go", "version"]).stdout.strip())
+        summary['fixture_stage_executions'] = stages
+    (out / "smoke-summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
