+    def test_tradeoff_frontier_is_tied_not_weighted_sum(self):
+        c=rows();c[0]['metrics']['noise']={'value':9,'unit':'hits'};c[1]['metrics']['noise']={'value':1,'unit':'hits'}
+        criteria=copy.deepcopy(self.axes);criteria['axes'].append({'id':'noise','unit':'hits','direction':'min','required':True})
