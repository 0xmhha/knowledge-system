+            final_oracle=[sys.executable,str(ROOT/'plugin/scripts/oracle_gate.py'),'--workspace',str(workspace),'--repo',str(repo)]
+            run(final_oracle)
+            state['states']['ANALYSIS']={'oracle_validity_plan_sha256':oracle.sha((workspace/'oracle-validity-plan.json').read_bytes())}
+            state['states']['IMPLEMENTATION']={'reproduction_commit':report['oracle_base_commit']}
+            state['states']['EVALUATION']={'oracle_validity_report_sha256':oracle.sha((workspace/'oracle-validity-report.json').read_bytes()),'results':{
