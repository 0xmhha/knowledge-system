+                assert not run([sys.executable,str(ROOT/'plugin/hooks'/guard)],json.dumps(complete)).stdout
+            summary.update(selection_check='PASS',applied_tree_check='PASS',final_current_head_oracle='PASS',both_completion_guards='allowed',fixture_stage_executions=gates)
+            shutil.copyfile(workspace/'oracle-validity-plan.json',out/'final-oracle-plan.json')
+            shutil.copyfile(workspace/'oracle-validity-report.json',out/'final-oracle-report.json')
+        git('bundle','create',str(out/'subject.bundle'),'--all')
+        for name in ['ticket.json','oracle-template.json','fix-selection-spec.json','fix-selection-report.json','state.json']:
+            shutil.copyfile(workspace/name,out/name)
+        (out/'candidate-and-oracle-sources.json').write_text(json.dumps({'bug':bug,'loop':fixed,'copy':copied,'primary':formatted(fixture.PRIMARY),'independent':formatted(fixture.INDEPENDENT),'metric':formatted(METRIC_TEST),'driver':DRIVER},indent=2)+'\n')
+        summary['panel_executions']=[{'role':p['role'],'kind':p['kind'],'exit_code':p['exit_code'],'error':p.get('error'),'opinion':p.get('opinion')} for p in report.get('panel',[])]
+    (out/'selection-smoke-summary.json').write_text(json.dumps(summary,indent=2)+'\n');print(json.dumps(summary,indent=2))
+    return 0 if summary.get('cli_exit')==0 else 1
+
+
+if __name__=='__main__':raise SystemExit(main())
