+        (workspace/'ticket.json').write_text(json.dumps({'id':'fixture','symptom':'earlier credits vanish from total','scope':'pure integer ledger function; immutable inputs, no hidden mutable state'}))
+        sources={p.as_posix():('kit/'+p.as_posix()) for p in [Path('primary_test.go'),Path('independent_test.go'),Path('metric_test.go'),Path('oracles/go_oracle_driver.py'),Path('oracles/selection_driver.py'),Path('acceptance.json'),Path('derivation.md')]}
+        hashes={p:oracle.sha((workspace/q).read_bytes()) for p,q in sources.items()}
