+              'regression_driver':{'command':[sys.executable,'oracles/selection_driver.py','regression'],'source_file':'oracles/selection_driver.py'},
+              'metric_drivers':[{'command':[sys.executable,'oracles/selection_driver.py','metrics'],'source_file':'oracles/selection_driver.py'}],
