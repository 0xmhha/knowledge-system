+        plan={'schema_version':1,'tier':'simulation','base_ref':base,**requirement,
+              'ticket_file':'ticket.json','ticket_sha256':oracle.sha((workspace/'ticket.json').read_bytes()),
+              'requirement_file':'acceptance.json','independent_derivation_file':'derivation.md','frozen_files':hashes,
+              'oracles':[{'id':'primary','role':'primary','assertion_id':'ticket_balance','files':['primary_test.go'],
+                         'command':[sys.executable,'oracles/go_oracle_driver.py','--package','.','--test','TestPrimary','--assertion-id','ticket_balance']},
+                        {'id':'independent','role':'independent','assertion_id':'conservation','files':['independent_test.go'],
+                         'command':[sys.executable,'oracles/go_oracle_driver.py','--package','.','--test','TestIndependent','--assertion-id','conservation']}],
