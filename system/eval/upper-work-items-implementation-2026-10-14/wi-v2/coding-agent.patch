+    def test_axis_direction_and_tolerance_apply(self):
+        c=rows();criteria=copy.deepcopy(self.axes);criteria['axes'][0]['direction']='max'
+        self.assertEqual(select.decide(criteria,c,panel(c,'b'))['selected_candidate'],'b')
+        criteria['axes'][0]['tolerance']=3
+        self.assertEqual(select.decide(criteria,c,panel(c,'b'))['status'],'TIED')
+
+
+class ExecutionTests(unittest.TestCase):
