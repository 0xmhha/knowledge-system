+                    {'id':'literal','rationale':'tempting symptom masking: return only the primary example total','commit_subject':'fix: return the example ledger total','changes':[{'path':'ledger.go','before':bug,'after':formatted('package ledger\nfunc Balance(entries []int) int { return 42 }\n')}],'mutants':mutants('overfit')}]
+        spec={'schema_version':1,'source_base_ref':base,'oracle_plan':'oracle-template.json','oracle_sources':sources,
