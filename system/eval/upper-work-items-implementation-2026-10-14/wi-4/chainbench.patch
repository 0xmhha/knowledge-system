+
+// DSLDriverDigest pins the complete driver's canonical JSON. It uses the same
+// JSON value/number semantics as the interpreter and MCP argument decoder, so
+// map ordering and insignificant formatting cannot change transport identity.
+// Exact large numeric values must be DSL strings, as in the existing DSL.
+func DSLDriverDigest(raw []byte) (string, error) {
+	var value any
+	if e := json.Unmarshal(raw, &value); e != nil {
+		return "", e
+	}
+	canonical, e := json.Marshal(value)
+	if e != nil {
+		return "", e
+	}
+	sum := sha256.Sum256(canonical)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+// FreezeBinarySource reads actual bytes and exact clean Go build provenance.
+func FreezeBinarySource(path, commit, driver, environment string) (Source, error) {
+	f, e := os.Open(path)
+	if e != nil {
+		return Source{}, e
+	}
+	defer func() { _ = f.Close() }()
+	h := sha256.New()
+	if _, e = io.Copy(h, f); e != nil {
+		return Source{}, e
+	}
+	source := Source{Commit: commit, BinarySHA256: hex.EncodeToString(h.Sum(nil)), DriverSHA256: driver, EnvironmentSHA256: environment}
+	if e = source.validate(); e != nil {
+		return Source{}, e
+	}
+	if e = verifyGoBinary(path, source); e != nil {
+		return Source{}, e
+	}
+	return source, nil
+}
