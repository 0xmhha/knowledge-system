+package mcp
+
+import "strconv"
+
+// experimentInputSchema exposes the same required pins and bounded plan that
+// the executable validator enforces. The case retains its existing DSL schema.
+func experimentInputSchema() map[string]any {
+	text := func(max int) map[string]any {
+		return map[string]any{"type": "string", "minLength": 1, "maxLength": max}
+	}
+	hash := func(n int) map[string]any {
+		return map[string]any{"type": "string", "pattern": "^[0-9a-f]{" + strconv.Itoa(n) + "}$"}
+	}
+	integer := func(min, max int) map[string]any {
+		return map[string]any{"type": "integer", "minimum": min, "maximum": max}
+	}
+	object := func(properties map[string]any, required ...string) map[string]any {
+		return map[string]any{"type": "object", "properties": properties, "required": required, "additionalProperties": false}
+	}
+	nullable := func(schema map[string]any) map[string]any {
+		return map[string]any{"anyOf": []any{schema, map[string]any{"type": "null"}}}
+	}
+	strings := func(min, max int) map[string]any {
+		return map[string]any{"type": "array", "items": text(128), "minItems": min, "maxItems": max, "uniqueItems": true}
+	}
+	source := object(map[string]any{"commit": hash(40), "binary_sha256": hash(64), "driver_sha256": hash(64), "environment_sha256": hash(64)}, "commit", "binary_sha256", "driver_sha256", "environment_sha256")
+	injection := object(map[string]any{"kind": map[string]any{"type": "string", "enum": []string{"delay", "restart", "partition"}}, "target": text(128), "step": text(128), "min_delay_ms": integer(0, 60000), "max_delay_ms": integer(0, 60000)}, "kind", "target", "step", "min_delay_ms", "max_delay_ms")
+	resume := object(map[string]any{"event": text(128), "assertion_id": text(128), "window_seconds": integer(1, 3600)}, "event", "assertion_id", "window_seconds")
+	plan := object(map[string]any{
+		"schema_version": map[string]any{"type": "integer", "const": 1}, "id": text(128), "mode": map[string]any{"type": "string", "enum": []string{"reproduction", "comparison", "observation"}}, "symptom": text(4096), "assertion_id": text(128), "seed": text(128), "before": source, "after": nullable(source), "repetitions": integer(1, 1000), "min_completed": integer(1, 1000), "min_symptom_failures": integer(1, 1000), "max_failure_rate": map[string]any{"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "trial_timeout_seconds": integer(1, 300), "total_timeout_seconds": integer(1, 7200), "owned_node_ids": strings(0, 32), "normal_assertion_ids": strings(1, 16), "injection": nullable(injection), "resume": nullable(resume),
+	}, "schema_version", "id", "mode", "symptom", "assertion_id", "seed", "before", "repetitions", "min_completed", "min_symptom_failures", "max_failure_rate", "trial_timeout_seconds", "total_timeout_seconds", "owned_node_ids", "normal_assertion_ids")
+	return object(map[string]any{"plan": plan, "case": map[string]any{"type": "object", "description": "Complete existing v1 or v2 DSL; driver pin hashes canonical JSON using interpreter value semantics."}, "binary_by_commit": map[string]any{"type": "object", "propertyNames": hash(40), "additionalProperties": text(4096), "maxProperties": 2}, "artifact_root": text(4096), "assets_sha256": map[string]any{"type": "object", "additionalProperties": hash(64)}, "observe_workspace": text(4096), "observe_composition_sha256": hash(64)}, "plan", "case", "binary_by_commit", "artifact_root")
+}
