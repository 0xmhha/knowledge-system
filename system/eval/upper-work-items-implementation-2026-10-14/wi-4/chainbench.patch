+)
+
+const experimentCase = `{"schemaVersion":"1","id":"probe","chain":{"name":"go-stablenet","binary":"pinned"},"steps":[{"read":{"source":"chainId"}}],"assertions":[{"assert":"chainId","expected":"1"},{"assert":"peerCount","expected":"0"}]}`
+
+func testExperimentInput(t *testing.T) ExperimentIn {
+	t.Helper()
+	digest, e := ExperimentEnvironmentDigest([]byte(experimentCase))
+	if e != nil {
+		t.Fatal(e)
+	}
+	driver, e := experiment.DSLDriverDigest([]byte(experimentCase))
+	if e != nil {
+		t.Fatal(e)
+	}
+	source := experiment.Source{Commit: strings.Repeat("1", 40), BinarySHA256: strings.Repeat("2", 64), DriverSHA256: driver, EnvironmentSHA256: digest}
+	p := experiment.Plan{SchemaVersion: 1, ID: "probe", Mode: "reproduction", Symptom: "wrong chain", AssertionID: "probe/assert/0", NormalAssertionIDs: []string{"probe/assert/1"}, Seed: "fixed", Before: source, Repetitions: 1, MinCompleted: 1, MinSymptomFailures: 1, MaxFailureRate: .05, TrialTimeoutSeconds: 1, TotalTimeoutSeconds: 1, OwnedNodeIDs: []string{"node1"}, Injection: &experiment.Injection{Kind: "delay", Target: "node1", Step: "probe/step/0", MaxDelayMS: 1}}
+	return ExperimentIn{Plan: p, Case: json.RawMessage(experimentCase), ArtifactRoot: filepath.Join(t.TempDir(), "new-root")}
+}
+func TestExperimentRefusesUnfrozenInputsBeforeCreatingResources(t *testing.T) {
+	for _, mode := range []string{"environment", "observation_path", "asset"} {
+		t.Run(mode, func(t *testing.T) {
+			in := testExperimentInput(t)
+			switch mode {
+			case "environment":
+				in.Plan.Before.EnvironmentSHA256 = strings.Repeat("f", 64)
+			case "observation_path":
+				in.ObserveWorkspace = "existing-network"
+			case "asset":
+				in.Case = json.RawMessage(strings.Replace(experimentCase, `"binary":"pinned"`, `"binary":"pinned","config":"missing-config"`, 1))
+			}
+			if _, e := RunExperiment(context.Background(), chainsetup.Deps{}, in); e == nil {
+				t.Fatal("invalid execution input accepted")
+			}
+			if _, e := os.Stat(in.ArtifactRoot); !os.IsNotExist(e) {
+				t.Fatal("invalid input created resources")
+			}
+		})
+	}
+}
+func TestExperimentRootCannotAdoptExistingDirectory(t *testing.T) {
+	in := testExperimentInput(t)
+	if e := os.Mkdir(in.ArtifactRoot, 0700); e != nil {
+		t.Fatal(e)
+	}
+	if _, e := RunExperiment(context.Background(), chainsetup.Deps{}, in); e == nil {
+		t.Fatal("existing root adopted as trial ownership")
+	}
+}
+func TestEnvironmentPinsIncludeAssetsAndIgnorePredicateOnly(t *testing.T) {
+	first, e := ExperimentEnvironmentDigest([]byte(experimentCase))
+	if e != nil {
+		t.Fatal(e)
+	}
+	predicate := strings.Replace(experimentCase, `"expected":"1"`, `"expected":"2"`, 1)
+	second, _ := ExperimentEnvironmentDigest([]byte(predicate))
+	if first != second {
+		t.Fatal("predicate leaked into logical environment")
+	}
+	config := strings.Replace(experimentCase, `"binary":"pinned"`, `"binary":"pinned","config":"config.json"`, 1)
+	third, _ := ExperimentEnvironmentDigest([]byte(config))
+	if first == third {
+		t.Fatal("config reference not bound")
+	}
+	fourth, _ := ExperimentEnvironmentDigest([]byte(config), map[string]string{"config.json": strings.Repeat("a", 64)})
+	if third == fourth {
+		t.Fatal("asset bytes not bound")
+	}
+}
+func TestExternalAssetChangesAreRefused(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.json")
+	if e := os.WriteFile(path, []byte("{}"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	sum := sha256.Sum256([]byte("{}"))
+	pins := map[string]string{path: hex.EncodeToString(sum[:])}
+	if e := verifyExperimentAssets([]byte(experimentCase), pins); e != nil {
+		t.Fatal(e)
+	}
+	if e := os.WriteFile(path, []byte("changed"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	if e := verifyExperimentAssets([]byte(experimentCase), pins); e == nil {
+		t.Fatal("changed external file accepted")
+	}
+}
