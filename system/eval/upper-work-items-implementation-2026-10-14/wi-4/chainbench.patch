diff --git a/cmd/chainbench/experimentcmd/experiment.go b/cmd/chainbench/experimentcmd/experiment.go
new file mode 100644
index 00000000..42df6da6
--- /dev/null
+++ b/cmd/chainbench/experimentcmd/experiment.go
@@ -0,0 +1,86 @@
+package experimentcmd
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/0xmhha/chainbench/internal/app"
+	"github.com/spf13/cobra"
+	"io"
+	"os"
+)
+
+func New() *cobra.Command {
+	var file string
+	command := &cobra.Command{Use: "experiment", Short: "Run a frozen timing, fault or observation investigation", RunE: func(cmd *cobra.Command, _ []string) error {
+		raw, e := os.ReadFile(file)
+		if e != nil {
+			return e
+		}
+		if len(raw) > 256_000 {
+			return fmt.Errorf("experiment input exceeds 256KB")
+		}
+		in, e := app.DecodeExperimentInput(raw)
+		if e != nil {
+			return e
+		}
+		report, e := app.RunExperiment(cmd.Context(), app.Deps{}, in)
+		if e != nil {
+			return e
+		}
+		if e = json.NewEncoder(cmd.OutOrStdout()).Encode(report); e != nil {
+			return e
+		}
+		if report.Verdict == "ERROR" {
+			return fmt.Errorf("experiment execution or controls failed; inspect the recorded result")
+		}
+		return nil
+	}}
+
+	var prepareFile string
+	prepare := &cobra.Command{Use: "prepare", Short: "Fill missing pins from the clean binaries and complete DSL; allocate no nodes", RunE: func(cmd *cobra.Command, _ []string) error {
+		raw, e := os.ReadFile(prepareFile)
+		if e != nil {
+			return e
+		}
+		in, e := app.DecodeExperimentInput(raw)
+		if e != nil {
+			return e
+		}
+		in, e = app.FreezeExperimentInputs(in)
+		if e != nil {
+			return e
+		}
+		return json.NewEncoder(cmd.OutOrStdout()).Encode(in)
+	}}
+	prepare.Flags().StringVar(&prepareFile, "input", "", "JSON input with caller-selected commits and conditions")
+	_ = prepare.MarkFlagRequired("input")
+	command.AddCommand(prepare)
+	var reportFile string
+	verify := &cobra.Command{Use: "verify", Short: "Verify raw experiment receipts and derived accounting", RunE: func(cmd *cobra.Command, _ []string) error {
+		f, e := os.Open(reportFile)
+		if e != nil {
+			return e
+		}
+		defer func() { _ = f.Close() }()
+		d := json.NewDecoder(io.LimitReader(f, 256*1024*1024))
+		d.DisallowUnknownFields()
+		var report app.ExperimentReport
+		if e = d.Decode(&report); e != nil {
+			return e
+		}
+		if e = d.Decode(new(any)); e != io.EOF {
+			return fmt.Errorf("exactly one JSON report required")
+		}
+		if e = app.VerifyExperimentReport(report); e != nil {
+			return e
+		}
+		_, e = fmt.Fprintln(cmd.OutOrStdout(), "PASS: receipts and accounting; independent acceptance not recorded")
+		return e
+	}}
+	verify.Flags().StringVar(&reportFile, "report", "", "recorded experiment report")
+	_ = verify.MarkFlagRequired("report")
+	command.AddCommand(verify)
+	command.Flags().StringVar(&file, "input", "", "frozen JSON experiment input file")
+	_ = command.MarkFlagRequired("input")
+	return command
+}
