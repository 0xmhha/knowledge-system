+package app
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestExperimentInputRejectsAmbiguousDocuments(t *testing.T) {
+	for _, raw := range []string{`{"plan":{},"plan":{}}`, `{"plan":{"before":{"commit":"a","commit":"b"}}}`, `{"case":{"id":"a","id":"b"}}`, `{} {}`, `{"unknown":1}`, strings.Repeat("[", 65) + strings.Repeat("]", 65), strings.Repeat(" ", 256001)} {
+		if _, e := DecodeExperimentInput([]byte(raw)); e == nil {
+			t.Fatal("ambiguous/unbounded input accepted")
+		}
+	}
+	in, e := DecodeExperimentInput([]byte(`{"plan":{"id":"caller-chosen"},"case":{"id":"unique"}}`))
+	if e != nil || in.Plan.ID != "caller-chosen" {
+		t.Fatal(in, e)
+	}
+}
