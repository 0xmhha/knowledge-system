diff --git a/internal/experiment/verify.go b/internal/experiment/verify.go
new file mode 100644
index 00000000..0e5ac36f
--- /dev/null
+++ b/internal/experiment/verify.go
@@ -0,0 +1,175 @@
+package experiment
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"reflect"
+
+	"github.com/0xmhha/chainbench/internal/core/session"
+)
+
+// VerifyDSLReport checks content and accounting, not trust in the executing
+// host. A hash proves unchanged bytes; it does not prove independent acceptance.
+func VerifyDSLReport(r Report) error {
+	if r.SchemaVersion != 1 || r.Acceptance != "not_recorded" {
+		return fmt.Errorf("unsupported report or unrecorded acceptance changed")
+	}
+	digest, err := r.Plan.Digest()
+	if err != nil {
+		return err
+	}
+	if digest != r.PlanSHA256 {
+		return fmt.Errorf("plan digest differs")
+	}
+	schedules, _ := r.Plan.Schedules()
+	cohorts := 1
+	if r.Plan.After != nil {
+		cohorts = 2
+	}
+	if len(r.Trials) > len(schedules)*cohorts {
+		return fmt.Errorf("trial budget exceeded")
+	}
+	for i, t := range r.Trials {
+		source := r.Plan.Before
+		cohort := "before"
+		if i%cohorts == 1 {
+			source = *r.Plan.After
+			cohort = "after"
+		}
+		if t.Cohort != cohort || t.Source != source || t.Schedule != schedules[i/cohorts] || t.StartedAt.IsZero() || t.FinishedAt.Before(t.StartedAt) {
+			return fmt.Errorf("trial identity/order differs")
+		}
+		if t.Outcome == "ERROR" {
+			if t.Error == "" && t.CleanupError == "" {
+				return fmt.Errorf("error trial has no reason")
+			}
+			continue
+		}
+		if !t.CleanupOK || t.CleanupError != "" || t.Error != "" || t.Identity == nil || t.Identity.Source != source || t.Observation == nil {
+			return fmt.Errorf("usable trial identity/cleanup missing")
+		}
+		if err := validateObservation(r.Plan, source, t.Schedule, *t.Observation, t.StartedAt, t.FinishedAt); err != nil {
+			return err
+		}
+		if r.Plan.Mode == "observation" {
+			want := float64(r.Plan.Resume.WindowSeconds) / float64(r.Plan.Repetitions)
+			if t.Observation.Polls < 1 || t.Observation.WatchedSeconds < 0 || t.Observation.WatchedSeconds > t.FinishedAt.Sub(t.StartedAt).Seconds()+.01 {
+				return fmt.Errorf("invalid observation window receipt")
+			}
+			if t.Outcome == "PASS" && t.Observation.WatchedSeconds+.001 < want {
+				return fmt.Errorf("observation window was not completed")
+			}
+		}
+		if err := verifyDSLReceipts(t); err != nil {
+			return err
+		}
+		outcome := "PASS"
+		if !t.Observation.Symptom.Pass {
+			outcome = "SYMPTOM_FAIL"
+		}
+		for _, c := range t.Observation.Controls {
+			if !c.Pass {
+				outcome = "CONTROL_FAIL"
+			}
+		}
+		if outcome != t.Outcome {
+			return fmt.Errorf("trial outcome differs from assertions")
+		}
+	}
+	before := count(r.Trials, "before", r.Plan.Repetitions)
+	if !reflect.DeepEqual(before, r.Before) {
+		return fmt.Errorf("before denominator differs")
+	}
+	var after *TrialCounts
+	if r.Plan.After != nil {
+		v := count(r.Trials, "after", r.Plan.Repetitions)
+		after = &v
+	}
+	if !reflect.DeepEqual(after, r.After) {
+		return fmt.Errorf("after denominator differs")
+	}
+	expected := verdict(r)
+	resume := false
+	if r.Plan.Mode == "observation" {
+		expected = "AWAITING_OBSERVATION"
+		if before.InfrastructureErrors > 0 || before.ControlFailures > 0 {
+			expected = "ERROR"
+		} else {
+			for _, t := range r.Trials {
+				if t.Outcome != "SYMPTOM_FAIL" || t.Observation == nil {
+					continue
+				}
+				for _, e := range t.Observation.Events {
+					if e.Name == r.Plan.Resume.Event && e.AssertionID == r.Plan.Resume.AssertionID {
+						resume = true
+						expected = "RECURRED"
+					}
+				}
+			}
+		}
+	}
+	if r.Verdict != expected || r.ResumeRequested != resume {
+		return fmt.Errorf("verdict/resumption differs from evidence")
+	}
+	return nil
+}
+func verifyDSLReceipts(t Trial) error {
+	o := t.Observation
+	bodies := map[string]RawReceipt{}
+	for _, receipt := range o.Receipts {
+		var compact bytes.Buffer
+		if err := json.Compact(&compact, receipt.Body); err != nil {
+			return err
+		}
+		sum := sha256.Sum256(compact.Bytes())
+		if hex.EncodeToString(sum[:]) != receipt.SHA256 {
+			return fmt.Errorf("raw receipt hash differs")
+		}
+		if old, ok := bodies[receipt.SHA256]; ok && old.Kind != receipt.Kind {
+			return fmt.Errorf("receipt kind collision")
+		}
+		bodies[receipt.SHA256] = receipt
+	}
+	assertions := append([]AssertionObservation{o.Symptom}, o.Controls...)
+	for _, a := range assertions {
+		receipt, ok := bodies[a.ReceiptSHA256]
+		if !ok || receipt.Kind != "assertion" {
+			return fmt.Errorf("assertion raw receipt missing")
+		}
+		var raw session.AssertResult
+		if e := json.Unmarshal(receipt.Body, &raw); e != nil {
+			return e
+		}
+		if raw.ID != a.ID || raw.Pass != a.Pass || raw.Error != a.Error {
+			return fmt.Errorf("assertion receipt fields differ")
+		}
+	}
+	if o.Injection != nil {
+		receipt, ok := bodies[o.Injection.ReceiptSHA256]
+		if !ok || receipt.Kind != "injection" {
+			return fmt.Errorf("injection raw receipt missing")
+		}
+		var raw struct {
+			Injection InjectionObservation
+			Schedule  Schedule
+			Lease     string
+		}
+		if e := json.Unmarshal(receipt.Body, &raw); e != nil {
+			return e
+		}
+		wanted := *o.Injection
+		wanted.ReceiptSHA256 = ""
+		if raw.Injection != wanted || raw.Schedule != t.Schedule || raw.Lease != t.Identity.LeaseID {
+			return fmt.Errorf("injection receipt identity differs")
+		}
+	}
+	for _, e := range o.Events {
+		if e.AssertionID != o.Symptom.ID || e.ReceiptSHA256 != o.Symptom.ReceiptSHA256 {
+			return fmt.Errorf("monitor event not bound to designated assertion")
+		}
+	}
+	return nil
+}
