+	path := filepath.Join(t.TempDir(), "absent")
+	if _, e := ExperimentCompositionDigest(context.Background(), chainsetup.Deps{}, path); e == nil {
+		t.Fatal("missing observation owner accepted")
+	}
+	if _, e := os.Stat(path); !os.IsNotExist(e) {
+		t.Fatal("read-only observation created missing workspace")
+	}
