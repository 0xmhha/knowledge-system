index 00000000..772e8607
--- /dev/null
+++ b/internal/chainsetup/runtime_pins.go
@@ -0,0 +1,51 @@
+package chainsetup
+
+import (
+	"context"
+	"fmt"
+)
+
+// RuntimePins is a read-only content snapshot on the actual node machines.
+// It hashes executables and launch files, never private key material.
+func (w *Workspace) RuntimePins(ctx context.Context) (map[string]string, error) {
+	if e := w.allow("RuntimePins"); e != nil {
+		return nil, e
+	}
+	out := map[string]string{}
+	cached := map[string]string{}
+	for _, ns := range w.state.Nodes {
+		t, e := w.machineFor(ns)
+		if e != nil {
+			return nil, e
+		}
+		binary := w.launchBinary(ns)
+		key := ns.Server + "\x00" + binary
+		digest, ok := cached[key]
+		if !ok {
+			digest, e = t.Files.Checksum(ctx, binary)
+			if e != nil {
+				return nil, e
+			}
+			cached[key] = digest
+		}
+		out[fmt.Sprintf("node%d/binary", ns.Index)] = digest
+		for _, path := range []string{w.state.GenesisPath, ns.ConfigPath} {
+			want, known := w.state.LaunchInputs[path]
+			if path == "" || !known {
+				return nil, fmt.Errorf("node%d launch input provenance unavailable", ns.Index)
+			}
+			actual, e := t.Files.Checksum(ctx, path)
+			if e != nil {
+				return nil, e
+			}
+			if actual != want {
+				return nil, fmt.Errorf("node%d launch input changed: %s", ns.Index, path)
+			}
+			out[fmt.Sprintf("node%d/input/%s", ns.Index, path)] = actual
+		}
+	}
+	if len(w.state.Nodes) == 0 {
+		return nil, fmt.Errorf("runtime node table unavailable")
+	}
+	return out, nil
+}
