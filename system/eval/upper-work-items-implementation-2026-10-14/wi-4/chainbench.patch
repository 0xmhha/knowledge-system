@@ -0,0 +1,61 @@
+package app
+
+import (
+	"context"
+	"fmt"
+	"github.com/0xmhha/chainbench/internal/experiment"
+	"github.com/0xmhha/chainbench/internal/testengine"
+)
+
+type ExperimentIn = testengine.ExperimentIn
+type ExperimentReport = experiment.Report
+
+func RunExperiment(ctx context.Context, d Deps, in ExperimentIn) (ExperimentReport, error) {
+	return testengine.RunExperiment(ctx, d.chainsetupDeps(), in)
+}
+func ExperimentEnvironmentDigest(raw []byte, assets ...map[string]string) (string, error) {
+	return testengine.ExperimentEnvironmentDigest(raw, assets...)
+}
+
+// VerifyExperimentReport checks unchanged raw receipts and derived accounting.
+func VerifyExperimentReport(report ExperimentReport) error { return experiment.VerifyDSLReport(report) }
+
+// FreezeExperimentInputs fills absent pins from actual inputs, refusing changes
+// to any pin already provided. It allocates no runtime resources.
+func FreezeExperimentInputs(in ExperimentIn) (ExperimentIn, error) {
+	driver, e := experiment.DSLDriverDigest(in.Case)
+	if e != nil {
+		return in, e
+	}
+	environment, e := ExperimentEnvironmentDigest(in.Case, in.AssetsSHA256)
+	if e != nil {
+		return in, e
+	}
+	sources := []*experiment.Source{&in.Plan.Before}
+	if in.Plan.After != nil {
+		copyAfter := *in.Plan.After
+		in.Plan.After = &copyAfter
+		sources = append(sources, in.Plan.After)
+	}
+	for _, old := range sources {
+		source, e := experiment.FreezeBinarySource(in.BinaryByCommit[old.Commit], old.Commit, driver, environment)
+		if e != nil {
+			return in, e
+		}
+		if old.BinarySHA256 != "" && old.BinarySHA256 != source.BinarySHA256 || old.DriverSHA256 != "" && old.DriverSHA256 != source.DriverSHA256 || old.EnvironmentSHA256 != "" && old.EnvironmentSHA256 != source.EnvironmentSHA256 {
+			return in, fmt.Errorf("existing source pin differs; refusing to rewrite frozen conditions")
+		}
+		*old = source
+	}
+	if in.Plan.Mode == "observation" {
+		digest, e := testengine.ExperimentCompositionDigest(context.Background(), Deps{}.chainsetupDeps(), in.ObserveWorkspace)
+		if e != nil {
+			return in, e
+		}
+		if in.ObserveCompositionSHA256 != "" && in.ObserveCompositionSHA256 != digest {
+			return in, fmt.Errorf("existing observation composition pin differs")
+		}
+		in.ObserveCompositionSHA256 = digest
+	}
+	return in, in.Plan.Validate()
+}
