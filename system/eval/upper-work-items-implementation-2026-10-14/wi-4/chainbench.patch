+// ChainRuntimePins reads actual node-machine file hashes through the existing
+// workspace owner and resource seam; it allocates or controls no node.
+func ChainRuntimePins(ctx context.Context, d chainsetup.Deps, in ChainObserveIn) (map[string]string, error) {
+	ws, e := chainsetup.Open(in.DataDir, d.Clock)
