+package resource
+
+import (
+	"fmt"
+	"path"
+	"path/filepath"
+)
+
+// FreshTrialTarget allocates a unique trial sub-root within the target's accepted
+// parent. The caller cannot reuse the physical data root of another network.
+func FreshTrialTarget(target Spec, localDir string) (Spec, error) {
+	if localDir == "" || !filepath.IsAbs(localDir) {
+		return Spec{}, fmt.Errorf("allocated local trial directory required")
+	}
+	if target.IsRemote() {
+		if target.DataRoot == "" {
+			return Spec{}, fmt.Errorf("remote trial requires an accepted data parent")
+		}
+		target.DataRoot = path.Join(target.DataRoot, "experiments", filepath.Base(localDir))
+	} else {
+		target.DataRoot = localDir
+	}
+	return target, nil
+}
