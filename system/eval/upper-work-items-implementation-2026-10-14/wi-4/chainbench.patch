+++ b/internal/app/experiment_input.go
@@ -0,0 +1,72 @@
+package app
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+)
+
+// DecodeExperimentInput rejects duplicate fields, trailing documents, unknown
+// fields and unbounded input before composition can allocate any resources.
+func DecodeExperimentInput(raw []byte) (ExperimentIn, error) {
+	var in ExperimentIn
+	if len(raw) > 256_000 {
+		return in, fmt.Errorf("experiment input exceeds 256KB")
+	}
+	tokens := json.NewDecoder(bytes.NewReader(raw))
+	if e := experimentJSONValue(tokens, 0); e != nil {
+		return in, e
+	}
+	if _, e := tokens.Token(); e != io.EOF {
+		return in, fmt.Errorf("exactly one JSON input document required")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	err := decoder.Decode(&in)
+	return in, err
+}
+func experimentJSONValue(d *json.Decoder, depth int) error {
+	if depth > 64 {
+		return fmt.Errorf("experiment input nesting exceeds 64")
+	}
+	token, e := d.Token()
+	if e != nil {
+		return e
+	}
+	delimiter, ok := token.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delimiter {
+	case '{':
+		seen := map[string]bool{}
+		for d.More() {
+			key, e := d.Token()
+			if e != nil {
+				return e
+			}
+			name, ok := key.(string)
+			if !ok {
+				return fmt.Errorf("object key required")
+			}
+			if seen[name] {
+				return fmt.Errorf("duplicate experiment input field %q", name)
+			}
+			seen[name] = true
+			if e = experimentJSONValue(d, depth+1); e != nil {
+				return e
+			}
+		}
+	case '[':
+		for d.More() {
+			if e = experimentJSONValue(d, depth+1); e != nil {
+				return e
+			}
+		}
+	default:
+		return fmt.Errorf("unexpected JSON delimiter")
+	}
+	_, e = d.Token()
+	return e
+}
