diff --git a/cmd/chainbench/parent_death_test.go b/cmd/chainbench/parent_death_test.go
new file mode 100644
index 00000000..b429e214
--- /dev/null
+++ b/cmd/chainbench/parent_death_test.go
@@ -0,0 +1,74 @@
+package main
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// Exercise the real parent-watch path with actual standard pipes whose reader
+// disappears. A successful cancellation marker must survive its diagnostic
+// write to that broken pipe; process intent alone is not cleanup evidence.
+func TestParentDeathCancelsDespiteClosedStandardPipes(t *testing.T) {
+	mode := os.Getenv("CHAINBENCH_TEST_PARENT_MODE")
+	marker := os.Getenv("CHAINBENCH_TEST_PARENT_MARKER")
+	switch mode {
+	case "worker":
+		ctx, stop := interruptible(os.Stderr)
+		defer stop()
+		// Before the fix the watcher acquired its parent asynchronously. Allow the
+		// goroutine to start so this also isolates broken-pipe behavior on old code.
+		time.Sleep(100 * time.Millisecond)
+		if e := os.WriteFile(marker+".ready", []byte("ready"), 0600); e != nil {
+			t.Fatal(e)
+		}
+		select {
+		case <-ctx.Done():
+			if e := os.WriteFile(marker, []byte("canceled"), 0600); e != nil {
+				t.Fatal(e)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("parent death did not cancel")
+		}
+		return
+	case "parent":
+		command := exec.Command(os.Args[0], "-test.run=^TestParentDeathCancelsDespiteClosedStandardPipes$")
+		command.Env = append(os.Environ(), "CHAINBENCH_TEST_PARENT_MODE=worker")
+		if _, e := command.StdoutPipe(); e != nil {
+			t.Fatal(e)
+		}
+		if _, e := command.StderrPipe(); e != nil {
+			t.Fatal(e)
+		}
+		if e := command.Start(); e != nil {
+			t.Fatal(e)
+		}
+		deadline := time.Now().Add(4 * time.Second)
+		for time.Now().Before(deadline) {
+			if _, e := os.Stat(marker + ".ready"); e == nil {
+				os.Exit(0)
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		t.Fatal("owned worker not ready")
+	}
+	marker = filepath.Join(t.TempDir(), "canceled")
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestParentDeathCancelsDespiteClosedStandardPipes$")
+	command.Env = append(os.Environ(), "CHAINBENCH_TEST_PARENT_MODE=parent", "CHAINBENCH_TEST_PARENT_MARKER="+marker, stopWithParentEnv+"=1")
+	if raw, e := command.CombinedOutput(); e != nil {
+		t.Fatalf("owned parent: %v %s", e, raw)
+	}
+	deadline := time.Now().Add(6 * time.Second)
+	for time.Now().Before(deadline) {
+		if raw, e := os.ReadFile(marker); e == nil && string(raw) == "canceled" {
+			return
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	t.Fatal("parent watch terminated on the closed pipe before cancellation completed")
+}
