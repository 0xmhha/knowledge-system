+)
+
+func receiptFixture(t *testing.T, s *trialSession) {
+	t.Helper()
+	d := &dslTrial{}
+	for _, a := range append([]AssertionObservation{s.observation.Symptom}, s.observation.Controls...) {
+		hash, e := d.receipt("assertion", session.AssertResult{ID: a.ID, Pass: a.Pass})
+		if e != nil {
+			t.Fatal(e)
+		}
+		if a.ID == s.observation.Symptom.ID {
+			s.observation.Symptom.ReceiptSHA256 = hash
+		} else {
+			for i := range s.observation.Controls {
+				if s.observation.Controls[i].ID == a.ID {
+					s.observation.Controls[i].ReceiptSHA256 = hash
+				}
+			}
+		}
+	}
+	inj := *s.observation.Injection
+	inj.ReceiptSHA256 = ""
+	hash, e := d.receipt("injection", struct {
+		Injection InjectionObservation
+		Schedule  Schedule
+		Lease     string
+	}{inj, s.request.Schedule, s.identity.LeaseID})
+	if e != nil {
+		t.Fatal(e)
+	}
+	s.observation.Injection.ReceiptSHA256 = hash
+	s.observation.Receipts = d.receipts
+}
+func TestReportVerifierRejectsTamperingAndPreservesJSONRoundTrip(t *testing.T) {
+	report := runExperiment(t, frozenPlan(), &trialFactory{edit: func(s *trialSession) { receiptFixture(t, s) }})
+	raw, e := json.MarshalIndent(report, "", "  ")
+	if e != nil {
+		t.Fatal(e)
+	}
+	var roundtrip Report
+	if e = json.Unmarshal(raw, &roundtrip); e != nil {
+		t.Fatal(e)
+	}
+	if e = VerifyDSLReport(roundtrip); e != nil {
+		t.Fatal("persisted receipt verification", e)
+	}
+	for _, mode := range []string{"denominator", "verdict", "acceptance", "schedule", "receipt", "missing", "assertion", "ownership"} {
+		t.Run(mode, func(t *testing.T) {
+			var r Report
+			_ = json.Unmarshal(raw, &r)
+			switch mode {
+			case "denominator":
+				r.Before.Completed++
+			case "verdict":
+				r.Verdict = "REPRODUCED"
+			case "acceptance":
+				r.Acceptance = "accepted"
+			case "schedule":
+				r.Trials[0].Schedule.DelayMS++
+			case "receipt":
+				r.Trials[0].Observation.Receipts[0].Body = json.RawMessage(`{}`)
+			case "missing":
+				r.Trials[0].Observation.Receipts = nil
+			case "assertion":
+				r.Trials[0].Observation.Symptom.Pass = true
+			case "ownership":
+				r.Trials[0].CleanupOK = false
+			}
+			if e = VerifyDSLReport(r); e == nil {
+				t.Fatal("changed report accepted")
+			}
+		})
+	}
+}
+func TestDriverDigestIgnoresOnlyInsignificantJSONWhitespace(t *testing.T) {
+	a, e := DSLDriverDigest([]byte(`{"id":"probe","steps":["a b"]}`))
+	if e != nil {
+		t.Fatal(e)
+	}
+	b, _ := DSLDriverDigest([]byte("{\n \"steps\": [\"a b\"], \"id\": \"probe\"\n}"))
+	c, _ := DSLDriverDigest([]byte(`{"id":"probe","steps":["ab"]}`))
+	if a != b || a == c {
+		t.Fatal("driver pin lost significant contents or included formatting")
+	}
+}
