+import "testing"
+
+func TestFreshTrialTargetsKeepUniqueOwnershipRoots(t *testing.T) {
+	local, e := FreshTrialTarget(Spec{DataRoot: "/existing/network"}, "/tmp/trial-a")
+	if e != nil || local.DataRoot != "/tmp/trial-a" {
+		t.Fatal(local, e)
+	}
+	remote, e := FreshTrialTarget(Spec{Server: "accepted-server", DataRoot: "/accepted/parent"}, "/tmp/trial-a")
+	if e != nil || remote.DataRoot != "/accepted/parent/experiments/trial-a" || remote.Server != "accepted-server" {
+		t.Fatal(remote, e)
+	}
+	other, e := FreshTrialTarget(remote, "/tmp/trial-b")
+	if e != nil || other.DataRoot == remote.DataRoot {
+		t.Fatal("physical ownership root reused")
+	}
+	if _, e = FreshTrialTarget(Spec{Server: "accepted-server"}, "/tmp/trial-a"); e == nil {
+		t.Fatal("remote parent inferred without acceptance")
+	}
+}
