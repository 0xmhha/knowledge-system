+	"github.com/0xmhha/chainbench/internal/dsl/interp"
+	"github.com/0xmhha/chainbench/internal/testhelper"
+)
+
+type readLease struct {
+	identity SessionIdentity
+	env      session.Environment
+	deps     interp.Deps
+}
+
+func (l *readLease) Identity(context.Context) (SessionIdentity, error) { return l.identity, nil }
+func (l *readLease) Environment() interp.NodeTable                     { return l.env }
+func (l *readLease) Dependencies() interp.Deps                         { return l.deps }
+func (l *readLease) Close(context.Context) error                       { return nil }
+func TestReadOnlyDSLActuallyWatchesUntilRecurrenceOrWindow(t *testing.T) {
+	for _, mode := range []string{"recurrence", "window", "rpc_error", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			var started time.Time
+			var once sync.Once
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				once.Do(func() { started = time.Now() })
+				var q struct {
+					ID     any
+					Method string
+				}
+				_ = json.NewDecoder(r.Body).Decode(&q)
+				value := "0x1"
+				if q.Method == "eth_blockNumber" {
+					value = "0x0"
+					if mode == "recurrence" && time.Since(started) > 100*time.Millisecond {
+						value = "0x1"
+					}
+				}
+				body := map[string]any{"jsonrpc": "2.0", "id": q.ID, "result": value}
+				if mode == "rpc_error" && q.Method == "eth_blockNumber" {
+					delete(body, "result")
+					body["error"] = map[string]any{"code": -32000, "message": "owned transport failure"}
+				}
+				_ = json.NewEncoder(w).Encode(body)
+			}))
+			defer server.Close()
+			raw := []byte(`{"schemaVersion":"1","id":"monitor","chain":{"name":"owned-fixture","binary":"pinned"},"assertions":[{"assert":"blockNumber","on":"node1","compare":"Equal","expected":"0"},{"assert":"chainId","on":"node1","expected":"1"}]}`)
+			spec, e := dsl.Parse(raw)
+			if e != nil {
+				t.Fatal(e)
+			}
+			sess, e := session.New(filepath.Join(t.TempDir(), "artifacts"), "observation", time.Now().UTC())
+			if e != nil {
+				t.Fatal(e)
+			}
+			env, e := sess.NewEnvironment("readonly")
+			if e != nil {
+				t.Fatal(e)
+			}
+			env.PopulateNodeTable(node.NodeSet{Nodes: []node.Node{{Index: 1, RPCURL: server.URL}}})
+			source := frozenPlan().Before
+			lease := &readLease{identity: SessionIdentity{Source: source, LeaseID: "read-only", ReadOnly: true}, env: env, deps: interp.Deps{RPC: func(u string) *rpc.Client { return rpc.Dial(u) }, Actions: testhelper.Registry()}}
+			request := TrialRequest{Mode: "observation", Source: source, AssertionID: "monitor/assert/0", NormalAssertionIDs: []string{"monitor/assert/1"}, Resume: &ResumeTrigger{Event: "designated_failure", AssertionID: "monitor/assert/0", WindowSeconds: 1}, ObservationWindow: time.Second}
+			trial := &dslTrial{request: request, spec: spec, lease: lease}
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			if mode == "cancel" {
+				cancel()
+			}
+			out, e := trial.Run(ctx)
+			switch mode {
+			case "rpc_error", "cancel":
+				if e == nil {
+					t.Fatal("infra/cancel masqueraded as monitor success")
+				}
+				if len(out.Events) != 0 {
+					t.Fatal("infra emitted recurrence")
+				}
+			case "recurrence":
+				if e != nil || len(out.Events) != 1 || out.Symptom.Pass || out.Polls < 2 || out.WatchedSeconds < .4 {
+					t.Fatalf("polls=%d watched=%f events=%d pass=%v error=%v", out.Polls, out.WatchedSeconds, len(out.Events), out.Symptom.Pass, e)
+				}
+			case "window":
+				if e != nil || len(out.Events) != 0 || !out.Symptom.Pass || out.WatchedSeconds < 1 || out.Polls < 2 {
+					t.Fatalf("polls=%d watched=%f events=%d pass=%v error=%v", out.Polls, out.WatchedSeconds, len(out.Events), out.Symptom.Pass, e)
+				}
+			}
+			if e == nil {
+				tr := Trial{Identity: &lease.identity, Schedule: request.Schedule, Observation: &out}
+				if e = verifyDSLReceipts(tr); e != nil {
+					t.Fatal(e)
+				}
+				out.Receipts[0].Body = json.RawMessage(`{}`)
+				if e = verifyDSLReceipts(tr); e == nil {
+					t.Fatal("changed raw receipt accepted")
+				}
+			}
+		})
+	}
+}
