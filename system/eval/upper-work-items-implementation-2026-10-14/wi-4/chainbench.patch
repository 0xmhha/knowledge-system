@@ -0,0 +1,449 @@
+package testengine
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/0xmhha/chainbench/internal/accounts"
+	"github.com/0xmhha/chainbench/internal/chainsetup"
+	"github.com/0xmhha/chainbench/internal/chainsetup/verb"
+	"github.com/0xmhha/chainbench/internal/core/process"
+	"github.com/0xmhha/chainbench/internal/core/rpc"
+	"github.com/0xmhha/chainbench/internal/core/session"
+	"github.com/0xmhha/chainbench/internal/dsl"
+	"github.com/0xmhha/chainbench/internal/dsl/interp"
+	"github.com/0xmhha/chainbench/internal/experiment"
+	"github.com/0xmhha/chainbench/internal/resource"
+	"github.com/0xmhha/chainbench/internal/testhelper"
+)
+
+type ExperimentIn struct {
+	Plan                     experiment.Plan   `json:"plan"`
+	Case                     json.RawMessage   `json:"case"`
+	BinaryByCommit           map[string]string `json:"binary_by_commit"`
+	ArtifactRoot             string            `json:"artifact_root"`
+	AssetsSHA256             map[string]string `json:"assets_sha256,omitempty"`
+	ObserveCompositionSHA256 string            `json:"observe_composition_sha256,omitempty"`
+	ObserveWorkspace         string            `json:"observe_workspace,omitempty"`
+}
+
+// ExperimentEnvironmentDigest freezes the declared environment, independent of
+// per-trial workspace/port allocation and before/after binary locations. The
+// raw complete DSL remains separately pinned as the driver.
+func ExperimentEnvironmentDigest(raw []byte, assets ...map[string]string) (string, error) {
+	s, e := dsl.Parse(raw)
+	if e != nil {
+		return "", e
+	}
+	s.ID = "environment"
+	s.Steps = nil
+	s.Assertions = nil
+	s.Sequence = nil
+	s.PreActions = nil
+	s.PostActions = nil
+	s.OnFailActions = nil
+	s.Chain.Binary = "$subject"
+	s.Chain.Binaries = nil
+	encoded, e := json.Marshal(struct {
+		Version   string
+		Spec      dsl.Spec
+		Blueprint string
+		Launch    map[string][]string
+		Config    map[string][]string
+		Peering   string
+		Accounts  map[string]dsl.AccountV2
+	}{"chainbench-environment-v1", s, s.EnvBlueprint, s.EnvLaunch, s.EnvConfig, s.EnvPeering, s.EnvAccounts})
+	if e != nil {
+		return "", e
+	}
+	pins := map[string]string{}
+	if len(assets) > 0 {
+		pins = assets[0]
+	}
+	encoded, e = json.Marshal(struct {
+		Environment json.RawMessage
+		Assets      map[string]string
+		KeyPolicy   string
+	}{encoded, pins, "generated trial-owned keys"})
+	if e != nil {
+		return "", e
+	}
+	sum := sha256.Sum256(encoded)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+// RunExperiment reaches the same composition owner, readiness gate, node
+// control and registered DSL interpreter as RunSuite. A fresh root cannot
+// reuse a caller's already-running network. Observation takes no node control.
+func RunExperiment(ctx context.Context, sd chainsetup.Deps, in ExperimentIn) (experiment.Report, error) {
+	// Freeze nested caller-owned maps and pointers before any resource work.
+	encoded, e := json.Marshal(in)
+	if e != nil {
+		return experiment.Report{}, e
+	}
+	var owned ExperimentIn
+	if e = json.Unmarshal(encoded, &owned); e != nil {
+		return experiment.Report{}, e
+	}
+	in = owned
+	if e := in.Plan.Validate(); e != nil {
+		return experiment.Report{}, e
+	}
+	if e := verifyExperimentAssets(in.Case, in.AssetsSHA256); e != nil {
+		return experiment.Report{}, e
+	}
+	digest, e := ExperimentEnvironmentDigest(in.Case, in.AssetsSHA256)
+	if e != nil {
+		return experiment.Report{}, e
+	}
+	if digest != in.Plan.Before.EnvironmentSHA256 {
+		return experiment.Report{}, fmt.Errorf("frozen environment differs")
+	}
+	if in.Plan.Mode != "observation" && in.ObserveCompositionSHA256 != "" {
+		return experiment.Report{}, fmt.Errorf("composition pin is only for observation")
+	}
+	if in.Plan.Mode == "observation" && len(in.ObserveCompositionSHA256) != 64 {
+		return experiment.Report{}, fmt.Errorf("observation requires a frozen actual composition digest")
+	}
+	if (in.Plan.Mode == "observation") != (in.ObserveWorkspace != "") {
+		return experiment.Report{}, fmt.Errorf("observation requires an explicit existing workspace; other modes cannot adopt it")
+	}
+	if in.ArtifactRoot == "" {
+		return experiment.Report{}, fmt.Errorf("fresh artifact_root is required")
+	}
+	// Refuse reuse before creating nodes. Every trial directory is allocated by
+	// this invocation beneath this root; it cannot be supplied as an owned lease.
+	if e = os.Mkdir(in.ArtifactRoot, 0700); e != nil {
+		return experiment.Report{}, fmt.Errorf("artifact root must be new: %w", e)
+	}
+	if e = writeExperimentJSON(filepath.Join(in.ArtifactRoot, "input.json"), in); e != nil {
+		return experiment.Report{}, e
+	}
+	factory := &experiment.DSLFactory{Case: append([]byte(nil), in.Case...), BinaryByCommit: in.BinaryByCommit}
+	factory.OpenLease = func(ctx context.Context, r experiment.TrialRequest, binary string) (experiment.DSLLease, error) {
+		dir, e := os.MkdirTemp(in.ArtifactRoot, "trial-")
+		if e != nil {
+			return nil, e
+		}
+		if e := verifyExperimentAssets(in.Case, in.AssetsSHA256); e != nil {
+			return nil, e
+		}
+		lease := &experimentLease{sd: sd, request: r, dir: dir, workspace: dir, caseRaw: in.Case, environmentDigest: digest, assets: in.AssetsSHA256, binary: binary, compositionDigest: in.ObserveCompositionSHA256}
+		if r.Mode == "observation" {
+			lease.workspace = in.ObserveWorkspace
+			lease.readOnly = true
+		}
+		if !lease.readOnly {
+			inputs := RunSuiteIn{DataDir: dir, SpecContent: [][]byte{in.Case}, Binary: binary, KeysSource: "generate", ArtifactRoot: filepath.Join(dir, "artifacts")}
+			_, parsed, comp, e := resolveComposition(ctx, inputs)
+			if e != nil {
+				return lease, e
+			}
+			if comp.up == nil || parsed[0].EnvAttach != nil || len(parsed[0].Chain.Binaries) > 0 || parsed[0].EnvUpgrade != nil {
+				return lease, fmt.Errorf("experiment requires a composed single-binary network")
+			}
+			// Fresh physical data as well as a fresh control-plane directory.
+			// A remote target needs its own ownership allocation, never a reused
+			// path merely claimed by this JSON request.
+			comp.up.Target, e = resource.FreshTrialTarget(comp.up.Target, dir)
+			if e != nil {
+				return lease, e
+			}
+			lease.chain = parsed[0].Chain.Name
+			// The ordinary composition implementation creates and records the network;
+			// cleanup retains this workspace handle even on a partial bring-up failure.
+			var out RunSuiteOut
+			gateBudget := 30 * time.Second
+			if deadline, ok := ctx.Deadline(); ok {
+				if remaining := time.Until(deadline) / 2; remaining < gateBudget {
+					gateBudget = remaining
+				}
+			}
+			lease.net, e = composeWorkspace(ctx, sd, *comp.up, &out, gateBudget)
+			if e != nil {
+				return lease, e
+			}
+			if e = prepareChain(ctx, sd, inputs, comp, parsed, &lease.net, &out); e != nil {
+				return lease, e
+			}
+		} else {
+			state, e := verb.ChainStatus(ctx, sd, verb.ChainStatusIn{DataDir: lease.workspace})
+			if e != nil {
+				return lease, e
+			}
+			lease.chain = state.State.Chain
+			spec, e := dsl.Parse(in.Case)
+			if e != nil {
+				return lease, e
+			}
+			if spec.Chain.Name != lease.chain {
+				return lease, fmt.Errorf("actual observation chain differs from DSL")
+			}
+			// Observation never calls the readiness gate: that gate can restart nodes.
+			status, e := verb.NetworkStatus(ctx, sd, verb.NetworkStatusIn{DataDir: lease.workspace})
+			if e != nil {
+				return lease, e
+			}
+			lease.net.nodes = &status.Nodes
+		}
+		if lease.net.nodes == nil || len(lease.net.nodes.Nodes) == 0 {
+			return lease, fmt.Errorf("composed node table unavailable")
+		}
+		sess, e := session.New(filepath.Join(dir, "artifacts"), "frozen experiment", time.Now().UTC())
+		if e != nil {
+			return lease, e
+		}
+		env, e := sess.NewEnvironment(session.Fingerprint(digest))
+		if e != nil {
+			return lease, e
+		}
+		env.PopulateNodeTable(*lease.net.nodes)
+		lease.env = env
+		deps, e := experimentInterpreterDeps(lease.chain, lease.net, lease.readOnly)
+		if e != nil {
+			return lease, e
+		}
+		if lease.readOnly {
+			deps.Nodes = nil
+			deps.Keys = nil
+		}
+		lease.deps = deps
+		return lease, nil
+	}
+	report, runErr := experiment.RunInvestigation(ctx, in.Plan, factory)
+	if runErr != nil {
+		return report, runErr
+	}
+	if e = verifyExperimentAssets(in.Case, in.AssetsSHA256); e != nil {
+		return experiment.Report{}, e
+	}
+	if e = experiment.VerifyDSLReport(report); e != nil {
+		return report, fmt.Errorf("report evidence consistency: %w", e)
+	}
+	if e = writeExperimentJSON(filepath.Join(in.ArtifactRoot, "report.json"), report); e != nil {
+		return report, e
+	}
+	return report, nil
+}
+
+// experimentInterpreterDeps follows the existing attach wiring; accounts and keys are owned
+// by the composition, not reconstructed from a model-generated claim.
+func experimentInterpreterDeps(chain string, net composed, readOnly bool) (interp.Deps, error) {
+	accts, e := accounts.ForChain(chain)
+	if e != nil {
+		return interp.Deps{}, e
+	}
+	if readOnly {
+		return interp.Deps{RPC: func(u string) *rpc.Client { return rpc.Dial(u) }, Actions: testhelper.Registry(), Accounts: accts, Contracts: chainContracts(chain), Validators: chainValidators(chain)}, nil
+	}
+	keys, e := ringForOutput(net.keysDir, "")
+	if e != nil {
+		return interp.Deps{}, e
+	}
+	if net.ring != nil {
+		keys = net.ring
+	}
+	return interp.Deps{RPC: func(u string) *rpc.Client { return rpc.Dial(u) }, Actions: testhelper.Registry(), Accounts: accts, Keys: keys, Nodes: net.control, Contracts: chainContracts(chain), Validators: chainValidators(chain)}, nil
+}
+
+type experimentLease struct {
+	sd                        chainsetup.Deps
+	request                   experiment.TrialRequest
+	dir, workspace, chain     string
+	caseRaw                   []byte
+	environmentDigest         string
+	assets                    map[string]string
+	binary, compositionDigest string
+	readOnly                  bool
+	net                       composed
+	env                       session.Environment
+	deps                      interp.Deps
+}
+
+func (l *experimentLease) Environment() interp.NodeTable { return l.env }
+func (l *experimentLease) Dependencies() interp.Deps     { return l.deps }
+func (l *experimentLease) Identity(ctx context.Context) (experiment.SessionIdentity, error) {
+	id := experiment.SessionIdentity{Source: l.request.Source, LeaseID: filepath.Base(l.dir), ReadOnly: l.readOnly, OwnedNodeIDs: []string{}}
+	if e := verifyExperimentAssets(l.caseRaw, l.assets); e != nil {
+		return id, e
+	}
+	digest, e := ExperimentEnvironmentDigest(l.caseRaw, l.assets)
+	if e != nil || digest != l.environmentDigest {
+		return id, fmt.Errorf("declared environment changed")
+	}
+	status, e := verb.ChainStatus(ctx, l.sd, verb.ChainStatusIn{DataDir: l.workspace})
+	if e != nil {
+		return id, e
+	}
+	if status.State.Binary != l.binary {
+		return id, fmt.Errorf("actual composed binary differs from frozen subject")
+	}
+	if l.readOnly {
+		digest, e := ExperimentCompositionDigest(ctx, l.sd, l.workspace)
+		if e != nil {
+			return id, e
+		}
+		if digest != l.compositionDigest {
+			return id, fmt.Errorf("actual observation composition changed")
+		}
+	}
+	pins, e := verb.ChainRuntimePins(ctx, l.sd, verb.ChainObserveIn{DataDir: l.workspace})
+	if e != nil {
+		return id, e
+	}
+	for path, digest := range pins {
+		if strings.HasSuffix(path, "/binary") && digest != "sha256:"+l.request.Source.BinarySHA256 {
+			return id, fmt.Errorf("actual node executable bytes differ from frozen source")
+		}
+	}
+	raw, e := json.Marshal(pins)
+	if e != nil {
+		return id, e
+	}
+	runtime := sha256.Sum256(raw)
+	id.RuntimeSHA256 = hex.EncodeToString(runtime[:])
+	observations, e := verb.ChainObserve(ctx, l.sd, verb.ChainObserveIn{DataDir: l.workspace})
+	if e != nil {
+		return id, e
+	}
+	for _, n := range observations.Nodes {
+		if n.State != process.OwnedRunning || n.Executable != "ready" {
+			return id, fmt.Errorf("node%d recorded launch not verified: %s", n.Index, n.State)
+		}
+		id.OwnedNodeIDs = append(id.OwnedNodeIDs, fmt.Sprintf("node%d", n.Index))
+	}
+	sort.Strings(id.OwnedNodeIDs)
+	return id, nil
+}
+func (l *experimentLease) Close(ctx context.Context) error {
+	if l.readOnly {
+		return nil
+	}
+	// A parse refusal before any composition record created owns no processes.
+	if _, e := verb.ChainStatus(ctx, l.sd, verb.ChainStatusIn{DataDir: l.workspace}); e != nil {
+		entries, readErr := os.ReadDir(l.workspace)
+		if readErr == nil && len(entries) == 0 {
+			return nil
+		}
+		return fmt.Errorf("cleanup ownership record unavailable: %w", e)
+	}
+	if _, e := verb.ChainStop(ctx, l.sd, verb.ChainStopIn{DataDir: l.workspace}); e != nil {
+		return e
+	}
+	observations, e := verb.ChainObserve(ctx, l.sd, verb.ChainObserveIn{DataDir: l.workspace})
+	if e != nil {
+		return e
+	}
+	for _, n := range observations.Nodes {
+		if n.State != process.OwnedStopped && n.State != process.OwnedMissing {
+			return fmt.Errorf("owned cleanup unresolved for node%d: %s", n.Index, n.State)
+		}
+	}
+	return nil
+}
+
+func verifyExperimentAssets(raw []byte, pins map[string]string) error {
+	s, e := dsl.Parse(raw)
+	if e != nil {
+		return e
+	}
+	refs := []string{s.Chain.Config, s.Chain.ManifestPath, s.Chain.TemplatePath, s.Chain.GenesisExisting, s.EnvBlueprint}
+	if s.EnvKeys != nil && s.EnvKeys.Ref != "" {
+		return fmt.Errorf("experiment uses generated trial-owned keys; external key sets require a separately pinned owner")
+	}
+	for _, ref := range refs {
+		if ref != "" && pins[ref] == "" {
+			return fmt.Errorf("external environment asset must be pinned: %s", ref)
+		}
+	}
+	for path, want := range pins {
+		if len(want) != 64 {
+			return fmt.Errorf("invalid asset digest")
+		}
+		f, e := os.Open(path)
+		if e != nil {
+			return e
+		}
+		info, e := f.Stat()
+		if e != nil || !info.Mode().IsRegular() {
+			_ = f.Close()
+			return fmt.Errorf("asset must be a regular file")
+		}
+		h := sha256.New()
+		_, e = io.Copy(h, f)
+		closeErr := f.Close()
+		if e != nil {
+			return e
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+		if hex.EncodeToString(h.Sum(nil)) != want {
+			return fmt.Errorf("external environment asset changed: %s", path)
+		}
+	}
+	return nil
+}
+
+// A interrupted write cannot leave a partial document under the final name.
+func writeExperimentJSON(path string, value any) error {
+	raw, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(filepath.Dir(path), ".experiment-")
+	if err != nil {
+		return err
+	}
+	temp := file.Name()
+	defer func() { _ = os.Remove(temp) }()
+	if err = file.Chmod(0600); err == nil {
+		_, err = file.Write(append(raw, '\n'))
+	}
+	if err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	return os.Rename(temp, path)
+}
+
+// ExperimentCompositionDigest freezes the existing owner's persisted snapshot.
+// It records actual configuration, launch inputs, placements and runtime PIDs;
+// the read-only observer refuses to attach to a merely claimed environment.
+func ExperimentCompositionDigest(ctx context.Context, sd chainsetup.Deps, workspace string) (string, error) {
+	info, e := os.Stat(workspace)
+	if e != nil {
+		return "", e
+	}
+	if !info.IsDir() {
+		return "", fmt.Errorf("existing composition directory required")
+	}
+	status, e := verb.ChainStatus(ctx, sd, verb.ChainStatusIn{DataDir: workspace})
+	if e != nil {
+		return "", e
+	}
+	if status.State.CompositionID == "" || status.State.Chain == "" || len(status.State.Nodes) == 0 {
+		return "", fmt.Errorf("existing composed owner record required")
+	}
+	raw, e := json.Marshal(status.State)
+	if e != nil {
+		return "", e
+	}
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:]), nil
+}
