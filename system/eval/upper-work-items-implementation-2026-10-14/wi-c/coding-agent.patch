diff --git a/plugin/scripts/tests/test_deep_review.py b/plugin/scripts/tests/test_deep_review.py
new file mode 100644
index 0000000..cc34068
--- /dev/null
+++ b/plugin/scripts/tests/test_deep_review.py
@@ -0,0 +1,94 @@
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT=Path(__file__).resolve().parents[2]
+spec=importlib.util.spec_from_file_location('deep_review',ROOT/'scripts/deep_review.py');review=importlib.util.module_from_spec(spec);spec.loader.exec_module(review)
+FIXTURE=Path(__file__).parent/'fixtures'
+def bundle():return json.loads((FIXTURE/'deep-review-bundle.json').read_text())
+def judgments():return json.loads((FIXTURE/'deep-review-judgments.json').read_text())
+class DeepReviewTests(unittest.TestCase):
+ def test_actual_source_shape_and_inferred_unknown_split(self):
+  b=bundle();report=review.build(b,judgments());review.validate(report,b)
+  self.assertEqual(report['computed']['origin'],'graph_computation');self.assertEqual(report['reasoning']['sections']['resources']['status'],'unknown');self.assertEqual(report['structural_review']['snapshot_association'],'identity_only_unverified_snapshot');self.assertEqual(report['independent_acceptance'],'not_recorded')
+  self.assertIn('flowchart TD',review.sequence_diagram(report));self.assertIn('unknown, not computed',review.module_diagram(report))
+ def test_canonical_hash_is_stable(self):
+  b=bundle();reordered=json.loads(json.dumps(b,sort_keys=True));self.assertEqual(review.build(b,judgments()),review.build(reordered,judgments()))
+ def test_missing_required_dimensions_and_all_unknown_placeholder_rejected(self):
+  j=judgments();j['sections'].pop('io')
+  with self.assertRaises(review.Invalid):review.build(bundle(),j)
+  j=judgments()
+  for section in j['sections'].values():section.update(status='unknown',unknowns=['not reviewed'])
+  with self.assertRaises(review.Invalid):review.build(bundle(),j)
+ def test_reasoning_needs_original_evidence_and_assumptions(self):
+  for field,value in [('evidence_nodes',[]),('evidence_nodes',['foreign']),('assumptions',[])]:
+   j=judgments();j['sections']['guards_exceptions'][field]=value
+   with self.assertRaises(review.Invalid):review.build(bundle(),j)
+ def test_empty_unknown_and_false_observation_rejected(self):
+  for change in ['missing_reason','observed']:
+   j=judgments();section=j['sections']['resources'];section['unknowns']=[] if change=='missing_reason'else['unknown'];section['status']='observed'if change=='observed'else'unknown'
+   with self.assertRaises(review.Invalid):review.build(bundle(),j)
+ def test_findings_cannot_be_confirmed_vulnerabilities(self):
+  for field,value in [('state','confirmed'),('origin','graph_computation'),('evidence_nodes',['foreign']),('rule_candidates',['foreign'])]:
+   j=judgments();j['findings'][0][field]=value
+   with self.assertRaises(review.Invalid):review.build(bundle(),j)
+ def test_unknown_section_cannot_cover_criterion(self):
+  j=judgments();j['criteria'][1]['status']='covered'
+  with self.assertRaises(review.Invalid):review.build(bundle(),j)
+ def test_foreign_source_identity_snapshot_and_private_paths_rejected(self):
+  for field,value in [('node_id','foreign'),('commit','main'),('snapshot_sha256','0'*64),('file','.claude/session.go'),('file','logs/session.go'),('file','../source.go')]:
+   b=bundle();b['rules']['result']['analysis']['source'][field]=value
+   with self.assertRaises(review.Invalid):review.build(b,judgments())
+ def test_other_structural_symbol_and_missing_pin_not_borrowed(self):
+  b=bundle();b['function_review']['result']['seed']['id']='foreign'
+  with self.assertRaises(review.Invalid):review.build(b,judgments())
+  b=bundle();r=review.build(b,judgments());self.assertEqual(r['structural_review']['snapshot_association'],'identity_only_unverified_snapshot')
+ def test_unsupported_truncated_unknown_pack_and_bound_rejected(self):
+  for change in ['truncated','base','rules','pack','bound']:
+   b=bundle()
+   if change=='truncated':b['rules']['result']['analysis']['truncated']=True
+   if change=='base':b['rules']['result']['status']='unsupported'
+   if change=='rules':b['rules']['result']['analysis']['rules']['status']='incomplete'
+   if change=='pack':b['rules']['arguments']['rule_pack']='latest'
+   if change=='bound':b['rules']['arguments']['max_flow_steps']=0
+   with self.assertRaises(review.Invalid):review.build(b,judgments())
+ def test_foreign_edges_and_outside_source_positions_rejected(self):
+  b=bundle();b['rules']['result']['analysis']['edges'][0]['to']='outside'
