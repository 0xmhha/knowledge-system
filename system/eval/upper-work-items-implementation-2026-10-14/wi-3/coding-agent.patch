+{
+  "providers": {
+    "cks": {
+      "server": "cks",
+      "namespace": "cks.",
+      "tools": {
+        "cks_context_change_history": {
+          "owner": "cks",
+          "wire_name": "cks.context.change_history",
+          "description": "Modification history for a symbol or intent: PR refs (provenance) and BM25-ranked diff hunks. Use AFTER traversal or reproduction has implicated a site -- anchoring history on an unverified hypothesis amplifies confirmation bias (history 'evidence' for the wrong suspect reads convincing).",
+          "input": {
+            "properties": {
+              "intent": {
+                "description": "Natural-language query the hunks should match against (optional if symbol is set).",
+                "type": "string"
+              },
+              "k": {
+                "description": "Maximum hunks to return when intent is set (0 = backend default).",
+                "type": "number"
+              },
+              "max_count": {
+                "description": "Maximum PR refs to return when symbol is set (0 = no cap).",
+                "type": "number"
+              },
+              "symbol": {
+                "description": "Fully-qualified symbol name to look up PR refs for (optional if intent is set).",
+                "type": "string"
+              }
+            },
+            "required": [],
+            "type": "object"
+          }
+        },
+        "cks_context_concurrency_impact": {
+          "owner": "cks",
+          "wire_name": "cks.context.concurrency_impact",
+          "description": "Concurrency blast radius of a symbol: goroutines it spawns, channels it sends to/receives from, locks it acquires, plus modules reached over concurrency edges. Use when a change touches shared state or ordering -- before assuming a data race is or is not possible.",
+          "input": {
+            "properties": {
+              "depth": {
+                "description": "Maximum traversal depth over concurrency edges (default: 3).",
+                "type": "number"
+              },
+              "max_total": {
+                "description": "Cap on total modules returned (0 = no cap).",
+                "type": "number"
+              },
+              "symbol": {
+                "description": "Symbol to seed the analysis: a ckg qualified_name, a bare name (only when it resolves unambiguously), or a ckg canonical_id. An ambiguous or unknown name is an error, not an empty result -- use find_symbol to get the canonical_id.",
+                "type": "string"
+              }
+            },
+            "required": [
+              "symbol"
+            ],
+            "type": "object"
+          }
+        },
+        "cks_context_expand_flow": {
+          "owner": "cks",
+          "wire_name": "cks.context.expand_flow",
