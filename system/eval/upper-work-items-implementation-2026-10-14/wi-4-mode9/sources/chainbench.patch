+++ b/internal/chainsetup/log_window.go
@@ -0,0 +1,33 @@
+package chainsetup
+
+import (
+	"context"
+	"fmt"
+	"github.com/0xmhha/chainbench/internal/resource"
+)
+
+// LogWindow reads a bounded immutable snapshot of one recorded node's log via
+// the same opener that owns its actual machine. The caller supplies no path.
+func (w *Workspace) LogWindow(ctx context.Context, index, limit int) (resource.LogSnapshot, error) {
+	if e := w.allow("LogWindow"); e != nil {
+		return resource.LogSnapshot{}, e
+	}
+	for _, node := range w.state.Nodes {
+		if node.Index != index {
+			continue
+		}
+		access, e := w.machineFor(node)
+		if e != nil {
+			return resource.LogSnapshot{}, e
+		}
+		out, e := w.opener().Read(ctx, resource.ReadRequest{Target: access.Spec, Log: &resource.LogRead{Path: node.LogPath, Offset: 0, Limit: limit}})
+		if e != nil {
+			return resource.LogSnapshot{}, e
+		}
+		if out.LogMissing || out.Log == nil {
+			return resource.LogSnapshot{}, fmt.Errorf("recorded node log unavailable")
+		}
+		return *out.Log, nil
+	}
+	return resource.LogSnapshot{}, fmt.Errorf("recorded node index unavailable")
+}
