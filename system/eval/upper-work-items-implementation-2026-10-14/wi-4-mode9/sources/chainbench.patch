+package mcp
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+)
+
+func TestLogObservationToolsAreActuallyRegisteredAndRejectBadInputs(t *testing.T) {
+	server := Default("test", "0")
+	raw := server.Handle(context.Background(), []byte(`{"jsonrpc":"2.0","id":1,"method":"tools/list"}`))
+	var reply struct {
+		Result struct {
+			Tools []struct {
+				Name string `json:"name"`
+			}
+		} `json:"result"`
+	}
+	if e := json.Unmarshal(raw, &reply); e != nil {
+		t.Fatal(e)
+	}
+	found := map[string]bool{}
+	for _, tool := range reply.Result.Tools {
+		found[tool.Name] = true
+	}
+	for _, prepare := range []bool{false, true} {
+		tool := logObservationTool(prepare)
+		if !found[tool.Name] {
+			t.Fatal("public registration missing", tool.Name)
+		}
+		if tool.ReadOnly != prepare {
+			t.Fatal("read-only annotation mismatch")
+		}
+		if _, e := tool.Handler(context.Background(), map[string]any{"input": map[string]any{"unknown": true}}); e == nil {
+			t.Fatal("unknown input accepted")
+		}
+	}
+}
