@@ -0,0 +1,75 @@
+package experiment
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"time"
+)
+
+// VerifyLogWatchReport checks retained content/accounting. It cannot authenticate
+// an executor or establish instrumentation timing neutrality or fix acceptance.
+func VerifyLogWatchReport(r LogWatchReport) error {
+	bad := func() error { return fmt.Errorf("inconsistent structured log report") }
+	if e := r.Plan.Validate(); e != nil {
+		return e
+	}
+	raw, _ := json.Marshal(r.Plan)
+	if r.SchemaVersion != 1 || r.PlanSHA256 != traceDigest(raw) || r.Acceptance != "not_recorded" || r.StartedAt.IsZero() || r.FinishedAt.Before(r.StartedAt) || r.Polls < 0 || r.Polls > 72001 || len(r.Events) > r.Plan.MaxEvents {
+		return bad()
+	}
+	anchors := map[int]LogAnchor{}
+	next := map[int]int{}
+	for _, a := range r.Plan.Anchors {
+		anchors[a.Node] = a
+		next[a.Node] = len(a.Initial)
+	}
+	recurrence := false
+	var previous time.Time
+	for i, event := range r.Events {
+		if _, ok := anchors[event.Node]; !ok {
+			return bad()
+		}
+		if event.Offset < next[event.Node] || event.Offset+len(event.Raw)+1 > r.Plan.MaxBytes || event.SHA256 != traceDigest(event.Raw) || bytes.Contains(event.Raw, []byte{'\n'}) || event.ObservedAt.Before(r.StartedAt) || event.ObservedAt.Before(previous) || event.ObservedAt.After(r.FinishedAt) {
+			return bad()
+		}
+		parsed, e := parseTrace(event.Raw)
+		if e != nil {
+			return e
+		}
+		retained, _ := json.Marshal(event.Record)
+		actual, _ := json.Marshal(parsed)
+		if !bytes.Equal(retained, actual) || parsed.ProbeID != r.Plan.ProbeID || !contains(r.Plan.Sites, parsed.Site) {
+			return bad()
+		}
+		next[event.Node] = event.Offset + len(event.Raw) + 1
+		previous = event.ObservedAt
+		if parsed.Symptom && parsed.Event == r.Plan.Event {
+			if recurrence || i != len(r.Events)-1 {
+				return bad()
+			}
+			recurrence = true
+		}
+	}
+	switch r.Verdict {
+	case "RECURRED":
+		if !recurrence || !r.ResumeRequested || r.Polls < 1 || r.Reason != "structured_symptom_log_observed" || !previous.Before(r.StartedAt.Add(time.Duration(r.Plan.WindowSeconds)*time.Second)) {
+			return bad()
+		}
+	case "AWAITING_OBSERVATION":
+		if recurrence || r.ResumeRequested || r.Polls < 1 || r.Reason != "window_finished" || r.FinishedAt.Sub(r.StartedAt) < time.Duration(r.Plan.WindowSeconds)*time.Second {
+			return bad()
+		}
+	case "ERROR":
+		if r.ResumeRequested {
+			return bad()
+		}
+		allowed := []string{"observation_cancelled", "actual_source_environment_changed", "log_read_failed", "log_rotation_truncation_or_mutation", "log_byte_budget_exhausted", "malformed_trace_record", "trace_site_not_frozen", "event_budget_exhausted", "event_outside_window", "event_source_environment_changed"}
+		if !contains(allowed, r.Reason) {
+			return bad()
+		}
+	default:
+		return bad()
+	}
+	return nil
+}
