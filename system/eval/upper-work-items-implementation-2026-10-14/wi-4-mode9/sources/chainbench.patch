@@ -70,3 +70,22 @@ func experimentJSONValue(d *json.Decoder, depth int) error {
 	_, e = d.Token()
 	return e
 }
+
+// DecodeLogObservationInput shares the strict token boundary with experiments.
+func DecodeLogObservationInput(raw []byte) (LogObservationIn, error) {
+	var in LogObservationIn
+	if len(raw) > 1024*1024 {
+		return in, fmt.Errorf("log input byte budget exceeded")
+	}
+	tokens := json.NewDecoder(bytes.NewReader(raw))
+	if e := experimentJSONValue(tokens, 0); e != nil {
+		return in, e
+	}
+	if _, e := tokens.Token(); e != io.EOF {
+		return in, fmt.Errorf("one log input document required")
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.DisallowUnknownFields()
+	err := d.Decode(&in)
+	return in, err
+}
