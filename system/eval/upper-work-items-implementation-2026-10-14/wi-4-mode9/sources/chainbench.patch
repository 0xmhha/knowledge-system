+package experiment
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+)
+
+type logBackend struct {
+	source Source
+	frames []LogReadFrame
+	reads  int
+	drift  bool
+}
+
+func (b *logBackend) Identity(context.Context) (Source, error) {
+	out := b.source
+	if b.drift && b.reads > 0 {
+		out.Commit = strings.Repeat("9", 40)
+	}
+	return out, nil
+}
+func (b *logBackend) Read(context.Context, int, int) (LogReadFrame, error) {
+	index := b.reads
+	b.reads++
+	if index >= len(b.frames) {
+		index = len(b.frames) - 1
+	}
+	return b.frames[index], nil
+}
+func logPlan() LogWatchPlan {
+	s := frozenPlan().Before
+	s.DriverSHA256 = strings.Repeat("3", 64)
+	return LogWatchPlan{SchemaVersion: 1, ID: "log-observe", Source: s, ProbeID: "probe", InstrumentationSHA256: strings.Repeat("3", 64), Event: "read", Sites: []string{"Read/before"}, WindowSeconds: 1, PollMS: 50, MaxBytes: 4096, MaxEvents: 4, Anchors: []LogAnchor{{Node: 1, ID: 1, Initial: []byte("boot\n")}}}
+}
+func logLine(symptom bool) []byte {
+	raw, _ := json.Marshal(TraceRecord{SchemaVersion: 1, ProbeID: "probe", Event: "read", Site: "Read/before", Symptom: symptom, Values: map[string]any{"value": 0}})
+	return append(append([]byte(TracePrefix), raw...), '\n')
+}
+func frame(data []byte) LogReadFrame { return LogReadFrame{ID: 1, Size: int64(len(data)), Data: data} }
+func TestStructuredLogRecurrenceRequiresFrozenSourceAndSite(t *testing.T) {
+	p := logPlan()
+	raw := append([]byte("boot\n"), logLine(true)...)
+	b := &logBackend{source: p.Source, frames: []LogReadFrame{frame(raw)}}
+	r, e := WatchLogs(context.Background(), p, b)
+	if e == nil {
+		e = VerifyLogWatchReport(r)
+	}
+	if e != nil || r.Verdict != "RECURRED" || !r.ResumeRequested || r.Acceptance != "not_recorded" || len(r.Events) != 1 || r.Events[0].SHA256 != traceDigest(r.Events[0].Raw) {
+		t.Fatalf("verdict=%s reason=%s events=%d error=%v", r.Verdict, r.Reason, len(r.Events), e)
+	}
+}
+func TestLogMutationRotationMalformedAndBoundErrorsCannotResume(t *testing.T) {
+	for _, mode := range []string{"rewrite", "rotate", "source", "malformed", "site", "budget", "partial_mutation"} {
+		t.Run(mode, func(t *testing.T) {
+			p := logPlan()
+			data := append([]byte("boot\n"), logLine(true)...)
+			f := frame(data)
+			b := &logBackend{source: p.Source, frames: []LogReadFrame{f}}
+			switch mode {
+			case "rewrite":
+				f.Data[0] = 'X'
+				b.frames[0] = f
+			case "rotate":
+				f.ID = 2
+				b.frames[0] = f
+			case "source":
+				b.drift = true
+			case "malformed":
+				b.frames = []LogReadFrame{frame([]byte("boot\nKS_TIMING_V1 {bad}\n"))}
+			case "site":
+				b.frames = []LogReadFrame{frame([]byte(strings.Replace(string(data), "Read/before", "Unknown/site", 1)))}
+			case "budget":
+				p.MaxEvents = 1
+				b.frames = []LogReadFrame{frame(append(append([]byte("boot\n"), logLine(false)...), logLine(true)...))}
+			case "partial_mutation":
+				b.frames = []LogReadFrame{frame([]byte("boot\nKS_TIMING_V1 {\"symptom\":false")), frame(data)}
+			}
+			r, e := WatchLogs(context.Background(), p, b)
+			if e == nil {
+				e = VerifyLogWatchReport(r)
+			}
+			if e != nil || r.Verdict != "ERROR" || r.ResumeRequested {
+				t.Fatalf("verdict=%s reason=%s events=%d error=%v", r.Verdict, r.Reason, len(r.Events), e)
+			}
+		})
+	}
+}
+func TestLogPartialLineIsNotEventUntilCompleted(t *testing.T) {
+	p := logPlan()
+	line := logLine(true)
+	first := append([]byte("boot\n"), line[:len(line)-1]...)
+	complete := append(append([]byte(nil), first...), '\n')
+	b := &logBackend{source: p.Source, frames: []LogReadFrame{frame(first), frame(complete)}}
+	r, e := WatchLogs(context.Background(), p, b)
+	if e == nil {
+		e = VerifyLogWatchReport(r)
+	}
+	if e != nil || r.Verdict != "RECURRED" || r.Polls != 2 {
+		t.Fatalf("verdict=%s reason=%s events=%d error=%v", r.Verdict, r.Reason, len(r.Events), e)
+	}
+}
+func TestNoLogRecurrenceWaitsFullWindowAndCancellationIsError(t *testing.T) {
+	p := logPlan()
+	b := &logBackend{source: p.Source, frames: []LogReadFrame{frame([]byte("boot\n"))}}
+	start := time.Now()
+	r, e := WatchLogs(context.Background(), p, b)
+	if e == nil {
+		e = VerifyLogWatchReport(r)
+	}
+	if e != nil || r.Verdict != "AWAITING_OBSERVATION" || r.ResumeRequested || time.Since(start) < time.Second {
+		t.Fatalf("verdict=%s reason=%s events=%d error=%v", r.Verdict, r.Reason, len(r.Events), e)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	r, e = WatchLogs(ctx, p, b)
+	if e == nil {
+		e = VerifyLogWatchReport(r)
+	}
+	if e != nil || r.Verdict != "ERROR" || r.Reason != "observation_cancelled" {
+		t.Fatalf("verdict=%s reason=%s events=%d error=%v", r.Verdict, r.Reason, len(r.Events), e)
+	}
+}
+
+func TestAmbiguousOrMissingTraceFieldsCannotResume(t *testing.T) {
+	for _, bad := range []string{
+		strings.Replace(string(logLine(true)), `"symptom":true,`, "", 1),
+		strings.Replace(string(logLine(true)), `"symptom":true`, `"symptom":null`, 1),
+		strings.Replace(string(logLine(true)), `"symptom":true`, `"symptom":false,"symptom":true`, 1),
+		strings.Replace(string(logLine(true)), `"value":0`, `"value":1,"value":0`, 1),
+	} {
+		p := logPlan()
+		b := &logBackend{source: p.Source, frames: []LogReadFrame{frame([]byte("boot\n" + bad))}}
+		r, e := WatchLogs(context.Background(), p, b)
+		if e != nil || r.Verdict != "ERROR" || r.ResumeRequested || VerifyLogWatchReport(r) != nil {
+			t.Fatalf("ambiguous log accepted: %+v %v", r, e)
+		}
+	}
+}
+func TestRetainedLogReportTamperingCannotBecomeAResume(t *testing.T) {
+	p := logPlan()
+	b := &logBackend{source: p.Source, frames: []LogReadFrame{frame(append([]byte("boot\n"), logLine(true)...))}}
+	r, e := WatchLogs(context.Background(), p, b)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, kind := range []string{"plan", "raw", "record", "offset", "time", "missing_event", "acceptance", "early_window"} {
+		t.Run(kind, func(t *testing.T) {
+			raw, _ := json.Marshal(r)
+			var modified LogWatchReport
+			_ = json.Unmarshal(raw, &modified)
+			switch kind {
+			case "plan":
+				modified.Plan.Event = "different"
+			case "raw":
+				modified.Events[0].Raw[0] = 'X'
+			case "record":
+				modified.Events[0].Record.Symptom = false
+			case "offset":
+				modified.Events[0].Offset = 0
+			case "time":
+				modified.Events[0].ObservedAt = modified.StartedAt.Add(-time.Second)
+			case "missing_event":
+				modified.Events = nil
+			case "acceptance":
+				modified.Acceptance = "accepted"
+			case "early_window":
+				modified.Events = nil
+				modified.Verdict = "AWAITING_OBSERVATION"
+				modified.ResumeRequested = false
+				modified.Reason = "window_finished"
+			}
+			if VerifyLogWatchReport(modified) == nil {
+				t.Fatal("tampered report accepted")
+			}
+		})
+	}
+}
+
+type deadlineLogBackend struct {
+	source    Source
+	unrelated bool
+}
+
+func (b deadlineLogBackend) Identity(context.Context) (Source, error) { return b.source, nil }
+func (b deadlineLogBackend) Read(ctx context.Context, _, _ int) (LogReadFrame, error) {
+	<-ctx.Done()
+	if b.unrelated {
+		return LogReadFrame{}, fmt.Errorf("actual independent read error")
+	}
+	return LogReadFrame{}, fmt.Errorf("read: %w", ctx.Err())
+}
+func TestWindowDeadlineInsideReadIsAwaitingButIndependentFailureRemainsError(t *testing.T) {
+	p := logPlan()
+	for _, unrelated := range []bool{false, true} {
+		r, e := WatchLogs(context.Background(), p, deadlineLogBackend{source: p.Source, unrelated: unrelated})
+		want := "AWAITING_OBSERVATION"
+		if unrelated {
+			want = "ERROR"
+		}
+		if e != nil || r.Verdict != want || r.ResumeRequested || VerifyLogWatchReport(r) != nil {
+			t.Fatalf("deadline boundary: %+v %v", r, e)
+		}
+	}
+}
+
+type identityDeadlineBackend struct{ deadlineLogBackend }
+
+func (b identityDeadlineBackend) Identity(ctx context.Context) (Source, error) {
+	<-ctx.Done()
+	return Source{}, ctx.Err()
+}
+func TestNoEstablishedSourceCannotBecomeSuccessfulAwaitingWindow(t *testing.T) {
+	r, e := WatchLogs(context.Background(), logPlan(), identityDeadlineBackend{})
+	if e != nil || r.Verdict != "ERROR" || r.Reason != "actual_source_environment_changed" || VerifyLogWatchReport(r) != nil {
+		t.Fatalf("unestablished source: %+v %v", r, e)
+	}
+}
