+package verb
+
+import (
+	"context"
+	"github.com/0xmhha/chainbench/internal/chainsetup"
+	"github.com/0xmhha/chainbench/internal/resource"
+)
+
+// ChainLogWindow is a read of only the log path the composition recorded.
+func ChainLogWindow(ctx context.Context, d chainsetup.Deps, workspace string, node, limit int) (resource.LogSnapshot, error) {
+	ws, e := chainsetup.Open(workspace, d.Clock)
+	if e != nil {
+		return resource.LogSnapshot{}, e
+	}
+	ws.SetEnv(d.Env)
+	ws.SetServerLookup(d.ServerLookup)
+	return ws.LogWindow(ctx, node, limit)
+}
