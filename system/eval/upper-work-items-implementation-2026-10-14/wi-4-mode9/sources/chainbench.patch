diff --git a/internal/testengine/log_observation.go b/internal/testengine/log_observation.go
new file mode 100644
index 00000000..e9969722
--- /dev/null
+++ b/internal/testengine/log_observation.go
@@ -0,0 +1,151 @@
+package testengine
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/0xmhha/chainbench/internal/chainsetup"
+	"github.com/0xmhha/chainbench/internal/chainsetup/verb"
+	"github.com/0xmhha/chainbench/internal/experiment"
+)
+
+type LogObservationIn struct {
+	Plan         experiment.LogWatchPlan `json:"plan"`
+	Workspace    string                  `json:"workspace"`
+	Binary       string                  `json:"binary"`
+	ArtifactRoot string                  `json:"artifact_root"`
+}
+type ownerLogWatch struct {
+	sd    chainsetup.Deps
+	input LogObservationIn
+}
+
+func (b ownerLogWatch) Identity(ctx context.Context) (experiment.Source, error) {
+	source := b.input.Plan.Source
+	digest, e := ExperimentCompositionDigest(ctx, b.sd, b.input.Workspace)
+	if e != nil {
+		return experiment.Source{}, fmt.Errorf("actual composition unavailable: %w", e)
+	}
+	if digest != source.EnvironmentSHA256 {
+		return experiment.Source{}, fmt.Errorf("actual composition pin changed")
+	}
+	status, e := verb.ChainStatus(ctx, b.sd, verb.ChainStatusIn{DataDir: b.input.Workspace})
+	if e != nil {
+		return experiment.Source{}, e
+	}
+	if status.State.Binary != b.input.Binary {
+		return experiment.Source{}, fmt.Errorf("actual binary path differs")
+	}
+	pins, e := verb.ChainRuntimePins(ctx, b.sd, verb.ChainObserveIn{DataDir: b.input.Workspace})
+	if e != nil {
+		return experiment.Source{}, e
+	}
+	for path, digest := range pins {
+		if strings.HasSuffix(path, "/binary") && digest != "sha256:"+source.BinarySHA256 {
+			return experiment.Source{}, fmt.Errorf("actual node executable differs")
+		}
+	}
+	verified, e := experiment.FreezeBinarySource(b.input.Binary, source.Commit, source.DriverSHA256, source.EnvironmentSHA256)
+	if e != nil || verified != source {
+		return experiment.Source{}, fmt.Errorf("binary/source bytes changed")
+	}
+	for _, anchor := range b.input.Plan.Anchors {
+		if pins["node"+strconv.Itoa(anchor.Node)+"/binary"] == "" {
+			return experiment.Source{}, fmt.Errorf("log node is not recorded")
+		}
+	}
+	return source, nil
+}
+func (b ownerLogWatch) Read(ctx context.Context, node, limit int) (experiment.LogReadFrame, error) {
+	snapshot, e := verb.ChainLogWindow(ctx, b.sd, b.input.Workspace, node, limit)
+	return experiment.LogReadFrame{ID: snapshot.ID, Size: snapshot.Size, Data: snapshot.Data}, e
+}
+
+// PrepareLogObservation binds an existing composition and current complete-line
+// log cursors. It creates or controls no nodes and never repairs the network.
+func PrepareLogObservation(ctx context.Context, sd chainsetup.Deps, in LogObservationIn) (LogObservationIn, error) {
+	in = cloneLogInput(in)
+	digest, e := ExperimentCompositionDigest(ctx, sd, in.Workspace)
+	if e != nil {
+		return in, e
+	}
+	source, e := experiment.FreezeBinarySource(in.Binary, in.Plan.Source.Commit, in.Plan.InstrumentationSHA256, digest)
+	if e != nil {
+		return in, e
+	}
+	prior := in.Plan.Source
+	if prior.BinarySHA256 != "" && prior.BinarySHA256 != source.BinarySHA256 || prior.DriverSHA256 != "" && prior.DriverSHA256 != source.DriverSHA256 || prior.EnvironmentSHA256 != "" && prior.EnvironmentSHA256 != source.EnvironmentSHA256 {
+		return in, fmt.Errorf("existing source pin differs")
+	}
+	in.Plan.Source = source
+	if len(in.Plan.Anchors) < 1 || len(in.Plan.Anchors) > 8 {
+		return in, fmt.Errorf("explicit recorded log nodes required")
+	}
+	for i, anchor := range in.Plan.Anchors {
+		snapshot, e := verb.ChainLogWindow(ctx, sd, in.Workspace, anchor.Node, in.Plan.MaxBytes+1)
+		if e != nil {
+			return in, e
+		}
+		if snapshot.Size > int64(in.Plan.MaxBytes) || len(snapshot.Data) > in.Plan.MaxBytes {
+			return in, fmt.Errorf("initial log byte budget exhausted")
+		}
+		if anchor.ID != 0 && (anchor.ID != snapshot.ID || string(anchor.Initial) != string(snapshot.Data)) {
+			return in, fmt.Errorf("initial log pin differs")
+		}
+		in.Plan.Anchors[i] = experiment.LogAnchor{Node: anchor.Node, ID: snapshot.ID, Initial: append([]byte{}, snapshot.Data...)}
+	}
+	if e = in.Plan.Validate(); e != nil {
+		return in, e
+	}
+	if _, e = (ownerLogWatch{sd: sd, input: in}).Identity(ctx); e != nil {
+		return in, e
+	}
+	return in, nil
+}
+
+// ObserveTimingLogs watches only owner-recorded files. Its report is a factual
+// recurrence/awaiting/error receipt; instrumentation and fix gates stay separate.
+func ObserveTimingLogs(ctx context.Context, sd chainsetup.Deps, in LogObservationIn) (experiment.LogWatchReport, error) {
+	in = cloneLogInput(in)
+	if e := in.Plan.Validate(); e != nil {
+		return experiment.LogWatchReport{}, e
+	}
+	if in.Plan.Source.DriverSHA256 != in.Plan.InstrumentationSHA256 {
+		return experiment.LogWatchReport{}, fmt.Errorf("instrumentation plan/source pin differ")
+	}
+	if _, e := (ownerLogWatch{sd: sd, input: in}).Identity(ctx); e != nil {
+		return experiment.LogWatchReport{}, e
+	}
+	if in.ArtifactRoot == "" {
+		return experiment.LogWatchReport{}, fmt.Errorf("new artifact root required")
+	}
+	if e := os.Mkdir(in.ArtifactRoot, 0700); e != nil {
+		return experiment.LogWatchReport{}, e
+	}
+	if e := writeExperimentJSON(filepath.Join(in.ArtifactRoot, "log-input.json"), in); e != nil {
+		return experiment.LogWatchReport{}, e
+	}
+	report, e := experiment.WatchLogs(ctx, in.Plan, ownerLogWatch{sd: sd, input: in})
+	if e != nil {
+		return report, e
+	}
+	if e = experiment.VerifyLogWatchReport(report); e != nil {
+		return report, e
+	}
+	if e = writeExperimentJSON(filepath.Join(in.ArtifactRoot, "log-report.json"), report); e != nil {
+		return report, e
+	}
+	return report, nil
+}
+
+func cloneLogInput(in LogObservationIn) LogObservationIn {
+	raw, _ := json.Marshal(in)
+	var out LogObservationIn
+	_ = json.Unmarshal(raw, &out)
+	return out
+}
