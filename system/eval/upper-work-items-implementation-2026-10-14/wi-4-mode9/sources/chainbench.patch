@@ -0,0 +1,83 @@
+package experimentcmd
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/0xmhha/chainbench/internal/app"
+	"github.com/spf13/cobra"
+)
+
+func logCommand() *cobra.Command {
+	var file string
+	root := &cobra.Command{Use: "observe-logs", Short: "Watch frozen structured code logs without controlling nodes"}
+	decode := func() (app.LogObservationIn, error) {
+		raw, e := os.ReadFile(file)
+		if e != nil {
+			return app.LogObservationIn{}, e
+		}
+		return app.DecodeLogObservationInput(raw)
+	}
+	root.RunE = func(cmd *cobra.Command, _ []string) error {
+		in, e := decode()
+		if e != nil {
+			return e
+		}
+		r, e := app.ObserveTimingLogs(cmd.Context(), app.Deps{}, in)
+		if e != nil {
+			return e
+		}
+		if e = json.NewEncoder(cmd.OutOrStdout()).Encode(r); e != nil {
+			return e
+		}
+		if r.Verdict == "ERROR" {
+			return fmt.Errorf("log observation failed: %s", r.Reason)
+		}
+		return nil
+	}
+	root.Flags().StringVar(&file, "input", "", "frozen source/composition/log cursor input")
+	_ = root.MarkFlagRequired("input")
+	var proposal string
+	prepare := &cobra.Command{Use: "prepare", Short: "Freeze current source and complete-line log cursors without writes to the network", RunE: func(cmd *cobra.Command, _ []string) error {
+		file = proposal
+		in, e := decode()
+		if e != nil {
+			return e
+		}
+		in, e = app.PrepareLogObservation(cmd.Context(), app.Deps{}, in)
+		if e != nil {
+			return e
+		}
+		return json.NewEncoder(cmd.OutOrStdout()).Encode(in)
+	}}
+	prepare.Flags().StringVar(&proposal, "input", "", "proposed log observation input")
+	_ = prepare.MarkFlagRequired("input")
+	var reportFile string
+	verify := &cobra.Command{Use: "verify", Short: "Check retained raw log events and accounting", RunE: func(cmd *cobra.Command, _ []string) error {
+		f, e := os.Open(reportFile)
+		if e != nil {
+			return e
+		}
+		defer func() { _ = f.Close() }()
+		decoder := json.NewDecoder(io.LimitReader(f, 1<<20))
+		decoder.DisallowUnknownFields()
+		var report app.LogObservationReport
+		if e = decoder.Decode(&report); e != nil {
+			return e
+		}
+		if e = decoder.Decode(new(any)); e != io.EOF {
+			return fmt.Errorf("one report document required")
+		}
+		if e = app.VerifyLogObservationReport(report); e != nil {
+			return e
+		}
+		_, e = fmt.Fprintln(cmd.OutOrStdout(), "PASS")
+		return e
+	}}
+	verify.Flags().StringVar(&reportFile, "report", "", "recorded log report")
+	_ = verify.MarkFlagRequired("report")
+	root.AddCommand(prepare, verify)
+	return root
+}
