+func TestFunctionalEditsAndUnsafeExpressionsAreNotInstrumentation(t *testing.T) {
+	cases := map[string]string{
+		"division":          strings.Replace(instrumented, "!ready, value)", "!ready, value/0)", 1),
+		"field_read":        strings.Replace(instrumented, "!ready, value)", "!ready, owner.value)", 1),
+		"missing_symptom":   strings.Replace(instrumented, `\"symptom\":%t,`, "", 1),
+		"null_symptom":      strings.Replace(instrumented, `\"symptom\":%t`, `\"symptom\":null`, 1),
+		"duplicate_symptom": strings.Replace(instrumented, `\"symptom\":%t`, `\"symptom\":false,\"symptom\":%t`, 1),
+		"duplicate_value":   strings.Replace(instrumented, `\"value\":%d`, `\"value\":0,\"value\":%d`, 1),
+		"guard":             strings.Replace(instrumented, "if ready", "if !ready", 1),
+		"value":             strings.Replace(instrumented, "return value", "return value+1", 1),
+		"call_arg":          strings.Replace(instrumented, "!ready, value)", "!ready, mutate())", 1),
+		"nested_log":        strings.Replace(instrumented, "ksobserve.Printf(", "go ksobserve.Printf(", 1),
+		"wrong_logger":      strings.Replace(instrumented, `ksobserve "log"`, `ksobserve "example.org/log"`, 1),
+		"wrong_probe":       strings.Replace(instrumented, `\"probe\"`, `\"other\"`, 1),
+		"extra_import":      strings.Replace(instrumented, `import ksobserve "log"`, `import ksobserve "log"; import "fmt"`, 1),
+		"missing_json":      strings.Replace(instrumented, "KS_TIMING_V1 {", "not-structured {", 1),
+		"raw_format":        strings.Replace(instrumented, "%t", "%v", 1),
+	}
+	for name, after := range cases {
+		t.Run(name, func(t *testing.T) {
+			if _, e := verify(t, baseline, after); e == nil {
+				t.Fatal("behavior/source change accepted")
+			}
+		})
+	}
+}
