diff --git a/plugin/scripts/tests/test_timing_instrumentation.py b/plugin/scripts/tests/test_timing_instrumentation.py
new file mode 100644
index 0000000..60268ea
--- /dev/null
+++ b/plugin/scripts/tests/test_timing_instrumentation.py
@@ -0,0 +1,35 @@
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+SCRIPTS=Path(__file__).resolve().parents[1];sys.path.insert(0,str(SCRIPTS))
+import timing_instrumentation as trace
+BASE='package p\nfunc Read(ready bool,value int) int { if ready { return value };return 0 }\n'
+AFTER='package p\nimport ksobserve "log"\nfunc Read(ready bool,value int) int { ksobserve.Printf("KS_TIMING_V1 {\\\"schema_version\\\":1,\\\"probe_id\\\":\\\"probe\\\",\\\"event\\\":\\\"read\\\",\\\"site\\\":\\\"Read/before\\\",\\\"symptom\\\":%t,\\\"values\\\":{\\\"value\\\":%d}}",!ready,value);if ready { return value };return 0 }\n'
+class InstrumentationTests(unittest.TestCase):
+ def setUp(self):
+  self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup);self.root=Path(self.tmp.name);self.repo=self.root/'repo';self.repo.mkdir();self.workspace=self.root/'workspace';self.workspace.mkdir()
+  self.git('init','-q');self.git('config','commit.gpgsign','false');(self.repo/'go.mod').write_text('module example.invalid/trace\n\ngo 1.26.9\n');(self.repo/'a_test.go').write_text('package p\nimport \"testing\"\nfunc TestReadContract(t *testing.T){if Read(false,4)!=0||Read(true,4)!=4{t.Fatal(\"read semantics\")}}\n');(self.repo/'a.go').write_text(BASE);self.git('add','.');self.commit('test: capture original read semantics');self.base=self.git('rev-parse','HEAD');(self.repo/'a.go').write_text(AFTER);self.git('add','a.go');self.commit('test: add structured observation');self.probe=self.git('rev-parse','HEAD')
+ def git(self,*args):return subprocess.check_output(['git','-C',str(self.repo),*args]).decode().strip()
+ def commit(self,subject):return self.git('-c','user.name=Owned trace fixture','-c','user.email=fixture@example.invalid','commit','-qm',subject)
+ def test_actual_go_ast_source_guard_and_immutable_plan(self):
+  digest=trace.freeze(self.repo,self.workspace,self.base,self.probe,'probe');p,found=trace.verify(self.workspace);self.assertEqual(digest,found);self.assertEqual(p['semantic_controls'],'not_executed');self.assertEqual(p['acceptance'],'not_recorded')
+  with self.assertRaises(trace.Invalid):trace.freeze(self.repo,self.workspace,self.base,self.probe,'probe')
