+#!/usr/bin/env python3
+"""Retain mode-9 source instrumentation and factual source-bound log windows.
+
+A recurrence re-enters analysis. It never permits planning or repair completion.
+The existing repeated reproduction and oracle gates still govern those steps.
+"""
+from pathlib import Path
+import argparse
+import json
+import subprocess
+import sys
+import timing_investigation as timing
+import timing_instrumentation as instrumentation
+from timing_investigation import require,sha,encode,read,write_new,Invalid
+RUNNER_SHA256=sha(Path(__file__).read_bytes())
+
+def paths(workspace,window):
+ require(type(window)is int and 1<=window<=3,'log windows bounded1..3 per generation')
+ cycle=timing.generation(read(workspace/'state.json')[1]);directory=workspace/'timing'/str(cycle)/'logs'/str(window)
+ return {key:directory/(key+'.'+suffix)for key,suffix in(('plan','json'),('input','json'),('report','json'),('receipt','json'),('result','json'),('stdout','txt'),('stderr','txt'))}
+
+def scope(workspace):
+ state=read(workspace/'state.json')[1];analysis=state.get('states',{}).get('ANALYSIS',{})
+ require(state.get('ticket_type')=='bugfix'and state.get('current_state')=='ANALYSIS'and analysis.get('investigation_kind')in('timing','observation'),'log observation belongs to explicit bugfix analysis')
+ result,report,plan=timing.verify_artifact(workspace,'analysis');require(result['verdict']in('INCONCLUSIVE','AWAITING_OBSERVATION'),'only unreproduced investigation enters observation-only mode')
+ timing.require(analysis.get('timing_plan_sha256')==sha(timing.paths(workspace,'analysis')['plan'].read_bytes())and analysis.get('timing_result_sha256')==sha(timing.paths(workspace,'analysis')['result'].read_bytes()),'state must retain original unreproduced investigation')
+ trace,trace_sha=instrumentation.verify(workspace);controls,controls_sha=instrumentation.verify_controls(workspace)
+ require(report['plan']['before']['commit']==trace['base_commit'],'observation instrumentation must preserve original investigation source baseline')
+ return state,trace,trace_sha,controls_sha
+
+def freeze(workspace,window,proposal,binary):
+ state,trace,trace_sha,controls_sha=scope(workspace);files=paths(workspace,window)
+ require(not any(p.exists()for p in files.values()),'log evidence already frozen; never overwrite')
+ if window>1:
+  old=verify(workspace,window-1)[0];require(old['verdict']=='AWAITING_OBSERVATION','only a finished awaiting window can extend bounded observation')
+ _,value=read(proposal,1<<20);plan=value['plan']
+ require(plan['source']['commit']==trace['probe_commit']and plan['probe_id']==trace['probe_id']and plan['instrumentation_sha256']==trace_sha,'log proposal not bound to retained source instrumentation')
+ sites={s['site']for file in trace['files']for s in file['guard_result']['sites']}
+ require(set(plan['sites'])<=sites and len(plan['sites'])>0,'observation uses unfrozen instrumentation site')
+ require(any(s['event']==plan['event']for file in trace['files']for s in file['guard_result']['sites']),'observation event not inserted by source proof')
+ provider=timing.provider_identity(binary)
+ prepared=subprocess.run([provider['binary'],'experiment','observe-logs','prepare','--input',str(proposal.resolve())],capture_output=True,check=True,timeout=30)
+ input_value=json.loads(prepared.stdout);require(input_value['plan']['source']['commit']==trace['probe_commit'],'provider prepared another source')
+ files['plan'].parent.mkdir(parents=True,exist_ok=True);write_new(files['input'],prepared.stdout)
+ value={'schema_version':1,'ticket_id':state['ticket_id'],'generation':timing.generation(state),'window':window,'runner_sha256':RUNNER_SHA256,'instrumentation_plan_sha256':trace_sha,'controls_sha256':controls_sha,'provider':provider,'input':input_value,'input_sha256':sha(prepared.stdout),'acceptance':'not_recorded'}
+ write_new(files['plan'],encode(value));return sha(files['plan'].read_bytes())
+
+def frozen(workspace,window):
+ files=paths(workspace,window);raw,plan=read(files['plan'],1<<20);input_raw,value=read(files['input'],1<<20)
+ trace,trace_sha=instrumentation.verify(workspace);_,controls_sha=instrumentation.verify_controls(workspace)
+ require(plan['schema_version']==1 and plan['runner_sha256']==RUNNER_SHA256 and plan['window']==window and plan['generation']==timing.generation(read(workspace/'state.json')[1])and plan['acceptance']=='not_recorded','log plan identity changed')
+ require(plan['instrumentation_plan_sha256']==trace_sha and plan['controls_sha256']==controls_sha and plan['input']==value and plan['input_sha256']==sha(input_raw),'log source/control/input bindings changed')
+ require(value['plan']['source']['commit']==trace['probe_commit']and value['plan']['instrumentation_sha256']==trace_sha,'retained instrumentation source changed')
+ sites={site['site']for file in trace['files']for site in file['guard_result']['sites']}
+ require(value['plan']['probe_id']==trace['probe_id']and set(value['plan']['sites'])<=sites and len(value['plan']['sites'])>0,'retained instrumentation event/site scope changed')
+ require(any(site['event']==value['plan']['event']for file in trace['files']for site in file['guard_result']['sites']),'retained event not inserted by source proof')
+ timing.check_provider(plan['provider']);return files,raw,plan
+
+def verify_native(provider,path):
