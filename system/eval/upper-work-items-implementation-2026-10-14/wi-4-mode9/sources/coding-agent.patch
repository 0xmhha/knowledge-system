--- /dev/null
+++ b/plugin/tools/timing-log-guard/main_test.go
@@ -0,0 +1,71 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+const baseline = `package p
+func Read(ready bool, value int) int {
+ if ready { return value }
+ return 0
+}`
+const instrumented = `package p
+import ksobserve "log"
+func Read(ready bool, value int) int {
+ ksobserve.Printf("KS_TIMING_V1 {\"schema_version\":1,\"probe_id\":\"probe\",\"event\":\"read\",\"site\":\"Read/before\",\"symptom\":%t,\"values\":{\"value\":%d}}", !ready, value)
+ if ready { return value }
+ return 0
+}`
+
+func verify(t *testing.T, before, after string) (result, error) {
+	t.Helper()
+	raw, _ := json.Marshal(input{Before: before, After: after, ProbeID: "probe"})
+	return checkInput(strings.NewReader(string(raw)))
+}
