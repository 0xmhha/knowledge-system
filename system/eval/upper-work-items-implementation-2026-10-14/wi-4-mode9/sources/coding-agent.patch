+ require(files['stdout'].read_bytes()==report_raw and receipt['stdout_sha256']==sha(report_raw)and receipt['stderr_sha256']==sha(files['stderr'].read_bytes()),'raw log execution changed')
+ require(timing.valid_exit(receipt['exit_code'],report['verdict'],receipt['cancel_signal'])and report['plan']==plan['input']['plan']and report['acceptance']=='not_recorded','log execution/source mismatch')
+ native=verify_native(plan['provider'],files['report']);require(result['native_verifier_stdout_sha256']==sha(native.stdout),'log verifier result changed')
+ require(result['verdict']==report['verdict']and result['resume_requested']==report['resume_requested']and result['resume_target']==('ANALYSIS'if report['resume_requested']else None)and result['reproduction_confirmed']is False and result['acceptance']=='not_recorded','observation was promoted to reproduction/fix acceptance')
