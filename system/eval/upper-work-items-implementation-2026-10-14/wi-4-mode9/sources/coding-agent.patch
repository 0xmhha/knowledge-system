new file mode 100644
index 0000000..b81e503
--- /dev/null
+++ b/plugin/tools/timing-log-guard/main.go
@@ -0,0 +1,387 @@
+// Command timing-log-guard verifies that a Go instrumentation diff adds only
+// standalone structured standard-log calls with side-effect-free arguments.
+// AST equivalence is a mechanical control, not proof of timing neutrality.
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"io"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+)
+
+type input struct {
+	Before  string `json:"before"`
+	After   string `json:"after"`
+	ProbeID string `json:"probe_id"`
+}
+type location struct {
+	Event        string `json:"event"`
+	Site         string `json:"site"`
+	Symbol       string `json:"symbol"`
+	Line         int    `json:"line"`
+	FormatSHA256 string `json:"format_sha256"`
+}
+type result struct {
+	SchemaVersion     int        `json:"schema_version"`
+	Status            string     `json:"status"`
+	Reason            string     `json:"reason,omitempty"`
+	Sites             []location `json:"sites"`
+	BaselineASTSHA256 string     `json:"baseline_ast_sha256,omitempty"`
+}
+
+const alias = "ksobserve"
+const prefix = "KS_TIMING_V1 "
+
+func main() {
+	out, err := checkInput(os.Stdin)
+	if err != nil {
+		out = result{SchemaVersion: 1, Status: "ERROR", Reason: err.Error(), Sites: []location{}}
+	}
+	_ = json.NewEncoder(os.Stdout).Encode(out)
+	if err != nil {
+		os.Exit(2)
+	}
+}
+func checkInput(reader io.Reader) (result, error) {
+	raw, e := io.ReadAll(io.LimitReader(reader, 3*1024*1024+1))
+	if e != nil {
+		return result{}, e
+	}
+	if len(raw) > 3*1024*1024 {
+		return result{}, fmt.Errorf("input byte budget exceeded")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	var in input
+	if e = decoder.Decode(&in); e != nil {
+		return result{}, e
+	}
+	if e = decoder.Decode(new(any)); e != io.EOF {
+		return result{}, fmt.Errorf("one input document required")
+	}
+	if len(in.Before) > 1<<20 || len(in.After) > 1<<20 || len(in.ProbeID) == 0 || len(in.ProbeID) > 128 {
+		return result{}, fmt.Errorf("invalid source/probe bounds")
+	}
+	fs := token.NewFileSet()
+	before, e := parser.ParseFile(fs, "before.go", in.Before, parser.SkipObjectResolution)
+	if e != nil {
+		return result{}, e
+	}
+	fsAfter := token.NewFileSet()
+	after, e := parser.ParseFile(fsAfter, "after.go", in.After, parser.SkipObjectResolution)
+	if e != nil {
+		return result{}, e
+	}
+	reserved := false
+	ast.Inspect(before, func(n ast.Node) bool {
+		if id, ok := n.(*ast.Ident); ok && id.Name == alias {
+			reserved = true
+		}
+		return true
+	})
+	if reserved {
+		return result{}, fmt.Errorf("reserved logger name already used in baseline")
+	}
+	count := 0
+	imports := after.Imports[:0]
+	for _, spec := range after.Imports {
+		if spec.Name != nil && spec.Name.Name == alias {
+			path, _ := strconv.Unquote(spec.Path.Value)
+			if path != "log" {
+				return result{}, fmt.Errorf("logger must be the standard log package")
+			}
+			count++
+		} else {
+			imports = append(imports, spec)
+		}
+	}
+	after.Imports = imports
+	if count != 1 {
+		return result{}, fmt.Errorf("exactly one reserved standard-log import required")
+	}
+	decls := after.Decls[:0]
+	for _, decl := range after.Decls {
+		if gen, ok := decl.(*ast.GenDecl); ok && gen.Tok == token.IMPORT {
+			specs := gen.Specs[:0]
+			for _, spec := range gen.Specs {
+				v := spec.(*ast.ImportSpec)
+				if v.Name == nil || v.Name.Name != alias {
+					specs = append(specs, spec)
+				}
+			}
+			gen.Specs = specs
+			if len(specs) == 0 {
+				continue
+			}
+		}
+		decls = append(decls, decl)
+	}
+	after.Decls = decls
+	sites := []location{}
+	for _, decl := range after.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || fn.Body == nil {
+			continue
+		}
+		var walkErr error
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			if walkErr != nil {
+				return false
+			}
+			block, ok := n.(*ast.BlockStmt)
+			if !ok {
+				return true
+			}
+			statements := block.List[:0]
+			for _, stmt := range block.List {
+				expr, ok := stmt.(*ast.ExprStmt)
+				if !ok {
+					statements = append(statements, stmt)
+					continue
+				}
+				call, ok := expr.X.(*ast.CallExpr)
+				if !ok {
+					statements = append(statements, stmt)
+					continue
+				}
+				sel, ok := call.Fun.(*ast.SelectorExpr)
+				if !ok {
+					statements = append(statements, stmt)
+					continue
+				}
+				id, ok := sel.X.(*ast.Ident)
+				if !ok || id.Name != alias {
+					statements = append(statements, stmt)
+					continue
+				}
+				site, e := traceCall(call, in.ProbeID)
+				if e != nil {
+					walkErr = e
+					return false
+				}
+				site.Line = fsAfter.Position(stmt.Pos()).Line
+				site.Symbol = fn.Name.Name
+				sites = append(sites, site)
+			}
+			block.List = statements
+			return true
+		})
+		if walkErr != nil {
+			return result{}, walkErr
+		}
+	}
+	if len(sites) == 0 || len(sites) > 32 {
+		return result{}, fmt.Errorf("instrumentation site budget 1..32 required")
+	}
+	left, _ := json.Marshal(normalize(reflect.ValueOf(before)))
+	right, _ := json.Marshal(normalize(reflect.ValueOf(after)))
+	if !bytes.Equal(left, right) {
+		return result{}, fmt.Errorf("non-observation syntax changed after removing approved trace calls")
+	}
+	hash := sha256.Sum256(left)
+	return result{SchemaVersion: 1, Status: "PASS", Sites: sites, BaselineASTSHA256: hex.EncodeToString(hash[:])}, nil
+}
+func pure(e ast.Expr) bool {
+	switch v := e.(type) {
+	case *ast.BasicLit:
+		return true
+	case *ast.Ident:
+		return v.Name != alias
+	case *ast.SelectorExpr:
+		return false // Field reads can dereference pointers or race with writes.
+	case *ast.ParenExpr:
+		return pure(v.X)
+	case *ast.BinaryExpr:
+		switch v.Op {
+		case token.EQL, token.NEQ, token.LSS, token.LEQ, token.GTR, token.GEQ, token.LAND, token.LOR:
+			return pure(v.X) && pure(v.Y)
+		}
+		return false // Arithmetic may panic or alter evaluation costs.
+	case *ast.UnaryExpr:
+		return v.Op == token.NOT && pure(v.X)
+	}
+	return false
+}
+func traceCall(c *ast.CallExpr, probe string) (location, error) {
+	fail := func() (location, error) {
+		return location{}, fmt.Errorf("trace must be a standalone ksobserve.Printf with a bounded structured literal and pure arguments")
+	}
+	if c.Fun.(*ast.SelectorExpr).Sel.Name != "Printf" || len(c.Args) < 1 || len(c.Args) > 17 || c.Ellipsis.IsValid() {
+		return fail()
+	}
+	lit, ok := c.Args[0].(*ast.BasicLit)
+	if !ok || lit.Kind != token.STRING {
+		return fail()
+	}
+	format, e := strconv.Unquote(lit.Value)
+	if e != nil || !strings.HasPrefix(format, prefix) || len(format) > 2048 {
+		return fail()
+	}
+	expanded := strings.TrimPrefix(format, prefix)
+	args := 0
+	var b strings.Builder
+	for i := 0; i < len(expanded); i++ {
+		if expanded[i] != '%' {
+			b.WriteByte(expanded[i])
+			continue
+		}
+		i++
+		if i == len(expanded) {
+			return fail()
+		}
+		switch expanded[i] {
+		case '%':
+			b.WriteByte('%')
+		case 't':
+			b.WriteString("false")
+			args++
+		case 'd':
+			b.WriteByte('0')
+			args++
+		case 'q':
+			b.WriteString(`""`)
+			args++
+		default:
+			return fail()
+		}
+	}
+	if args != len(c.Args)-1 {
+		return fail()
+	}
+	for _, arg := range c.Args[1:] {
+		if !pure(arg) {
+			return fail()
+		}
+	}
+	if strictObject([]byte(b.String())) != nil {
+		return fail()
+	}
+	var fields map[string]json.RawMessage
+	if json.Unmarshal([]byte(b.String()), &fields) != nil {
+		return fail()
+	}
+	for _, key := range []string{"schema_version", "probe_id", "event", "site", "symptom", "values"} {
+		if len(fields[key]) == 0 || bytes.Equal(fields[key], []byte("null")) {
+			return fail()
+		}
+	}
+	var event struct {
+		SchemaVersion int            `json:"schema_version"`
+		ProbeID       string         `json:"probe_id"`
+		Event         string         `json:"event"`
+		Site          string         `json:"site"`
+		Symptom       bool           `json:"symptom"`
+		Values        map[string]any `json:"values"`
+	}
+	d := json.NewDecoder(strings.NewReader(b.String()))
+	d.DisallowUnknownFields()
+	if d.Decode(&event) != nil || event.SchemaVersion != 1 || event.ProbeID != probe || event.Event == "" || len(event.Event) > 128 || event.Site == "" || len(event.Site) > 256 || event.Values == nil || len(event.Values) > 16 {
+		return fail()
+	}
+	if d.Decode(new(any)) != io.EOF {
+		return fail()
+	}
+	hash := sha256.Sum256([]byte(format))
+	return location{Event: event.Event, Site: event.Site, FormatSHA256: hex.EncodeToString(hash[:])}, nil
+}
+
+// Ignore source positions/comments and parser bookkeeping, preserving every
+// operational AST field, declaration, expression, import and statement order.
+func normalize(v reflect.Value) any {
+	if !v.IsValid() {
+		return nil
+	}
+	if v.Type() == reflect.TypeFor[token.Pos]() {
+		return nil
+	}
+	switch v.Kind() {
+	case reflect.Interface, reflect.Pointer:
+		if v.IsNil() {
+			return nil
+		}
+		return normalize(v.Elem())
+	case reflect.Struct:
+		out := map[string]any{"$type": v.Type().String()}
+		for i := 0; i < v.NumField(); i++ {
+			name := v.Type().Field(i).Name
+			if name == "Doc" || name == "Comment" || name == "Comments" || name == "Scope" || name == "Obj" || name == "Unresolved" || v.Field(i).Type() == reflect.TypeFor[token.Pos]() {
+				continue
+			}
+			out[name] = normalize(v.Field(i))
+		}
+		return out
+	case reflect.Slice:
+		out := []any{}
+		for i := 0; i < v.Len(); i++ {
+			out = append(out, normalize(v.Index(i)))
+		}
+		return out
+	default:
+		return v.Interface()
+	}
+}
+
+// Reject ambiguous duplicate fields, including nested values; never silently
+// accept the last JSON value as the frozen format's meaning.
+func strictObject(raw []byte) error {
+	d := json.NewDecoder(bytes.NewReader(raw))
+	var walk func(int) error
+	walk = func(depth int) error {
+		if depth > 16 {
+			return fmt.Errorf("JSON nesting budget exceeded")
+		}
+		value, err := d.Token()
+		if err != nil {
+			return err
+		}
+		delimiter, ok := value.(json.Delim)
+		if !ok {
+			return nil
+		}
+		switch delimiter {
+		case '{':
+			seen := map[string]bool{}
+			for d.More() {
+				key, err := d.Token()
+				if err != nil {
+					return err
+				}
+				name, ok := key.(string)
+				if !ok || seen[name] {
+					return fmt.Errorf("duplicate JSON key")
+				}
+				seen[name] = true
+				if err = walk(depth + 1); err != nil {
+					return err
+				}
+			}
+		case '[':
+			for d.More() {
+				if err = walk(depth + 1); err != nil {
+					return err
+				}
+			}
+		default:
+			return fmt.Errorf("unexpected JSON delimiter")
+		}
+		_, err = d.Token()
+		return err
+	}
+	if err := walk(0); err != nil {
+		return err
+	}
+	if _, err := d.Token(); err != io.EOF {
+		return fmt.Errorf("one JSON document required")
+	}
+	return nil
+}
