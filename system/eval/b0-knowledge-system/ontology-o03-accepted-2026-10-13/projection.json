    {
      "id": "wbft-round-change",
      "kind": "process",
      "definition": "WBFT recovers from a stuck round (PRE-PREPARE or COMMIT quorum not\nreached within RequestTimeout) by broadcasting a ROUND-CHANGE message\nfor round+1. The message carries the highest prepared block and its\nPREPARE justification from prior rounds; a node accepts the view\nchange once it has collected a quorum of ROUND-CHANGE messages for\nthe same target round.",
      "includes": [
