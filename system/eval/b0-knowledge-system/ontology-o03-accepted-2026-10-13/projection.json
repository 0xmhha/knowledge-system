    {
      "id": "wbft-quorum",
      "kind": "rule",
      "definition": "WBFT requires QuorumSize = ceil(N - F) where N is the validator set\nsize and F = (N-1)/3 evaluated in float64. The quorum is the minimum\ncount of Prepare or Commit messages needed before the consensus core\nadvances state. State advancement in handlePrepareMsg uses the\nexpression WBFTPrepares.Size() \u003e= valSet.QuorumSize().",
      "includes": [
        "WBFT quorum size calculation"
      ],
      "excludes": [
