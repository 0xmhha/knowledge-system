  "requirements": [
    {
      "id": "req-filtered-recall",
      "version": 1,
      "title": "Filtered CKV recall",
      "statement": "CKV returns eligible nearest chunks under sparse metadata filters.",
      "status": "proposed",
      "evidence_id": "spec:d8731b5558422cfeffb92798",
      "concept_ids": [
        "vector-chunk",
        "policy"
      ],
      "acceptance_criteria": [
        {
          "id": "ac-filtered-recall",
          "given": "A sparse filter leaves an exact-search-sized candidate set with at least K eligible chunks and many closer excluded chunks",
          "when": "A filtered query requests K results",
          "then": "The response contains K eligible chunks in exact distance order",
          "evidence_id": "criterion:a59fde572be70141fcffe186"
        },
        {
          "id": "ac-filtered-completeness",
          "given": "A larger filtered candidate set contains at least K eligible chunks",
          "when": "A filtered query reaches a search budget or is cancelled",
          "then": "The response marks incomplete with a reason and never claims K-result completeness",
          "evidence_id": "criterion:59b7a21595c5f1ef3fcd55fa"
        }
      ]
    },
    {
      "id": "req-source-evidence",
      "version": 1,
      "title": "Source-backed meaning",
      "statement": "Reviewed semantic relationships remain tied to one captured source snapshot.",
