@@ -0,0 +1,253 @@
+"""Real oracle/selection executions and hook subprocesses, with fixture opinions.
+No host/model execution, production gold, network publication or human acceptance.
+"""
+import copy
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SCRIPTS = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(SCRIPTS))
+import publication_policy as policy
+from oracle_gate import GateError
+import test_fix_selection as fixtures
+
+
+class PolicyTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        f = self.f = fixtures.build_fixture(Path(self.tmp.name))
+        f.state.update(current_state='TICKET_INTAKE', pipeline_variant='full', requirement_source='local')
+        f.state['config'] = {'base_ref': f.base, 'publication_policy': 'evaluation_only',
+                             'autonomy': {'mode': 'auto', 'auto_merge': False}}
+        f.save_state()
+
+    def lock(self):
+        policy.initialize(self.f.workspace, self.f.state, self.f.repo)
+
+    def ready(self):
+        f = self.f
+        self.lock()
+        # Preserve the selector template while carrying the selected candidate's oracle.
+        template = f.workspace / 'oracle-template.json'
+        template.write_bytes(f.plan_path.read_bytes())
+        f.selection['oracle_plan'] = template.name
+        f.selection_path.write_text(json.dumps(f.selection, indent=2) + '\n')
+        result = fixtures.select.run_selection(f.workspace, f.repo)
+        fixtures.bind(f, result)
+        f.git('merge', '--ff-only', result['decision']['selected_commit'])
+        winner = next(c for c in result['candidates'] if c['id'] == result['decision']['selected_candidate'])
+        f.plan_path.write_text(winner['oracle_plan_bytes'])
+        f.plan = json.loads(winner['oracle_plan_bytes'])
+        f.state['states']['ANALYSIS']['oracle_validity_plan_sha256'] = fixtures.oracle.sha(f.plan_path.read_bytes())
+        f.state['states']['IMPLEMENTATION']['reproduction_commit'] = result['oracle_base_commit']
+        f.bind(f.run())
+        f.state['current_state'] = 'EVALUATION_PASS'
+        for stage in ('TICKET_INTAKE', 'ANALYSIS', 'PLANNING', 'DESIGN', 'IMPLEMENTATION', 'EVALUATION'):
+            f.state['states'].setdefault(stage, {}).update(status='completed', completed_at='2026-10-15T00:00:00Z')
+        f.state['states']['IMPLEMENTATION']['plan_progress'] = {'steps': [
+            {'status': 'completed', 'commits': [result['decision']['selected_commit']]}]}
+        f.state['states']['EVALUATION']['report_path'] = 'test-report.md'
+        (f.workspace / 'test-report.md').write_text('Controlled fixture evaluation. Not independent acceptance.\n')
+        f.save_state()
+
+    def hook(self, name, data):
+        p = subprocess.run([sys.executable, str(SCRIPTS.parent / 'hooks' / name)],
+                           input=json.dumps({'cwd': str(self.f.repo), **data}), cwd=self.f.repo,
+                           capture_output=True, text=True, timeout=90)
+        self.assertEqual(p.returncode, 0, p.stderr)
+        return json.loads(p.stdout) if p.stdout else {}
+
+    def stop(self, active=False):
+        return self.hook('on-stop.py', {'stop_hook_active': active})
+
+    def cli(self, action):
+        return subprocess.run([sys.executable, str(SCRIPTS / 'publication_policy.py'),
+                               '--workspace', str(self.f.workspace), '--repo', str(self.f.repo), action],
+                              capture_output=True, text=True, timeout=90)
+
+    def test_valid_exit_cli_and_repeated_stop_remain_local(self):
+        self.ready()
+        result = self.cli('--finalize')
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        state = policy.load(self.f.workspace / 'state.json')
+        self.assertEqual(state['current_state'], 'EVALUATED')
+        self.assertNotIn('pr_url', state.get('states', {}).get('COMPLETION', {}))
+        result = self.cli('--check-exit')
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        result = self.cli('--finalize')
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual(self.stop(), {})
+        self.assertEqual(self.stop(), {})
+        self.assertEqual(self.stop(True), {})
+        # Host PostToolUse Agent logging follows orchestrator return; telemetry must
+        # survive without changing the immutable gate evidence or restarting work.
+        result = subprocess.run(['bash', str(SCRIPTS.parent / 'hooks/on-agent-complete.sh')],
+                                input=json.dumps({'tool_input': {'subagent_type': 'orchestrator'},
+                                                  'tool_response': 'local evaluation only'}),
+                                cwd=self.f.repo, capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0)
+        self.assertTrue((self.f.workspace / 'logs/impl.log').exists())
+        self.assertEqual(self.cli('--check-exit').returncode, 0)
+        # Another old auto workspace must not pull the stopped evaluation into PR creation.
+        other = self.f.workspace.parent / 'old-publish'; other.mkdir()
+        (other / 'state.json').write_text(json.dumps({'current_state': 'DESIGN',
+                                                      'config': {'autonomy': {'mode': 'auto'}}}))
+        self.assertEqual(self.stop(), {})
+
+    def test_default_publish_and_auto_merge_false_still_continue(self):
+        self.f.state['config'].pop('publication_policy')
+        self.f.state['current_state'] = 'EVALUATION_PASS'
+        self.f.save_state()
+        self.assertEqual(policy.policy(self.f.workspace, self.f.state, self.f.repo), 'publish')
+        self.assertIn('COMPLETION', self.stop()['reason'])
+        self.assertEqual(self.hook('publication-guard.py', {'tool_name': 'Bash', 'tool_input': {'command': 'git push origin branch'}}), {})
+
+    def test_early_stop_reentry_never_requests_publication(self):
+        self.lock()
+        out = self.stop()
+        self.assertEqual(out['decision'], 'block')
+        self.assertIn('Never push', out['reason'])
+        self.assertEqual(self.stop(True), {})
+        self.assertNotEqual(self.cli('--finalize').returncode, 0)
+
+    def test_conflicting_or_unsupported_intake_rejected(self):
+        for field, value in [('ticket_type', 'code_review'), ('pipeline_variant', 'review_only'), ('requirement_source', 'jira')]:
+            old = self.f.state[field]
+            self.f.state[field] = value
+            with self.assertRaises(GateError): self.lock()
+            self.f.state[field] = old
+        self.f.state['config']['autonomy']['auto_merge'] = True
+        with self.assertRaises(GateError): self.lock()
+        self.assertFalse((self.f.workspace / policy.POLICY).exists())
+
+    def test_missing_lock_and_forged_terminal_cannot_stop(self):
+        self.f.state['current_state'] = 'EVALUATED'
+        self.f.save_state()
+        self.assertEqual(self.stop()['decision'], 'block')
+        self.assertNotEqual(self.cli('--check-exit').returncode, 0)
+
+    def test_failed_missing_required_stage_and_skipped_implementation_rejected(self):
+        self.ready()
+        original = copy.deepcopy(self.f.state)
+        for change in ('fail', 'missing', 'skipped', 'steps'):
+            self.f.state = copy.deepcopy(original)
+            if change == 'fail': self.f.state['states']['EVALUATION']['results']['unit_test'] = 'FAIL'
+            if change == 'missing': self.f.state['states']['EVALUATION']['results'].pop('lint')
+            if change == 'skipped': self.f.state['states']['ANALYSIS']['status'] = 'skipped'
+            if change == 'steps': self.f.state['states']['IMPLEMENTATION']['plan_progress']['steps'] = []
+            self.f.save_state()
+            self.assertNotEqual(self.cli('--finalize').returncode, 0, change)
+            self.assertFalse((self.f.workspace / policy.RECEIPT).exists())
+
+    def test_receipt_artifact_and_source_tamper_rejected(self):
+        self.ready()
+        result = self.cli('--finalize')
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        for name in (policy.RECEIPT, 'test-report.md', 'oracle-validity-report.json', policy.POLICY):
+            path = self.f.workspace / name
+            old = path.read_bytes()
+            path.write_text('{}\n')
+            self.assertNotEqual(self.cli('--check-exit').returncode, 0, name)
+            self.assertEqual(self.stop()['decision'], 'block', name)
+            path.write_bytes(old)
+        source = self.f.repo / 'ledger.py'
+        source.write_text(source.read_text() + '\n')
+        self.assertNotEqual(self.cli('--check-exit').returncode, 0)
+
+    def test_state_hash_and_source_commit_change_rejected(self):
+        self.ready()
+        result = self.cli('--finalize')
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        path = self.f.workspace / 'state.json'
+        old = path.read_bytes()
+        state = policy.load(path); state['failure_log'] = ['altered']; path.write_text(json.dumps(state))
+        self.assertNotEqual(self.cli('--check-exit').returncode, 0)
+        path.write_bytes(old)
+        self.f.git('commit', '--allow-empty', '-qm', 'test: change source identity')
+        self.assertNotEqual(self.cli('--check-exit').returncode, 0)
+
+    def test_state_guard_blocks_policy_downgrade_fake_pr_and_completion(self):
+        self.lock()
