+//go:build unix
+
+package main
+
+import (
+	"errors"
+	"golang.org/x/sys/unix"
+	"os"
+	"testing"
+	"time"
+)
+
+func TestStdioDuplicateIsPollableAndRestoresSharedFlags(t *testing.T) {
+	in, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = in.Close(); _ = writer.Close() }()
+	raw, err := in.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var flags int
+	var operationErr error
+	if err := raw.Control(func(fd uintptr) {
+		flags, operationErr = unix.FcntlInt(fd, unix.F_GETFL, 0)
+		if operationErr == nil {
+			_, operationErr = unix.FcntlInt(fd, unix.F_SETFL, flags&^unix.O_NONBLOCK)
+		}
+	}); err != nil || operationErr != nil {
+		t.Fatalf("stdio setup: %v %v", err, operationErr)
+	}
+	originalFlags := flags &^ unix.O_NONBLOCK
+	duplicate, restore, err := cancellableStdio(in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := duplicate.SetReadDeadline(time.Now()); err != nil {
+		t.Fatal("duplicate is not pollable:", err)
+	}
+	if _, err := duplicate.Read(make([]byte, 1)); !errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatal("pollable deadline failed:", err)
+	}
+	if err := duplicate.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := restore(); err != nil {
+		t.Fatal(err)
+	}
+	if err := raw.Control(func(fd uintptr) { flags, operationErr = unix.FcntlInt(fd, unix.F_GETFL, 0) }); err != nil || operationErr != nil {
+		t.Fatalf("flags query: %v %v", err, operationErr)
+	}
+	if flags != originalFlags {
+		t.Fatalf("shared original flags changed: before=%d after=%d", originalFlags, flags)
+	}
+}
+
+func TestClosedStdioSetupReturnsError(t *testing.T) {
+	in, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = in.Close()
+	_ = writer.Close()
+	if _, _, err := cancellableStdio(in); err == nil {
+		t.Fatal("closed descriptor accepted")
+	}
+}
