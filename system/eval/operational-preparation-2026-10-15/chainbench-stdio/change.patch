+	"github.com/0xmhha/chainbench/internal/mcp"
+)
+
+const initializeRequest = `{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}` + "\n"
+
+type testSession struct {
+	input  *os.File
+	output *os.File
+	cancel context.CancelFunc
+	done   chan error
+}
+
+func session(t *testing.T, handle func(context.Context, []byte) []byte) *testSession {
+	t.Helper()
+	in, input, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	output, out, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	s := &testSession{input: input, output: output, cancel: cancel, done: make(chan error, 1)}
+	t.Cleanup(func() { cancel(); _ = input.Close(); _ = output.Close(); _ = in.Close(); _ = out.Close() })
+	go func() { s.done <- serveContext(ctx, in, out, handle) }()
+	return s
+}
+
+func waitServer(t *testing.T, s *testSession) error {
+	t.Helper()
+	select {
+	case err := <-s.done:
+		return err
+	case <-time.After(3 * time.Second):
+		t.Fatal("server did not stop cooperatively")
+		return nil
+	}
+}
+
+func send(t *testing.T, s *testSession, request string) {
+	t.Helper()
+	if _, err := io.WriteString(s.input, request); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestEOFRepliesInOrder(t *testing.T) {
+	s := session(t, mcp.NewServer("fixture", "test").Handle)
+	send(t, s, initializeRequest+`{"jsonrpc":"2.0","id":2,"method":"tools/list"}`+"\n")
+	_ = s.input.Close()
+	raw, err := io.ReadAll(s.output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := waitServer(t, s); err != nil {
+		t.Fatal(err)
+	}
+	lines := bytes.Split(bytes.TrimSpace(raw), []byte("\n"))
+	if len(lines) != 2 {
+		t.Fatalf("responses: %s", raw)
+	}
+	for i, line := range lines {
+		var r struct {
+			ID int `json:"id"`
+		}
+		if err := json.Unmarshal(line, &r); err != nil {
+			t.Fatal(err)
+		}
+		if r.ID != i+1 {
+			t.Fatalf("response order: %s", raw)
+		}
+	}
+}
+
+func TestEOFActiveToolCancelsAndKeepsErrorResponse(t *testing.T) {
+	srv := mcp.NewServer("fixture", "test")
+	started := make(chan struct{})
+	cleaned := make(chan struct{})
+	srv.Register(mcp.Tool{Name: "wait", Handler: func(ctx context.Context, _ map[string]any) (string, error) {
+		close(started)
+		<-ctx.Done()
+		defer close(cleaned)
+		return "", ctx.Err()
+	}})
+	s := session(t, srv.Handle)
+	send(t, s, `{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"wait"}}`+"\n")
+	select {
+	case <-started:
+	case <-time.After(3 * time.Second):
+		t.Fatal("handler not called")
+	}
+	_ = s.input.Close()
+	raw, err := io.ReadAll(s.output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := waitServer(t, s); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-cleaned:
