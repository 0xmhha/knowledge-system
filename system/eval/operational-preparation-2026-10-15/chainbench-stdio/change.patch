+// serveContext owns the stdio files. Requests remain serial, but reading runs
+// independently so EOF or a signal can cancel a cooperative active handler.
+// Cancellation also closes the files to release blocked reads and writes.
+// Handler errors stay in their MCP responses; unrelated transport errors stay
+// errors. A clean server shutdown is not a successful tool execution.
+func serveContext(ctx context.Context, in *os.File, out *os.File, handle func(context.Context, []byte) []byte) error {
+	transportCtx, stopTransport := context.WithCancel(ctx)
+	requestCtx, cancelRequests := context.WithCancel(ctx)
+	frames := make(chan []byte)
+	readDone := make(chan struct{})
+	watchDone := make(chan struct{})
+	var readErr error
+	go func() {
+		defer close(readDone)
+		defer close(frames)
+		scanner := bufio.NewScanner(in)
+		scanner.Buffer(make([]byte, 0, 64*1024), 8*1024*1024)
+		for scanner.Scan() {
+			if len(scanner.Bytes()) == 0 {
+				continue
+			}
+			// Scanner reuses its buffer while the previous request is running.
+			line := append([]byte(nil), scanner.Bytes()...)
+			select {
+			case frames <- line:
+			case <-transportCtx.Done():
+				return
+			}
+		}
+		readErr = scanner.Err()
+	}()
+	go func() {
+		defer close(watchDone)
+		inputDone := readDone
+		for {
+			select {
+			case <-inputDone:
+				cancelRequests()
+				inputDone = nil
+			case <-transportCtx.Done():
+				cancelRequests()
+				// These files belong to this server, never another process.
+				_ = in.Close()
+				_ = out.Close()
+				return
+			}
+		}
+	}()
+	defer func() {
+		stopTransport()
+		<-watchDone
+		<-readDone
+		cancelRequests()
+	}()
+
+	w := bufio.NewWriter(out)
+	for {
+		var line []byte
+		select {
+		case <-ctx.Done():
+			<-readDone
+			return shutdownError(ctx, readErr)
+		case next, ok := <-frames:
+			if !ok {
+				<-readDone
+				return shutdownError(ctx, readErr)
+			}
+			line = next
+		}
+		resp := handle(requestCtx, line)
+		if ctx.Err() != nil {
+			<-readDone
+			return shutdownError(ctx, readErr)
 		}
-		resp := srv.Handle(ctx, line)
 		if resp == nil {
 			continue // notification: no reply
 		}
 		if _, err := w.Write(resp); err != nil {
-			return err
+			return shutdownError(ctx, err)
 		}
 		if err := w.WriteByte('\n'); err != nil {
-			return err
+			return shutdownError(ctx, err)
 		}
 		if err := w.Flush(); err != nil {
-			return err
