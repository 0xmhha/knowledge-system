+// Subprocesses exercise the actual signal registration and owned stdio. The
+// active tool is a cooperative fixture, not an actual chain/node integration.
+func TestSignalShutdownProcesses(t *testing.T) {
+	for _, mode := range []string{"idle", "active", "blocked_output"} {
+		for i := 0; i < 3; i++ {
+			t.Run(fmt.Sprintf("%s/%d", mode, i), func(t *testing.T) {
+				cmd := exec.Command(os.Args[0], "-test.run=^TestProcessHelper$")
+				marker := filepath.Join(t.TempDir(), "cleanup")
+				cmd.Env = append(os.Environ(), "CHAINBENCH_MCP_TEST_CHILD="+mode, "CHAINBENCH_MCP_TEST_CLEANUP="+marker)
+				input, err := cmd.StdinPipe()
+				if err != nil {
+					t.Fatal(err)
+				}
+				output, err := cmd.StdoutPipe()
+				if err != nil {
+					t.Fatal(err)
+				}
+				stderr, err := cmd.StderrPipe()
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := cmd.Start(); err != nil {
+					t.Fatal(err)
+				}
+				exited := false
+				t.Cleanup(func() {
+					_ = input.Close()
+					if !exited {
+						_ = cmd.Process.Kill()
+						_ = cmd.Wait()
+					}
+				})
+				ready := make(chan error, 1)
+				if mode == "idle" {
+					if _, err := io.WriteString(input, initializeRequest); err != nil {
+						t.Fatal(err)
+					}
+					go func() { _, err := bufio.NewReader(output).ReadString('\n'); ready <- err }()
+				} else {
+					if _, err := io.WriteString(input, `{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"wait"}}`+"\n"); err != nil {
+						t.Fatal(err)
+					}
+					go func() {
+						if mode == "blocked_output" {
+							_, err := io.ReadFull(output, make([]byte, 1))
+							ready <- err
+						} else {
+							line, err := bufio.NewReader(stderr).ReadString('\n')
+							if err == nil && !strings.Contains(line, "handler-active") {
+								err = fmt.Errorf("unexpected readiness: %q", line)
+							}
+							ready <- err
+						}
+					}()
+				}
+				select {
+				case err := <-ready:
+					if err != nil {
+						t.Fatal(err)
+					}
+				case <-time.After(5 * time.Second):
+					t.Fatal("child not ready")
+				}
+				start := time.Now()
+				if err := cmd.Process.Signal(syscall.SIGTERM); err != nil {
+					t.Fatal(err)
+				}
+				done := make(chan error, 1)
+				go func() { done <- cmd.Wait() }()
+				select {
+				case err := <-done:
+					exited = true
+					if err != nil {
+						t.Fatalf("SIGTERM exit: %v", err)
+					}
+				case <-time.After(5 * time.Second):
+					_ = cmd.Process.Kill()
+					err := <-done
+					exited = true
+					t.Fatalf("forced kill required: %v", err)
+				}
+				if mode == "active" {
+					raw, err := os.ReadFile(marker)
+					if err != nil || string(raw) != "canceled" {
+						t.Fatalf("missing handler cleanup: %q %v", raw, err)
+					}
+				}
+				t.Logf("mode=%s signal=SIGTERM exit=0 forced_kill=false elapsed=%s", mode, time.Since(start))
+			})
+		}
+	}
+}
