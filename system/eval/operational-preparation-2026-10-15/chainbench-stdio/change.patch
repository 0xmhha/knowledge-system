+		t.Fatal("handler cleanup was skipped")
+	}
+	var result struct {
+		Result struct {
+			IsError bool `json:"isError"`
+		} `json:"result"`
+	}
+	if err := json.Unmarshal(raw, &result); err != nil {
+		t.Fatalf("response %q: %v", raw, err)
+	}
+	if !result.Result.IsError || !bytes.Contains(raw, []byte("context canceled")) {
+		t.Fatalf("cancellation masked as successful tool result: %s", raw)
+	}
+}
+
