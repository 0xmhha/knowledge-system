+//go:build !unix
+
+package main
+
+import "os"
+
+// Keep the platform's native descriptor handling. Unix subprocess cancellation
+// receipts do not establish shutdown behavior on another platform.
+func cancellableStdio(file *os.File) (*os.File, func() error, error) {
+	return file, func() error { return nil }, nil
+}
diff --git a/cmd/chainbench-mcp/stdio_unix.go b/cmd/chainbench-mcp/stdio_unix.go
new file mode 100644
index 00000000..ab121f64
--- /dev/null
+++ b/cmd/chainbench-mcp/stdio_unix.go
@@ -0,0 +1,53 @@
+//go:build unix
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// os.Stdin/Stdout may be blocking, non-pollable wrappers even when connected
+// to a pipe. A Close then waits for Read/Write instead of interrupting it.
+// Duplicate the owned descriptor in nonblocking mode before NewFile, so Go's
+// runtime poller can interrupt it. Restore the original file-status flags at
+// the end; dup descriptors share those flags with the original open file.
+func cancellableStdio(original *os.File) (*os.File, func() error, error) {
+	raw, err := original.SyscallConn()
+	if err != nil {
+		return nil, nil, err
+	}
+	var descriptor, flags int
+	var setupErr error
+	err = raw.Control(func(fd uintptr) {
+		flags, setupErr = unix.FcntlInt(fd, unix.F_GETFL, 0)
+		if setupErr != nil {
+			return
+		}
+		descriptor, setupErr = unix.Dup(int(fd))
+	})
+	if err != nil || setupErr != nil {
+		return nil, nil, errors.Join(err, setupErr)
+	}
+	unix.CloseOnExec(descriptor)
+	restore := func() error {
+		var restoreErr error
+		err := raw.Control(func(fd uintptr) {
+			_, restoreErr = unix.FcntlInt(fd, unix.F_SETFL, flags)
+		})
+		return errors.Join(err, restoreErr)
+	}
+	if err := unix.SetNonblock(descriptor, true); err != nil {
+		_ = unix.Close(descriptor)
+		return nil, nil, err
+	}
+	file := os.NewFile(uintptr(descriptor), original.Name())
+	if file == nil {
+		_ = unix.Close(descriptor)
+		return nil, nil, errors.Join(fmt.Errorf("invalid owned stdio descriptor"), restore())
+	}
+	return file, restore, nil
+}
