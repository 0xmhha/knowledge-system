+func TestProcessHelper(t *testing.T) {
+	mode := os.Getenv("CHAINBENCH_MCP_TEST_CHILD")
+	if mode == "" {
+		return
+	}
+	if mode == "idle" {
+		main()
+		os.Exit(0)
+	}
+	srv := mcp.NewServer("fixture", "test")
+	srv.Register(mcp.Tool{Name: "wait", Handler: func(ctx context.Context, _ map[string]any) (string, error) {
+		if mode == "blocked_output" {
+			return strings.Repeat("x", 16*1024*1024), nil
